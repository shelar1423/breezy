<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Marcellus&family=Nunito:wght@400;600;700;800;900&family=Tiro+Devanagari+Hindi&display=swap" rel="stylesheet" />
<style>
html, body { margin: 0; height: 100%; background: #140E1E; overflow: hidden; }
a { color: #F6C96B; } a:hover { color: #ffe1a6; }
@keyframes flyBob { 0%,100% { transform: translate(-50%,-50%); } 50% { transform: translate(-50%,calc(-50% - 8px)); } }
@keyframes calmPulse { 0%,100% { transform: translate(-50%,-50%) scale(1); opacity: .5; } 50% { transform: translate(-50%,-50%) scale(1.5); opacity: .9; } }
</style>
</helmet>

<div style="position:relative;width:100%;height:100vh;overflow:hidden;font-family:Nunito,system-ui,sans-serif;color:#F7EEDB;background:#140E1E">

  <sc-if value="{{ isCards }}" hint-placeholder-val="{{ true }}">
    <div style="position:absolute;inset:0;background:linear-gradient(180deg,#4FB8EE 0%,#7FD2F5 46%,#A9E3F9 100%)"></div>
    <div style="position:absolute;inset:-2vh;background-size:190% auto;background-position:center 88%;background-image:url(assets/scene-home-meadow.png);filter:blur(4px) saturate(1.06)"></div>
    <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(24,86,124,.3) 0%,rgba(24,86,124,.14) 44%,rgba(24,86,124,.26) 100%)"></div>

    <div style="position:absolute;left:5.5%;right:5.5%;top:6%;display:flex;align-items:center;justify-content:center">
      <div style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:6vh;line-height:1;color:#fff;text-shadow:0 .4vh 0 rgba(20,73,107,.32)">{{ t.pickPlace }}</div>
      <a href="Breezy Home.dc.html" style="position:absolute;left:0;top:50%;transform:translateY(-50%);display:flex;align-items:center;gap:.9vh;height:5.4vh;padding:0 2.2vh 0 1.6vh;border-radius:1.4vh;border:.4vh solid #fff;background:linear-gradient(180deg,#FFD75E 0%,#F0A62A 100%);box-shadow:inset 0 -.5vh 0 rgba(0,0,0,.16),0 .3vh .6vh rgba(0,0,0,.24);color:#fff;font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:1.6vh;letter-spacing:.1em;text-decoration:none;cursor:pointer;transition:transform .16s cubic-bezier(.22,.7,.3,1),box-shadow .16s ease,filter .16s ease" style-hover="filter:brightness(1.05)" style-active="transform:translateY(-50%) translateY(2px)"><svg width="2.4vh" height="2.4vh" viewBox="0 0 24 24"><path fill="currentColor" d="M11.3 5.3L4.6 12l6.7 6.7 2-2L9.4 13H20v-2H9.4l3.9-3.7z"></path></svg>{{ t.back }}</a>
      <div style="position:absolute;right:0;top:50%;transform:translateY(-50%);display:flex;align-items:center;gap:1vh">
      <button onClick="{{ toggleSound }}" style="width:5.4vh;height:5.4vh;flex:none;border-radius:1.4vh;border:.4vh solid #fff;background:linear-gradient(180deg,#7FDDF7 0%,#12A5E0 100%);box-shadow:inset 0 -.5vh 0 rgba(0,0,0,.14),0 .3vh .5vh rgba(0,0,0,.16);display:flex;align-items:center;justify-content:center;cursor:pointer;color:#fff;padding:0;transition:transform .16s cubic-bezier(.22,.7,.3,1),filter .16s ease" style-hover="filter:brightness(1.05)" style-active="transform:translateY(2px)">
        <sc-if value="{{ soundOn }}" hint-placeholder-val="{{ true }}">
          <svg width="2.6vh" height="2.6vh" viewBox="0 0 24 24"><path fill="currentColor" d="M4 9.2v5.6h3.6L12.6 19V5l-5 4.2H4z"></path><path stroke="currentColor" stroke-width="1.9" fill="none" stroke-linecap="round" d="M15.8 8.6a4.6 4.6 0 010 6.8"></path></svg>
        </sc-if>
        <sc-if value="{{ soundOff }}" hint-placeholder-val="{{ false }}">
          <svg width="2.6vh" height="2.6vh" viewBox="0 0 24 24"><path fill="currentColor" d="M4 9.2v5.6h3.6L12.6 19V5l-5 4.2H4z"></path><path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M16 9.4l4.6 5.2M20.6 9.4L16 14.6"></path></svg>
        </sc-if>
      </button>
      <button onClick="{{ toggleLang }}" style="height:5.4vh;flex:none;padding:0 2.2vh;border-radius:1.4vh;border:.4vh solid #fff;background:linear-gradient(180deg,#C9AEF9 0%,#9E77E8 100%);box-shadow:inset 0 -.5vh 0 rgba(0,0,0,.14),0 .3vh .5vh rgba(0,0,0,.16);color:#fff;font-family:Nunito;font-weight:900;font-size:1.5vh;letter-spacing:.12em;cursor:pointer;transition:transform .16s cubic-bezier(.22,.7,.3,1),box-shadow .16s ease,filter .16s ease" style-hover="filter:brightness(1.05)" style-active="transform:translateY(2px)">{{ langLabel }}</button>
      </div>
    </div>

    <div style="position:absolute;left:5.5%;right:5.5%;top:20%;bottom:14%;display:flex;gap:2.6vh;align-items:stretch;justify-content:center">
      <sc-for list="{{ places }}" as="p" hint-placeholder-count="4">
        <button onClick="{{ p.play }}" style="position:relative;flex:1;display:flex;flex-direction:column;justify-content:flex-end;padding:0;overflow:hidden;cursor:pointer;border:none;border-radius:3vh;background:{{ p.wash }};box-shadow:0 1.4vh 2.4vh rgba(20,73,107,.18);text-align:center;transition:transform .22s cubic-bezier(.22,.7,.3,1),box-shadow .22s ease,filter .22s ease" style-hover="transform:translateY(-.6vh);box-shadow:0 2vh 3vh rgba(20,73,107,.22)" style-active="transform:translateY(0)">
          <div style="position:absolute;inset:0;background-size:cover;background-repeat:no-repeat;background-position:{{ p.pos }};background-image:{{ p.art }}"></div>
          <div style="position:absolute;left:0;right:0;bottom:0;height:56%;background:linear-gradient(180deg,rgba(9,32,48,0) 0%,rgba(9,32,48,.55) 52%,rgba(9,32,48,.88) 100%)"></div>
          <div style="position:absolute;left:0;top:2.6vh;display:flex;align-items:center;justify-content:center;min-width:6vh;height:4vh;padding:0 1.4vh;border-radius:0 99px 99px 0;border:.35vh solid #fff;border-left:none;background:{{ p.chip }};box-shadow:inset 0 -.4vh 0 rgba(0,0,0,.16),0 .3vh .6vh rgba(0,0,0,.22);color:#fff;font-family:Nunito;font-weight:900;font-size:2vh;letter-spacing:.04em;text-shadow:0 .2vh 0 rgba(0,0,0,.28)">{{ p.index }}</div>
          <div style="position:relative;display:flex;flex-direction:column;align-items:center;gap:.9vh;padding:0 2vh 3vh">
            <div style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:2.9vh;line-height:1.1;letter-spacing:.01em;color:#fff;text-shadow:0 .25vh .5vh rgba(0,0,0,.4)">{{ p.name }}</div>
            <div style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:600;font-size:1.75vh;line-height:1.4;color:rgba(255,255,255,.9);text-wrap:pretty">{{ p.teach }}</div>
            <div style="font-family:Nunito;font-weight:800;font-size:1.15vh;letter-spacing:.22em;color:rgba(255,255,255,.62)">{{ p.dur }}</div>
          </div>
        </button>
      </sc-for>
    </div>

    <div style="position:absolute;left:5.5%;bottom:6%;display:flex;align-items:center;gap:1.6vh">
      <button onClick="{{ openConnect }}" style="display:flex;align-items:center;gap:.9vh;height:4.6vh;padding:0 1.8vh;border-radius:1.2vh;border:.3vh solid rgba(255,255,255,.9);background:rgba(9,42,64,.42);color:#fff;font-family:Nunito;font-weight:900;font-size:1.25vh;letter-spacing:.14em;cursor:pointer;transition:transform .16s cubic-bezier(.22,.7,.3,1),filter .16s ease" style-hover="filter:brightness(1.15)" style-active="transform:translateY(2px)">
        <svg width="2vh" height="2vh" viewBox="0 0 24 24"><path fill="currentColor" d="M12 3a3 3 0 013 3v5a3 3 0 01-6 0V6a3 3 0 013-3z"></path><path stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" d="M5.5 11a6.5 6.5 0 0013 0M12 17.5V21"></path></svg>
        {{ t.breathe }}
        <span style="width:1.1vh;height:1.1vh;border-radius:50%;background:{{ dotColor }};box-shadow:0 0 .8vh {{ dotColor }}"></span>
      </button>
      <div style="font-size:1.25vh;letter-spacing:.06em;color:rgba(15,66,98,.72)">{{ t.hint }}</div>
    </div>
  </sc-if>

  <sc-if value="{{ isConnect }}" hint-placeholder-val="{{ false }}">
    <div style="position:absolute;inset:0;background:linear-gradient(180deg,#1B2438 0%,#141E2E 100%)"></div>
    <div style="position:absolute;inset:-2vh;background-size:cover;background-position:center;background-image:url(assets/scene-home-meadow.png);filter:blur(18px) saturate(.7);opacity:.22"></div>

    <div style="position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:84vh;max-width:88%;display:flex;flex-direction:column;gap:2.4vh">

      <div style="display:flex;align-items:center;justify-content:center;position:relative">
        <div style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:4.2vh;line-height:1.1;color:#fff;padding:0 16vh;text-align:center;text-wrap:balance">{{ t.conn }}</div>
        <button onClick="{{ closeConnect }}" style="position:absolute;left:0;top:50%;transform:translateY(-50%);display:flex;align-items:center;gap:.9vh;height:4.8vh;padding:0 2vh 0 1.4vh;border-radius:1.2vh;border:.3vh solid rgba(255,255,255,.35);background:transparent;color:rgba(247,238,219,.7);font-family:Nunito;font-weight:900;font-size:1.3vh;letter-spacing:.12em;cursor:pointer;transition:transform .16s cubic-bezier(.22,.7,.3,1),filter .16s ease" style-hover="filter:brightness(1.4)" style-active="transform:translateY(-50%) translateY(2px)">{{ t.skipConnect }}</button>
      </div>

      <div style="display:flex;gap:1.8vh">
        <button onClick="{{ pickSerial }}" style="flex:1;display:flex;flex-direction:column;align-items:center;gap:.8vh;padding:2.4vh 1.6vh;border-radius:2vh;border:.35vh solid {{ serialBorder }};background:rgba(255,255,255,.07);color:#F7EEDB;cursor:pointer;text-align:center;transition:transform .18s cubic-bezier(.22,.7,.3,1),filter .18s ease" style-hover="transform:translateY(-.5vh);filter:brightness(1.2)" style-active="transform:translateY(0)">
          <div style="font-size:3.4vh;line-height:1">🎵</div>
          <div style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:2.1vh;color:#fff">{{ t.srcSerial }}</div>
          <div style="font-family:Nunito;font-weight:600;font-size:1.45vh;line-height:1.45;color:rgba(247,238,219,.72);text-wrap:pretty">{{ t.srcSerialBlurb }}</div>
          <div style="margin-top:.6vh;padding:.7vh 1.8vh;border-radius:99px;background:linear-gradient(180deg,#FFD75E 0%,#F0A62A 100%);color:#fff;font-family:Nunito;font-weight:900;font-size:1.2vh;letter-spacing:.14em">{{ t.connectNow }}</div>
        </button>
        <button onClick="{{ pickKey }}" style="flex:1;display:flex;flex-direction:column;align-items:center;gap:.8vh;padding:2.4vh 1.6vh;border-radius:2vh;border:.35vh solid {{ keyBorder }};background:rgba(255,255,255,.07);color:#F7EEDB;cursor:pointer;text-align:center;transition:transform .18s cubic-bezier(.22,.7,.3,1),filter .18s ease" style-hover="transform:translateY(-.5vh);filter:brightness(1.2)" style-active="transform:translateY(0)">
          <div style="font-size:3.4vh;line-height:1">⌨️</div>
          <div style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:2.1vh;color:#fff">{{ t.srcKey }}</div>
          <div style="font-family:Nunito;font-weight:600;font-size:1.45vh;line-height:1.45;color:rgba(247,238,219,.72);text-wrap:pretty">{{ t.srcKeyBlurb }}</div>
        </button>
      </div>

      <div style="display:flex;flex-direction:column;gap:1.4vh;padding:2.2vh 2.4vh;border-radius:2vh;background:rgba(0,0,0,.28)">
        <div style="display:flex;align-items:center;gap:1.2vh">
          <span style="width:1.2vh;height:1.2vh;border-radius:50%;background:{{ dotColor }};box-shadow:0 0 1vh {{ dotColor }}"></span>
          <div style="font-family:Nunito;font-weight:900;font-size:1.5vh;letter-spacing:.1em;color:{{ dotColor }}">{{ statusText }}</div>
          <div style="flex:1"></div>
          <div style="font-family:Nunito;font-weight:800;font-size:1.15vh;letter-spacing:.18em;color:rgba(247,238,219,.45)">{{ t.noteHeard }}</div>
          <div ref="{{ cbNoteRef }}" style="font-family:Nunito;font-weight:900;font-size:1.6vh;color:#F6C96B;min-width:9vh;text-align:right">—</div>
        </div>

        <div style="display:flex;align-items:center;gap:1.4vh">
          <div style="font-family:Nunito;font-weight:800;font-size:1.15vh;letter-spacing:.18em;color:rgba(247,238,219,.45)">{{ t.reading }}</div>
          <div ref="{{ cbValRef }}" style="font-family:Nunito;font-weight:900;font-size:1.7vh;color:#fff;min-width:6vh">0.000</div>
          <div style="font-family:Nunito;font-weight:800;font-size:1.15vh;letter-spacing:.18em;color:rgba(247,238,219,.45)">{{ t.onBar }}</div>
          <div ref="{{ cbNormRef }}" style="font-family:Nunito;font-weight:900;font-size:1.7vh;color:#8C97AB;min-width:4.5vh">0.00</div>
          <div style="position:relative;flex:1;height:2vh;border-radius:99px;border:.3vh solid rgba(255,255,255,.32);background:rgba(0,0,0,.35);overflow:hidden">
            <div ref="{{ cbBarRef }}" style="position:absolute;left:0;top:0;bottom:0;width:0%;background:linear-gradient(90deg,#7FDDF7,#A5EA76);border-radius:99px"></div>
          </div>
        </div>

        <div style="display:flex;align-items:center;gap:1.2vh">
          <div style="flex:1;font-family:Nunito;font-weight:600;font-size:1.4vh;color:rgba(247,238,219,.7)">{{ t.tryBlow }}</div>
          <sc-if value="{{ hasSerialSensor }}" hint-placeholder-val="{{ false }}">
            <button onClick="{{ reZero }}" style="height:4.2vh;padding:0 2vh;border-radius:1.1vh;border:.3vh solid rgba(255,255,255,.55);background:rgba(255,255,255,.1);color:#fff;font-family:Nunito;font-weight:900;font-size:1.25vh;letter-spacing:.14em;cursor:pointer;transition:filter .16s ease,transform .16s ease" style-hover="filter:brightness(1.3)" style-active="transform:translateY(2px)">{{ t.reZero }}</button>
          </sc-if>
        </div>

        <div style="display:flex;align-items:center;gap:2.4vh;padding-top:1.2vh;border-top:.2vh solid rgba(255,255,255,.12)">
          <div style="font-family:Nunito;font-weight:800;font-size:1.15vh;letter-spacing:.18em;color:rgba(247,238,219,.45)">{{ t.yourBreath }}</div>
          <sc-if value="{{ calReady }}" hint-placeholder-val="{{ true }}">
            <div style="display:flex;gap:2.4vh">
              <div style="font-family:Nunito;font-weight:700;font-size:1.35vh;color:rgba(247,238,219,.8)">{{ t.lenLbl }} <b style="color:#A5EA76">{{ calLen }}</b></div>
              <div style="font-family:Nunito;font-weight:700;font-size:1.35vh;color:rgba(247,238,219,.8)">{{ t.strengthLbl }} <b style="color:#A5EA76">{{ calStrength }}</b></div>
              <div style="font-family:Nunito;font-weight:700;font-size:1.35vh;color:rgba(247,238,219,.8)">{{ t.restLbl }} <b style="color:#A5EA76">{{ calRest }}</b></div>
            </div>
          </sc-if>
          <sc-if value="{{ calNotReady }}" hint-placeholder-val="{{ false }}">
            <div style="font-family:Nunito;font-weight:700;font-size:1.35vh;color:rgba(247,238,219,.55)">{{ t.notMeasured }}</div>
          </sc-if>
        </div>

        <sc-if value="{{ breathNote }}" hint-placeholder-val="{{ false }}">
          <div style="font-family:Nunito;font-weight:700;font-size:1.35vh;line-height:1.5;color:#F2A9C4;text-wrap:pretty">{{ breathNote }}</div>
        </sc-if>
      </div>
    </div>
  </sc-if>

  <sc-if value="{{ isWarmup }}" hint-placeholder-val="{{ false }}">
    <div style="position:absolute;inset:0;background:linear-gradient(180deg,#1B2438 0%,#141E2E 100%)"></div>
    <div style="position:absolute;inset:-2vh;background-size:cover;background-position:center;background-image:url(assets/scene-home-meadow.png);filter:blur(18px) saturate(.7);opacity:.22"></div>

    <div style="position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:76vh;max-width:88%;display:flex;flex-direction:column;align-items:center;gap:2.6vh;text-align:center">

      <div style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:4.6vh;line-height:1.1;color:#fff;text-wrap:balance">{{ warmTitle }}</div>
      <div style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:600;font-size:2.1vh;line-height:1.5;color:rgba(247,238,219,.82);text-wrap:pretty">{{ warmSub }}</div>

      <sc-if value="{{ warmResting }}" hint-placeholder-val="{{ true }}">
        <div style="width:100%;height:1.6vh;border-radius:99px;background:rgba(0,0,0,.4);overflow:hidden">
          <div ref="{{ warmBarRef }}" style="height:100%;width:0%;background:linear-gradient(90deg,#7FDDF7,#A5D4F5);border-radius:99px"></div>
        </div>
      </sc-if>

      <sc-if value="{{ warmBlowing }}" hint-placeholder-val="{{ false }}">
        <div style="width:100%;display:flex;flex-direction:column;gap:1.6vh">
          <div style="position:relative;width:100%;height:5vh;border-radius:99px;border:.35vh solid rgba(255,255,255,.3);background:rgba(0,0,0,.35);overflow:hidden">
            <div ref="{{ warmLiveRef }}" style="position:absolute;left:0;top:0;bottom:0;width:0%;background:linear-gradient(90deg,#A5EA76,#F6C96B);border-radius:99px;transition:width .05s linear"></div>
          </div>
          <div style="width:100%;height:1vh;border-radius:99px;background:rgba(0,0,0,.4);overflow:hidden">
            <div ref="{{ warmBarRef }}" style="height:100%;width:0%;background:rgba(212,165,245,.75);border-radius:99px"></div>
          </div>
        </div>
      </sc-if>

      <sc-if value="{{ warmOk }}" hint-placeholder-val="{{ false }}">
        <div style="display:flex;gap:3.2vh;padding:2vh 3vh;border-radius:1.8vh;background:rgba(0,0,0,.3)">
          <div style="display:flex;flex-direction:column;gap:.5vh">
            <div style="font-family:Nunito;font-weight:800;font-size:1.15vh;letter-spacing:.18em;color:rgba(247,238,219,.45)">{{ t.lenLbl }}</div>
            <div style="font-family:Nunito;font-weight:900;font-size:2.6vh;color:#A5EA76">{{ warmLen }}</div>
          </div>
          <div style="display:flex;flex-direction:column;gap:.5vh">
            <div style="font-family:Nunito;font-weight:800;font-size:1.15vh;letter-spacing:.18em;color:rgba(247,238,219,.45)">{{ t.strengthLbl }}</div>
            <div style="font-family:Nunito;font-weight:900;font-size:2.6vh;color:#A5EA76">{{ warmStrength }}</div>
          </div>
          <div style="display:flex;flex-direction:column;gap:.5vh">
            <div style="font-family:Nunito;font-weight:800;font-size:1.15vh;letter-spacing:.18em;color:rgba(247,238,219,.45)">{{ t.breathsLbl }}</div>
            <div style="font-family:Nunito;font-weight:900;font-size:2.6vh;color:#A5EA76">{{ warmBreaths }}</div>
          </div>
        </div>
      </sc-if>

      <div style="display:flex;align-items:center;gap:1.4vh;flex-wrap:wrap;justify-content:center">
        <sc-if value="{{ warmOk }}" hint-placeholder-val="{{ false }}">
          <button onClick="{{ goPlay }}" style="display:flex;align-items:center;gap:1.2vh;height:6.4vh;padding:0 3.4vh;border-radius:1.6vh;border:.45vh solid #fff;background:linear-gradient(180deg,#FFD75E 0%,#F0A62A 100%);box-shadow:inset 0 -.6vh 0 rgba(0,0,0,.16),0 .6vh 1.2vh rgba(0,0,0,.28);color:#fff;font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:2.4vh;letter-spacing:.06em;cursor:pointer;transition:transform .16s cubic-bezier(.22,.7,.3,1),filter .16s ease" style-hover="filter:brightness(1.05)" style-active="transform:translateY(2px)"><svg width="2.6vh" height="2.6vh" viewBox="0 0 24 24"><path fill="#fff" d="M7 4.6l13 7.4-13 7.4V4.6z"></path></svg>{{ t.letsPlay }}</button>
        </sc-if>
        <sc-if value="{{ warmDone }}" hint-placeholder-val="{{ false }}">
          <button onClick="{{ retryWarm }}" style="height:5.4vh;padding:0 2.6vh;border-radius:1.3vh;border:.3vh solid rgba(255,255,255,.5);background:rgba(255,255,255,.1);color:#fff;font-family:Nunito;font-weight:900;font-size:1.3vh;letter-spacing:.14em;cursor:pointer;transition:filter .16s ease,transform .16s ease" style-hover="filter:brightness(1.3)" style-active="transform:translateY(2px)">{{ t.againBreath }}</button>
        </sc-if>
        <sc-if value="{{ hasSavedCal }}" hint-placeholder-val="{{ false }}">
          <button onClick="{{ useSaved }}" style="height:5.4vh;padding:0 2.6vh;border-radius:1.3vh;border:.3vh solid rgba(255,255,255,.3);background:transparent;color:rgba(247,238,219,.8);font-family:Nunito;font-weight:900;font-size:1.3vh;letter-spacing:.14em;cursor:pointer;transition:filter .16s ease,transform .16s ease" style-hover="filter:brightness(1.4)" style-active="transform:translateY(2px)">{{ t.useLast }}</button>
        </sc-if>
        <button onClick="{{ cancelWarm }}" style="height:5.4vh;padding:0 2.6vh;border-radius:1.3vh;border:.3vh solid rgba(255,255,255,.3);background:transparent;color:rgba(247,238,219,.65);font-family:Nunito;font-weight:900;font-size:1.3vh;letter-spacing:.14em;cursor:pointer;transition:filter .16s ease,transform .16s ease" style-hover="filter:brightness(1.4)" style-active="transform:translateY(2px)">{{ t.back }}</button>
      </div>
    </div>
  </sc-if>

  <sc-if value="{{ isResult }}" hint-placeholder-val="{{ false }}">
    <div style="position:absolute;inset:0;background:linear-gradient(180deg,#4FB8EE 0%,#7FD2F5 46%,#A9E3F9 100%)"></div>
    <div style="position:absolute;inset:-2vh;background-size:cover;background-position:center;background-image:{{ res.art }};filter:blur(9px) saturate(1.05);opacity:.5"></div>
    <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(24,86,124,.42) 0%,rgba(24,86,124,.2) 45%,rgba(24,86,124,.5) 100%)"></div>

    <div style="position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:70vh;max-width:90%;display:flex;flex-direction:column;align-items:center;gap:2.2vh;padding:4vh 4vh 3.4vh;border-radius:3.4vh;background:rgba(255,255,255,.96);box-shadow:0 2.4vh 4vh rgba(20,73,107,.32);text-align:center">

      <div style="display:flex;align-items:center;justify-content:center;min-width:9vh;height:3.6vh;padding:0 1.8vh;border-radius:99px;border:.35vh solid #fff;background:{{ res.chip }};box-shadow:inset 0 -.35vh 0 rgba(0,0,0,.16),0 .3vh .6vh rgba(0,0,0,.2);color:#fff;font-family:Nunito;font-weight:900;font-size:1.4vh;letter-spacing:.16em;text-shadow:0 .2vh 0 rgba(0,0,0,.25)">{{ res.name }}</div>

      <div style="display:flex;align-items:flex-end;gap:1.6vh;margin-top:-.4vh">
        <div style="width:7.4vh;height:7.4vh;filter:drop-shadow(0 .5vh .8vh rgba(20,73,107,.28))"><sc-if value="{{ res.star1 }}" hint-placeholder-val="{{ true }}"><svg viewBox="0 0 24 24" style="width:100%;height:100%"><path d="M12 2.4l2.9 6.1 6.7.9-4.9 4.7 1.2 6.7-5.9-3.2-5.9 3.2 1.2-6.7L2.4 9.4l6.7-.9z" fill="#FFD75E" stroke="#fff" stroke-width="1.4" stroke-linejoin="round"></path></svg></sc-if><sc-if value="{{ res.noStar1 }}" hint-placeholder-val="{{ false }}"><svg viewBox="0 0 24 24" style="width:100%;height:100%"><path d="M12 2.4l2.9 6.1 6.7.9-4.9 4.7 1.2 6.7-5.9-3.2-5.9 3.2 1.2-6.7L2.4 9.4l6.7-.9z" fill="#DCE4EC" stroke="#fff" stroke-width="1.4" stroke-linejoin="round"></path></svg></sc-if></div>
        <div style="width:9.6vh;height:9.6vh;margin-bottom:1.4vh;filter:drop-shadow(0 .6vh 1vh rgba(20,73,107,.32))"><sc-if value="{{ res.star2 }}" hint-placeholder-val="{{ true }}"><svg viewBox="0 0 24 24" style="width:100%;height:100%"><path d="M12 2.4l2.9 6.1 6.7.9-4.9 4.7 1.2 6.7-5.9-3.2-5.9 3.2 1.2-6.7L2.4 9.4l6.7-.9z" fill="#FFD75E" stroke="#fff" stroke-width="1.4" stroke-linejoin="round"></path></svg></sc-if><sc-if value="{{ res.noStar2 }}" hint-placeholder-val="{{ false }}"><svg viewBox="0 0 24 24" style="width:100%;height:100%"><path d="M12 2.4l2.9 6.1 6.7.9-4.9 4.7 1.2 6.7-5.9-3.2-5.9 3.2 1.2-6.7L2.4 9.4l6.7-.9z" fill="#DCE4EC" stroke="#fff" stroke-width="1.4" stroke-linejoin="round"></path></svg></sc-if></div>
        <div style="width:7.4vh;height:7.4vh;filter:drop-shadow(0 .5vh .8vh rgba(20,73,107,.28))"><sc-if value="{{ res.star3 }}" hint-placeholder-val="{{ true }}"><svg viewBox="0 0 24 24" style="width:100%;height:100%"><path d="M12 2.4l2.9 6.1 6.7.9-4.9 4.7 1.2 6.7-5.9-3.2-5.9 3.2 1.2-6.7L2.4 9.4l6.7-.9z" fill="#FFD75E" stroke="#fff" stroke-width="1.4" stroke-linejoin="round"></path></svg></sc-if><sc-if value="{{ res.noStar3 }}" hint-placeholder-val="{{ false }}"><svg viewBox="0 0 24 24" style="width:100%;height:100%"><path d="M12 2.4l2.9 6.1 6.7.9-4.9 4.7 1.2 6.7-5.9-3.2-5.9 3.2 1.2-6.7L2.4 9.4l6.7-.9z" fill="#DCE4EC" stroke="#fff" stroke-width="1.4" stroke-linejoin="round"></path></svg></sc-if></div>
      </div>

      <div style="display:flex;flex-direction:column;gap:.7vh">
        <div style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:4vh;line-height:1.1;color:#2F3B52;text-wrap:balance">{{ res.title }}</div>
        <div style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:600;font-size:1.9vh;line-height:1.4;color:#6B7A8D;text-wrap:pretty">{{ res.sub }}</div>
      </div>

      <div style="display:flex;gap:1.4vh;width:100%">
        <div style="flex:1;display:flex;flex-direction:column;gap:.5vh;padding:1.8vh 1vh;border-radius:1.8vh;background:#EEF3F8">
          <div style="font-family:Nunito;font-weight:800;font-size:1.05vh;letter-spacing:.16em;color:#8C97AB">{{ res.scoreLabel }}</div>
          <div style="font-family:Nunito;font-weight:900;font-size:2.8vh;color:{{ res.accent }};filter:brightness(.72)">{{ res.score }}</div>
        </div>
        <div style="flex:1;display:flex;flex-direction:column;gap:.5vh;padding:1.8vh 1vh;border-radius:1.8vh;background:#EEF3F8">
          <div style="font-family:Nunito;font-weight:800;font-size:1.05vh;letter-spacing:.16em;color:#8C97AB">{{ t.rBreaths }}</div>
          <div style="font-family:Nunito;font-weight:900;font-size:2.8vh;color:#56B92A">{{ res.breaths }}</div>
        </div>
        <div style="flex:1;display:flex;flex-direction:column;gap:.5vh;padding:1.8vh 1vh;border-radius:1.8vh;background:#EEF3F8">
          <div style="font-family:Nunito;font-weight:800;font-size:1.05vh;letter-spacing:.16em;color:#8C97AB">{{ t.rLongest }}</div>
          <div style="font-family:Nunito;font-weight:900;font-size:2.8vh;color:#2FB4E6">{{ res.longest }}</div>
        </div>
      </div>

      <div style="display:flex;align-items:center;gap:1.4vh;margin-top:.6vh">
        <a href="Breezy Home.dc.html" style="display:flex;align-items:center;justify-content:center;width:6.4vh;height:6.4vh;border-radius:1.8vh;background:#fff;box-shadow:inset 0 0 0 .35vh #E4E9F1,0 .6vh 1.2vh rgba(20,73,107,.16);cursor:pointer;color:#2F3B52;text-decoration:none;transition:transform .16s cubic-bezier(.22,.7,.3,1),filter .16s ease" style-hover="transform:translateY(-.4vh)" style-active="transform:translateY(0)" title="{{ t.rHome }}">
          <svg width="2.8vh" height="2.8vh" viewBox="0 0 24 24"><path fill="currentColor" d="M12 3.2L3 11h2.4v9h5.1v-5.6h3v5.6h5.1v-9H21z"></path></svg>
        </a>
        <button onClick="{{ retryPlace }}" style="display:flex;align-items:center;gap:1vh;height:6.4vh;padding:0 2.8vh;border:none;border-radius:1.8vh;background:#fff;box-shadow:inset 0 0 0 .35vh #E4E9F1,0 .6vh 1.2vh rgba(20,73,107,.16);cursor:pointer;color:#2F3B52;font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:1.9vh;letter-spacing:.06em;transition:transform .16s cubic-bezier(.22,.7,.3,1),filter .16s ease" style-hover="transform:translateY(-.4vh)" style-active="transform:translateY(0)">
          <svg width="2.6vh" height="2.6vh" viewBox="0 0 24 24"><path fill="currentColor" d="M12 5V2.2L7.8 6.4 12 10.6V7.8a4.6 4.6 0 11-4.6 4.6H5.2A6.8 6.8 0 1012 5z"></path></svg>
          {{ t.rRetry }}
        </button>
        <sc-if value="{{ res.notLast }}" hint-placeholder-val="{{ true }}">
          <button onClick="{{ nextPlace }}" style="display:flex;align-items:center;gap:1.2vh;height:6.8vh;padding:0 3.4vh;border:.5vh solid #fff;border-radius:2vh;background:linear-gradient(180deg,#FFD75E 0%,#F0A62A 100%);box-shadow:inset 0 -.7vh 0 rgba(0,0,0,.16),0 1vh 1.8vh rgba(23,74,104,.3);cursor:pointer;color:#fff;font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:2.4vh;letter-spacing:.05em;text-shadow:0 .25vh 0 rgba(0,0,0,.22);transition:transform .16s cubic-bezier(.22,.7,.3,1),filter .16s ease" style-hover="filter:brightness(1.05);transform:translateY(-.4vh)" style-active="transform:translateY(2px)">
            {{ t.rNext }}
            <svg width="2.8vh" height="2.8vh" viewBox="0 0 24 24"><path fill="#fff" d="M12.7 5.3L19.4 12l-6.7 6.7-2-2L14.6 13H4v-2h10.6l-3.9-3.7z"></path></svg>
          </button>
        </sc-if>
        <sc-if value="{{ res.isLast }}" hint-placeholder-val="{{ false }}">
          <button onClick="{{ resultToCards }}" style="display:flex;align-items:center;gap:1.2vh;height:6.8vh;padding:0 3.4vh;border:.5vh solid #fff;border-radius:2vh;background:linear-gradient(180deg,#FFD75E 0%,#F0A62A 100%);box-shadow:inset 0 -.7vh 0 rgba(0,0,0,.16),0 1vh 1.8vh rgba(23,74,104,.3);cursor:pointer;color:#fff;font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:2.4vh;letter-spacing:.05em;text-shadow:0 .25vh 0 rgba(0,0,0,.22);transition:transform .16s cubic-bezier(.22,.7,.3,1),filter .16s ease" style-hover="filter:brightness(1.05);transform:translateY(-.4vh)" style-active="transform:translateY(2px)">
            {{ t.rPlaces }}
          </button>
        </sc-if>
      </div>
    </div>
  </sc-if>

  <sc-if value="{{ isStream }}" hint-placeholder-val="{{ false }}">
    <div style="position:absolute;inset:0;background-size:cover;background-position:center;background-image:url(assets/scene-lillypad.png)"></div>
    <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(14,9,22,.3) 0%,rgba(14,9,22,0) 22%,rgba(14,9,22,0) 74%,rgba(14,9,22,.42) 100%)"></div>

    <div style="position:absolute;left:50%;top:3vh;transform:translateX(-50%);z-index:7;display:flex;align-items:center;gap:1vh">
      <div style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:1.3vh;letter-spacing:.12em;color:#fff;text-shadow:0 .25vh .3vh rgba(0,0,0,.45)">{{ t.timeBar }}</div>
      <div style="position:relative;width:26vh;height:1.8vh;border-radius:99px;border:.3vh solid rgba(255,255,255,.9);background:rgba(18,12,28,.5);overflow:hidden">
        <div ref="{{ progressRef }}" style="position:absolute;left:0;top:0;bottom:0;width:0%;background:linear-gradient(180deg,#FFD75E,#F0A62A);border-radius:99px"></div>
      </div>
    </div>
    <button onClick="{{ leaveGame }}" style="position:absolute;left:2.6vh;top:2.6vh;z-index:8;display:flex;align-items:center;gap:.9vh;height:5.4vh;padding:0 2vh 0 1.4vh;border-radius:1.4vh;border:.4vh solid #fff;background:linear-gradient(180deg,#FFD75E 0%,#F0A62A 100%);box-shadow:inset 0 -.5vh 0 rgba(0,0,0,.16),0 .3vh .6vh rgba(0,0,0,.24);color:#fff;font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:1.6vh;letter-spacing:.1em;cursor:pointer;transition:transform .16s cubic-bezier(.22,.7,.3,1),box-shadow .16s ease,filter .16s ease" style-hover="filter:brightness(1.05)" style-active="transform:translateY(2px)"><svg width="2.4vh" height="2.4vh" viewBox="0 0 24 24"><path fill="currentColor" d="M11.3 5.3L4.6 12l6.7 6.7 2-2L9.4 13H20v-2H9.4l3.9-3.7z"></path></svg>{{ t.back }}</button>

    <div ref="{{ padLaneRef }}" style="position:absolute;left:0;right:0;top:72%;height:0">
      <sc-for list="{{ pads }}" as="pad" hint-placeholder-count="7">
        <div style="position:absolute;left:0;top:0;transform:translate(-50%,-50%)">
          <div style="width:11vh;height:3.4vh;border-radius:50%;background:radial-gradient(ellipse at 40% 34%,#4E8F52,#2C5F38 70%,#1E4429);box-shadow:0 1.2vh 2.4vh rgba(6,14,10,.5)"></div>
          <div style="position:absolute;left:50%;top:52%;transform:translate(-50%,-50%);width:8vh;height:2vh;border-radius:50%;border:1px solid rgba(255,255,255,.14)"></div>
        </div>
      </sc-for>
    </div>

    <img ref="{{ flyRef }}" src="assets/char-golden.png" alt="Chamki the firefly" style="position:absolute;left:26%;top:52%;width:18vh;height:18vh;object-fit:contain;transform:translate(-50%,-50%);animation:flyBob 3s ease-in-out infinite;filter:drop-shadow(0 0 2.4vh rgba(255,214,130,.45))" />

    <div style="position:absolute;left:50%;top:7.2vh;transform:translateX(-50%);z-index:7;display:flex;align-items:center;gap:1vh">
      <div style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:1.3vh;letter-spacing:.12em;color:#fff;text-shadow:0 .25vh .3vh rgba(0,0,0,.45)">{{ t.breathBar }}</div>
      <div style="position:relative;width:26vh;height:1.8vh;border-radius:99px;border:.3vh solid rgba(255,255,255,.9);background:rgba(18,12,28,.5);overflow:hidden">
        <div ref="{{ gaugeZoneRef }}" style="position:absolute;top:0;bottom:0;left:25%;width:30%;background:rgba(255,255,255,.3);border-left:.25vh solid rgba(255,255,255,.85);border-right:.25vh solid rgba(255,255,255,.85);transition:left .3s ease,width .3s ease,opacity .2s ease"></div>
        <div ref="{{ gaugeRef }}" style="position:absolute;left:0;top:0;bottom:0;width:0%;background:linear-gradient(180deg,#7FDDF7,#12A5E0);border-radius:99px;transition:opacity .2s ease"></div>
        <div ref="{{ gaugePeakRef }}" style="position:absolute;top:-.2vh;bottom:-.2vh;left:0%;width:.45vh;margin-left:-.22vh;background:#fff;border-radius:99px;opacity:0;box-shadow:0 0 .6vh rgba(0,0,0,.45);transition:opacity .15s ease"></div>
      </div>
    </div>

    <div ref="{{ jarWrapRef }}" style="position:absolute;right:3.2%;bottom:7%;display:flex;align-items:flex-end;gap:1.4vh">
      <div style="display:flex;flex-direction:column;align-items:flex-end;gap:.5vh">
        <div style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:1.35vh;letter-spacing:.12em;color:#fff;text-shadow:0 .25vh 0 rgba(0,0,0,.32)">{{ t.sparks }}</div>
        <div ref="{{ jarCountRef }}" style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:3.6vh;line-height:1;color:#fff;text-shadow:0 .3vh 0 rgba(0,0,0,.32)">0</div>
      </div>
      <div style="position:relative;width:6.4vh;height:10vh;filter:drop-shadow(0 .4vh .8vh rgba(0,0,0,.24))">
        <div style="position:absolute;left:1.6vh;right:1.6vh;top:0;height:1.4vh;border-radius:99px;border:.35vh solid #fff;background:linear-gradient(180deg,#FFD75E,#F0A62A)"></div>
        <div style="position:absolute;left:0;right:0;top:1.3vh;bottom:0;border:.4vh solid #fff;border-radius:1vh 1vh 2.4vh 2.4vh;overflow:hidden;background:#2E1B60">
          <div ref="{{ jarFillRef }}" style="position:absolute;left:0;right:0;bottom:0;height:0%;background:linear-gradient(180deg,#FFD75E,#F0A62A);transition:height .4s cubic-bezier(.2,1,.3,1)"></div>
        </div>
      </div>
    </div>

    <div ref="{{ lineWrapRef }}" style="position:absolute;left:50%;bottom:calc(9% - 20px);transform:translateX(-50%);max-width:64%;padding:1.2vh 2.4vh;background:#fff;border-radius:1.8vh;box-shadow:0 .5vh 1vh rgba(9,32,48,.28);opacity:0;transition:opacity .28s ease">
      <div ref="{{ lineRef }}" style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:700;font-size:1.9vh;color:#3A2E66"></div>
    </div>
  </sc-if>

  <sc-if value="{{ isCave }}" hint-placeholder-val="{{ false }}">
    <div ref="{{ caveBgRef }}" style="position:absolute;inset:0;background-image:url(assets/scene-tunnel.png);background-size:auto 100%;background-repeat:repeat-x;background-position:0 center"></div>

        <button onClick="{{ leaveGame }}" style="position:absolute;left:2.6vh;top:2.6vh;z-index:9;display:flex;align-items:center;gap:.9vh;height:5.4vh;padding:0 2vh 0 1.4vh;border-radius:1.4vh;border:.4vh solid #fff;background:linear-gradient(180deg,#FFD75E 0%,#F0A62A 100%);box-shadow:inset 0 -.5vh 0 rgba(0,0,0,.16),0 .3vh .6vh rgba(0,0,0,.24);color:#fff;font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:1.6vh;letter-spacing:.1em;cursor:pointer;transition:transform .16s cubic-bezier(.22,.7,.3,1),box-shadow .16s ease,filter .16s ease" style-hover="filter:brightness(1.05)" style-active="transform:translateY(2px)"><svg width="2.4vh" height="2.4vh" viewBox="0 0 24 24"><path fill="currentColor" d="M11.3 5.3L4.6 12l6.7 6.7 2-2L9.4 13H20v-2H9.4l3.9-3.7z"></path></svg>{{ t.back }}</button>

    <div ref="{{ caveObsRef }}" style="position:absolute;left:0;right:0;top:42%;bottom:0;overflow:hidden">
      <sc-for list="{{ caveObstacles }}" as="o" hint-placeholder-count="4">
        <div style="position:absolute;top:0;bottom:0;left:0;width:8%;transform:translateX(-50%)">
          <div style="position:absolute;left:0;right:0;top:0;height:20%;clip-path:polygon(0 0,100% 0,74% 88%,50% 100%,26% 88%);background:linear-gradient(180deg,#6E5FA8 0%,#8B7BC4 62%,#CFF6EE 92%,#EFFFFA 100%);filter:drop-shadow(0 .3vh 2vh rgba(120,230,215,.6))"></div>
          <div style="position:absolute;left:0;right:0;top:0;height:20%;clip-path:polygon(0 0,100% 0,74% 88%,50% 100%,26% 88%);background:linear-gradient(180deg,rgba(255,255,255,0) 55%,rgba(230,255,250,.95) 100%);mix-blend-mode:screen"></div>
          <div style="position:absolute;left:0;right:0;bottom:0;height:20%;clip-path:polygon(50% 0,74% 12%,100% 100%,0 100%,26% 12%);background:linear-gradient(0deg,#6E5FA8 0%,#8B7BC4 62%,#CFF6EE 92%,#EFFFFA 100%);filter:drop-shadow(0 -.3vh 2vh rgba(120,230,215,.6))"></div>
          <div style="position:absolute;left:0;right:0;bottom:0;height:20%;clip-path:polygon(50% 0,74% 12%,100% 100%,0 100%,26% 12%);background:linear-gradient(0deg,rgba(255,255,255,0) 55%,rgba(230,255,250,.95) 100%);mix-blend-mode:screen"></div>
        </div>
      </sc-for>
    </div>

    <div style="position:absolute;left:4%;top:44%;bottom:6%;width:2.6vh;z-index:6;display:flex;flex-direction:column;align-items:center;gap:.8vh">
      <div style="position:relative;flex:1;width:2.6vh;border-radius:99px;border:.3vh solid rgba(255,255,255,.75);background:rgba(18,12,28,.55);overflow:hidden">
        <div ref="{{ caveAimRef }}" style="position:absolute;left:-.1vh;right:-.1vh;bottom:40%;height:20%;background:rgba(255,255,255,.22);border-top:.25vh solid rgba(255,255,255,.6);border-bottom:.25vh solid rgba(255,255,255,.6);transition:background .15s ease,border-color .15s ease"></div>
        <div ref="{{ caveLevelRef }}" style="position:absolute;left:0;right:0;bottom:0;height:0%;background:linear-gradient(180deg,#7FDDF7,#12A5E0);border-radius:99px"></div>
      </div>
      <div style="font-family:Nunito;font-weight:900;font-size:1vh;letter-spacing:.14em;color:rgba(255,255,255,.8);text-shadow:0 .2vh .3vh rgba(0,0,0,.5)">{{ t.breathBar }}</div>
    </div>

    <img ref="{{ caveFlyRef }}" src="assets/char-golden.png" alt="Chamki the firefly" style="position:absolute;left:26%;top:56%;width:18vh;height:18vh;object-fit:contain;transform:translate(-50%,-50%);filter:drop-shadow(0 0 3vh rgba(255,214,130,.55))" />

    <div style="position:absolute;left:50%;top:3vh;transform:translateX(-50%);z-index:7;display:flex;align-items:center;gap:1vh">
      <div style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:1.3vh;letter-spacing:.12em;color:#fff;text-shadow:0 .25vh .3vh rgba(0,0,0,.45)">{{ t.timeBar }}</div>
      <div style="position:relative;width:26vh;height:1.8vh;border-radius:99px;border:.3vh solid rgba(255,255,255,.9);background:rgba(18,12,28,.5);overflow:hidden">
        <div ref="{{ caveBarRef }}" style="position:absolute;left:0;top:0;bottom:0;width:0%;background:linear-gradient(180deg,#FFD75E,#F0A62A);border-radius:99px"></div>
        <div ref="{{ caveStreakRef }}" style="position:absolute;top:0;bottom:0;left:0;width:0%;background:rgba(255,255,255,.55)"></div>
      </div>
    </div>

    <div ref="{{ jarWrap2Ref }}" style="position:absolute;right:3.2%;bottom:7%;display:flex;align-items:flex-end;gap:1.4vh">
      <div style="display:flex;flex-direction:column;align-items:flex-end;gap:.5vh">
        <div style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:1.35vh;letter-spacing:.12em;color:#fff;text-shadow:0 .25vh 0 rgba(0,0,0,.32)">{{ t.sparks }}</div>
        <div ref="{{ jarCount2Ref }}" style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:3.6vh;line-height:1;color:#fff;text-shadow:0 .3vh 0 rgba(0,0,0,.32)">0</div>
      </div>
      <div style="position:relative;width:6.4vh;height:10vh;filter:drop-shadow(0 .4vh .8vh rgba(0,0,0,.24))">
        <div style="position:absolute;left:1.6vh;right:1.6vh;top:0;height:1.4vh;border-radius:99px;border:.35vh solid #fff;background:linear-gradient(180deg,#FFD75E,#F0A62A)"></div>
        <div style="position:absolute;left:0;right:0;top:1.3vh;bottom:0;border:.4vh solid #fff;border-radius:1vh 1vh 2.4vh 2.4vh;overflow:hidden;background:#2E1B60">
          <div ref="{{ jarFill2Ref }}" style="position:absolute;left:0;right:0;bottom:0;height:0%;background:linear-gradient(180deg,#FFD75E,#F0A62A);transition:height .4s cubic-bezier(.2,1,.3,1)"></div>
        </div>
      </div>
    </div>

    <div ref="{{ lineWrap2Ref }}" style="position:absolute;left:50%;bottom:calc(11% - 20px);transform:translateX(-50%);max-width:64%;padding:1.2vh 2.4vh;background:#fff;border-radius:1.8vh;box-shadow:0 .5vh 1vh rgba(9,32,48,.28);opacity:0;transition:opacity .28s ease">
      <div ref="{{ line2Ref }}" style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:700;font-size:1.9vh;color:#3A2E66"></div>
    </div>
  </sc-if>

  <sc-if value="{{ isConversation }}" hint-placeholder-val="{{ false }}">
    <div style="position:absolute;inset:0;background:#2A0F1E"></div>
    <div style="position:absolute;inset:0;background-size:cover;background-position:center;background-image:url(assets/scene-stage.png)"></div>
    <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(14,9,22,.28) 0%,rgba(14,9,22,0) 30%,rgba(14,9,22,.42) 100%);pointer-events:none"></div>

    <div style="position:absolute;left:50%;top:3vh;transform:translateX(-50%);z-index:7;display:flex;align-items:center;gap:1vh">
      <div style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:1.3vh;letter-spacing:.12em;color:#fff;text-shadow:0 .25vh .3vh rgba(0,0,0,.45)">{{ t.timeBar }}</div>
      <div style="position:relative;width:26vh;height:1.8vh;border-radius:99px;border:.3vh solid rgba(255,255,255,.9);background:rgba(18,12,28,.5);overflow:hidden">
        <div ref="{{ progressRef3 }}" style="position:absolute;left:0;top:0;bottom:0;width:0%;background:linear-gradient(180deg,#FFD75E,#F0A62A);border-radius:99px"></div>
      </div>
    </div>
    <button onClick="{{ leaveGame }}" style="position:absolute;left:2.6vh;top:2.6vh;z-index:10;display:flex;align-items:center;gap:.9vh;height:5.4vh;padding:0 2vh 0 1.4vh;border-radius:1.4vh;border:.4vh solid #fff;background:linear-gradient(180deg,#FFD75E 0%,#F0A62A 100%);box-shadow:inset 0 -.5vh 0 rgba(0,0,0,.16),0 .3vh .6vh rgba(0,0,0,.24);color:#fff;font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:1.6vh;letter-spacing:.1em;cursor:pointer;transition:transform .16s cubic-bezier(.22,.7,.3,1),box-shadow .16s ease,filter .16s ease" style-hover="filter:brightness(1.05)" style-active="transform:translateY(2px)"><svg width="2.4vh" height="2.4vh" viewBox="0 0 24 24"><path fill="currentColor" d="M11.3 5.3L4.6 12l6.7 6.7 2-2L9.4 13H20v-2H9.4l3.9-3.7z"></path></svg>{{ t.back }}</button>

    <div style="position:absolute;left:50%;top:24%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:2.2vh;z-index:2">
      <div ref="{{ convGlowRef }}" style="width:12vh;height:12vh;border-radius:50%;background:#D4A5F5;opacity:0;box-shadow:0 0 4vh 1vh rgba(212,165,245,.55);transition:opacity .12s"></div>
      <div ref="{{ convDotsRef }}" style="display:flex;gap:1vh;justify-content:center;align-items:center;height:1.6vh">
        <sc-for list="{{ convDots }}" as="d" hint-placeholder-count="3">
          <div style="height:1.1vh;width:2.8vh;border-radius:99px;background:rgba(255,255,255,.35);transition:background .2s ease,width .2s ease"></div>
        </sc-for>
      </div>

      <div ref="{{ convHoldWrapRef }}" style="display:flex;flex-direction:column;align-items:center;gap:.8vh;opacity:0;transition:opacity .25s ease">
        <div style="display:flex;align-items:center;gap:1.2vh">
          <div style="font-family:Nunito;font-weight:900;font-size:1.15vh;letter-spacing:.18em;color:rgba(255,255,255,.7)">{{ t.yourGo }}</div>
          <div ref="{{ convStepRef }}" style="font-family:Nunito;font-weight:900;font-size:1.5vh;color:#FFD4A3"></div>
        </div>
        <div style="position:relative;width:34vh;height:1.8vh;border-radius:99px;border:.3vh solid rgba(255,255,255,.85);background:rgba(18,12,28,.5);overflow:hidden">
          <div ref="{{ convHoldRef }}" style="position:absolute;left:0;top:0;bottom:0;width:0%;background:#FFD4A3;border-radius:99px"></div>
          <div ref="{{ convTargetRef }}" style="position:absolute;top:-.3vh;bottom:-.3vh;left:74%;width:.5vh;margin-left:-.25vh;background:#fff;border-radius:99px;box-shadow:0 0 .6vh rgba(0,0,0,.5)"></div>
        </div>
      </div>

      <div ref="{{ convSeqRef }}" style="display:flex;gap:1.4vh;justify-content:center">
        <sc-for list="{{ convPatterns }}" as="p" hint-placeholder-count="4">
          <div style="width:2.2vh;height:2.2vh;border-radius:50%;border:.3vh solid #fff;background:{{ p.color }};box-shadow:0 .2vh .4vh rgba(0,0,0,.24);opacity:.4;transition:opacity .3s"></div>
        </sc-for>
      </div>
    </div>

    <button onClick="{{ toggleSound }}" style="position:absolute;right:2.6vh;top:3vh;z-index:8;width:5vh;height:5vh;border-radius:50%;border:.35vh solid rgba(255,255,255,.9);background:rgba(46,27,96,.55);display:flex;align-items:center;justify-content:center;cursor:pointer;color:#fff;padding:0;transition:filter .16s ease,transform .16s ease" style-hover="filter:brightness(1.25)" style-active="transform:translateY(2px)">
      <sc-if value="{{ soundOn }}" hint-placeholder-val="{{ true }}">
        <svg width="2.6vh" height="2.6vh" viewBox="0 0 24 24"><path fill="currentColor" d="M4 9.2v5.6h3.6L12.6 19V5l-5 4.2H4z"></path><path stroke="currentColor" stroke-width="1.9" fill="none" stroke-linecap="round" d="M15.8 8.6a4.6 4.6 0 010 6.8"></path></svg>
      </sc-if>
      <sc-if value="{{ soundOff }}" hint-placeholder-val="{{ false }}">
        <svg width="2.6vh" height="2.6vh" viewBox="0 0 24 24"><path fill="currentColor" d="M4 9.2v5.6h3.6L12.6 19V5l-5 4.2H4z"></path><path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M16 9.4l4.6 5.2M20.6 9.4L16 14.6"></path></svg>
      </sc-if>
    </button>

    <img ref="{{ convFlyRef }}" src="assets/char-golden.png" alt="Chamki the firefly" style="position:absolute;left:50%;top:66%;margin-top:-40px;z-index:3;width:18vh;height:18vh;object-fit:contain;transform:translate(-50%,-50%);animation:flyBob 3s ease-in-out infinite;filter:drop-shadow(0 0 2.4vh rgba(255,214,130,.45))" />

    <div style="position:absolute;left:50%;bottom:6%;transform:translateX(-50%);z-index:3">
      <div style="position:relative;width:8.6vh;height:8.6vh;border-radius:50%;border:.3vh solid rgba(255,255,255,.62);background:rgba(18,12,28,.42);display:flex;align-items:center;justify-content:center">
        <div ref="{{ convBreathRef }}" style="width:6.4vh;height:6.4vh;border-radius:50%;background:#D4A5F5;opacity:0;box-shadow:0 0 2.4vh rgba(212,165,245,.55);transition:opacity .12s"></div>
      </div>
    </div>

    <div style="position:absolute;right:3.2%;bottom:7%;display:flex;align-items:flex-end;gap:1.4vh">
      <div style="display:flex;flex-direction:column;align-items:flex-end;gap:.5vh">
        <div style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:1.35vh;letter-spacing:.12em;color:#fff;text-shadow:0 .25vh 0 rgba(0,0,0,.32)">{{ t.sparks }}</div>
        <div ref="{{ jarCount3Ref }}" style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:3.6vh;line-height:1;color:#fff;text-shadow:0 .3vh 0 rgba(0,0,0,.32)">0</div>
      </div>
      <div style="position:relative;width:6.4vh;height:10vh;filter:drop-shadow(0 .4vh .8vh rgba(0,0,0,.24))">
        <div style="position:absolute;left:1.6vh;right:1.6vh;top:0;height:1.4vh;border-radius:99px;border:.35vh solid #fff;background:linear-gradient(180deg,#FFD75E,#F0A62A)"></div>
        <div style="position:absolute;left:0;right:0;top:1.3vh;bottom:0;border:.4vh solid #fff;border-radius:1vh 1vh 2.4vh 2.4vh;overflow:hidden;background:#2E1B60">
          <div ref="{{ jarFill3Ref }}" style="position:absolute;left:0;right:0;bottom:0;height:0%;background:linear-gradient(180deg,#FFD75E,#F0A62A);transition:height .4s cubic-bezier(.2,1,.3,1)"></div>
        </div>
      </div>
    </div>

    <div ref="{{ lineWrap3Ref }}" style="position:absolute;left:50%;bottom:calc(26% - 20px);z-index:3;transform:translateX(-50%);max-width:64%;padding:1.2vh 2.4vh;background:#fff;border-radius:1.8vh;box-shadow:0 .5vh 1vh rgba(9,32,48,.28);opacity:0;transition:opacity .28s ease">
      <div ref="{{ line3Ref }}" style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:700;font-size:1.9vh;color:#3A2E66"></div>
    </div>
  </sc-if>

  <sc-if value="{{ isPond }}" hint-placeholder-val="{{ false }}">
    <div style="position:absolute;inset:0;background-size:cover;background-position:center;background-image:url(assets/scene-garden.png)"></div>
    <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(14,9,22,.34) 0%,rgba(14,9,22,.04) 28%,rgba(14,9,22,0) 62%,rgba(14,9,22,.3) 100%)"></div>

    <button onClick="{{ leaveGame }}" style="position:absolute;left:2.6vh;top:2.6vh;z-index:11;display:flex;align-items:center;gap:.9vh;height:5.4vh;padding:0 2vh 0 1.4vh;border-radius:1.4vh;border:.4vh solid #fff;background:linear-gradient(180deg,#FFD75E 0%,#F0A62A 100%);box-shadow:inset 0 -.5vh 0 rgba(0,0,0,.16),0 .3vh .6vh rgba(0,0,0,.24);color:#fff;font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:1.6vh;letter-spacing:.1em;cursor:pointer;transition:transform .16s cubic-bezier(.22,.7,.3,1),box-shadow .16s ease,filter .16s ease" style-hover="filter:brightness(1.05)" style-active="transform:translateY(2px)"><svg width="2.4vh" height="2.4vh" viewBox="0 0 24 24"><path fill="currentColor" d="M11.3 5.3L4.6 12l6.7 6.7 2-2L9.4 13H20v-2H9.4l3.9-3.7z"></path></svg>{{ t.back }}</button>

    <div ref="{{ plotRef }}" style="position:absolute;inset:0;pointer-events:none">
      <div ref="{{ pondOrbRef }}" style="position:absolute;left:24%;bottom:20%;width:13vh;height:13vh;border-radius:50%;transform:translate(-50%,30%);background:radial-gradient(circle,rgba(255,233,190,.5) 0%,rgba(246,201,107,.12) 55%,rgba(0,0,0,0) 74%);transition:left .5s ease,bottom .5s ease;pointer-events:none"></div>
      <img src="assets/flower-1.png" alt="Flower" style="position:absolute;left:24%;bottom:20%;transform:translateX(-50%);width:11vh;height:18.7vh;object-fit:contain;object-position:bottom;opacity:0;transition:opacity .3s ease,transform .45s cubic-bezier(.2,1,.3,1);transform-origin:50% 100%;filter:drop-shadow(0 .8vh 1.4vh rgba(11,7,17,.26))" />
      <img src="assets/flower-1.png" alt="Flower" style="position:absolute;left:38%;bottom:25%;transform:translateX(-50%);width:9.5vh;height:16.1vh;object-fit:contain;object-position:bottom;opacity:0;transition:opacity .3s ease,transform .45s cubic-bezier(.2,1,.3,1);transform-origin:50% 100%;filter:drop-shadow(0 .8vh 1.4vh rgba(11,7,17,.26))" />
      <img src="assets/flower-1.png" alt="Flower" style="position:absolute;left:50%;bottom:29%;transform:translateX(-50%);width:8.5vh;height:14.4vh;object-fit:contain;object-position:bottom;opacity:0;transition:opacity .3s ease,transform .45s cubic-bezier(.2,1,.3,1);transform-origin:50% 100%;filter:drop-shadow(0 .8vh 1.4vh rgba(11,7,17,.26))" />
      <img src="assets/flower-1.png" alt="Flower" style="position:absolute;left:62%;bottom:25%;transform:translateX(-50%);width:9.5vh;height:16.1vh;object-fit:contain;object-position:bottom;opacity:0;transition:opacity .3s ease,transform .45s cubic-bezier(.2,1,.3,1);transform-origin:50% 100%;filter:drop-shadow(0 .8vh 1.4vh rgba(11,7,17,.26))" />
      <img src="assets/flower-1.png" alt="Flower" style="position:absolute;left:76%;bottom:20%;transform:translateX(-50%);width:11vh;height:18.7vh;object-fit:contain;object-position:bottom;opacity:0;transition:opacity .3s ease,transform .45s cubic-bezier(.2,1,.3,1);transform-origin:50% 100%;filter:drop-shadow(0 .8vh 1.4vh rgba(11,7,17,.26))" />
    </div>

    <div style="position:absolute;left:2.6vh;top:8.5vh;display:flex;align-items:center;gap:1.4vh;padding:1.2vh 1.6vh;background:linear-gradient(180deg,#9E77E8,#7B54D6);border:.4vh solid #fff;border-radius:1.8vh;box-shadow:0 .4vh .8vh rgba(0,0,0,.24)">
      <div style="display:flex;flex-direction:column;gap:.6vh">
        <div style="position:relative;width:26vh;height:2.8vh;border:.35vh solid #fff;border-radius:99px;overflow:hidden;background:#2E1B60">
          <div ref="{{ gardenFillRef }}" style="position:absolute;left:0;top:0;bottom:0;width:0%;background:linear-gradient(180deg,#FFD75E,#F0A62A);border-radius:99px"></div>
          <div ref="{{ stepTicksRef }}" style="position:absolute;inset:0">
            <div style="position:absolute;left:0;top:0;bottom:0;width:1px;background:rgba(255,255,255,.35)"></div>
            <div style="position:absolute;left:0;top:0;bottom:0;width:1px;background:rgba(255,255,255,.35)"></div>
            <div style="position:absolute;left:0;top:0;bottom:0;width:1px;background:rgba(255,255,255,.35)"></div>
            <div style="position:absolute;left:0;top:0;bottom:0;width:1px;background:rgba(255,255,255,.35)"></div>
            <div style="position:absolute;left:0;top:0;bottom:0;width:1px;background:rgba(255,255,255,.35)"></div>
          </div>
          <div ref="{{ stageMarkRef }}" style="position:absolute;left:0;top:0;bottom:0;width:2px;background:#F7EEDB;opacity:0;box-shadow:0 0 1vh rgba(247,238,219,.8);transition:left .3s ease,opacity .3s ease"></div>
          <div ref="{{ nextStepRef }}" style="position:absolute;left:0;top:0;bottom:0;width:.45vh;margin-left:-.22vh;background:#fff;border-radius:99px;opacity:0;transition:left .25s ease,opacity .25s ease"></div>
        </div>
        <div style="position:relative;width:26vh;height:.8vh;border-radius:99px;background:rgba(18,12,28,.45);overflow:hidden">
          <div ref="{{ holdRingRef }}" style="height:100%;width:0%;background:#A5EA76;opacity:0;border-radius:99px;transition:opacity .2s ease"></div>
        </div>
      </div>
      <div ref="{{ plotTextRef }}" style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:2.1vh;line-height:1;color:#fff;text-shadow:0 .25vh 0 rgba(0,0,0,.3);min-width:5vh;text-align:right">0/5</div>
    </div>

    <div style="position:absolute;left:2.6vh;top:19vh;max-width:30vh;padding:1vh 1.6vh;border-radius:1.2vh;background:rgba(46,27,96,.55);border:.25vh solid rgba(255,255,255,.35)">
      <div style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:700;font-size:1.5vh;line-height:1.35;color:#fff;text-wrap:pretty">{{ t.pondHint }}</div>
    </div>

    <div style="position:absolute;left:0;right:0;bottom:calc(12% - 20px);display:flex;flex-direction:column;align-items:center;gap:1.2vh">
      <div ref="{{ lineWrap4Ref }}" style="padding:1vh 2vh;background:#fff;border-radius:1.8vh;box-shadow:0 .5vh 1vh rgba(9,32,48,.28);opacity:0;transition:opacity .28s ease">
        <div ref="{{ line4Ref }}" style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:700;font-size:1.9vh;color:#3A2E66"></div>
      </div>
    </div>
  </sc-if>

</div>
</x-dc>
<script type="text/x-dc" data-dc-script data-props="{&quot;breathEffort&quot;:{&quot;editor&quot;:&quot;enum&quot;,&quot;options&quot;:[&quot;Gentle&quot;,&quot;Standard&quot;,&quot;Strong&quot;],&quot;default&quot;:&quot;Standard&quot;,&quot;tsType&quot;:&quot;string&quot;,&quot;section&quot;:&quot;Play feel&quot;},&quot;pacing&quot;:{&quot;editor&quot;:&quot;enum&quot;,&quot;options&quot;:[&quot;Unhurried&quot;,&quot;Steady&quot;,&quot;Brisk&quot;],&quot;default&quot;:&quot;Steady&quot;,&quot;tsType&quot;:&quot;string&quot;,&quot;section&quot;:&quot;Play feel&quot;},&quot;coaching&quot;:{&quot;editor&quot;:&quot;enum&quot;,&quot;options&quot;:[&quot;Quiet&quot;,&quot;Warm&quot;,&quot;Chatty&quot;],&quot;default&quot;:&quot;Warm&quot;,&quot;tsType&quot;:&quot;string&quot;,&quot;section&quot;:&quot;Play feel&quot;}}">
const PLACES = [
  { id: 'stream', index: '01', accent: '#9FD0F2', wash: '#E3F2FD', chip: 'linear-gradient(180deg,#7FDDF7 0%,#12A5E0 100%)', dur: 30, art: 'url(assets/card-stream.png)', pos: '50% 40%' },
  { id: 'cave',   index: '02', accent: '#F2A9C4', wash: '#FBE6EE', chip: 'linear-gradient(180deg,#FF8ED0 0%,#E9349B 100%)', dur: 45, art: 'url(assets/scene-tunnel.png)', pos: '50% 50%' },
  { id: 'clearing', index: '03', accent: '#F6C96B', wash: '#FDF0D8', chip: 'linear-gradient(180deg,#FFD75E 0%,#F58A0C 100%)', dur: 60, art: 'url(assets/card-stage.png)', pos: '50% 44%' },
  { id: 'pond',   index: '04', accent: '#A9B4F2', wash: '#E8EAFB', chip: 'linear-gradient(180deg,#A5EA76 0%,#3FA80F 100%)', dur: 0,  art: 'url(assets/scene-garden.png)', pos: '50% 62%' }
];

const STR = {
  en: {
    pickPlace: 'Choose a place', grownups: 'FOR GROWN-UPS', back: 'BACK', sparks: 'SPARKS', timeBar: 'TIME', breathBar: 'BREATH',
    hint: 'Hold SPACE to breathe, or press and hold anywhere',
    puff: 'PUFF', pulseHint: 'SHORT PULSE = QUICK PUFF · LONG PULSE = LONGER BREATH',
    names: { stream: 'Lillypad Hop', cave: 'The Cave', clearing: 'Firefly Conversation', pond: 'The Garden' },
    teach: { stream: 'Little puffs, one after another', cave: 'One long, steady breath', clearing: 'Answer each pulse you see', pond: 'Longer breaths make it grow' },
    durs: { stream: '30 SECONDS', cave: '45 SECONDS', clearing: '60 SECONDS', pond: '5 STAGES' },
    good: 'That was a good one.', softer: 'A little softer.', firmer: 'A little more air.',
    tooMuch: 'Too much air — ease off sooner.',
    shorter: 'A shorter one this time.', longer: 'Hold it a little longer.',
    caveHint: 'Match your breath to the pale band on the left.',
    pondHint: 'Breathe out and KEEP going — holding is what grows it.',
    goodNow: 'Yes! Next one.', yourGo: 'YOUR GO',
    streamHint: 'Blow until the ring turns green, then hold it there.',
    hold: 'Hold it steady.', drifting: 'Come back to the light.', lovely: 'Lovely.',
    watch: 'Watch the fireflies', yourTurn: 'Now your turn.',
    pondLine: 'Hold your breath out and watch it grow.',
    grow: 'GROW', grew: 'It grew a little.', bloomed: 'Fully bloomed.',
    keepGoing: 'Keep the breath going a little longer.',
    breathe: 'HOW WE BREATHE', conn: 'How are we breathing?',
    srcKey: 'Spacebar', srcKeyBlurb: 'No hardware. Hold the space bar. Good for testing.',
    srcSerial: 'Flute + sensor', srcSerialBlurb: 'The sensor measures the air, the flute plays the note.',
    tryBlow: 'Give it a blow — if the bar moves, we are ready.',
    noteHeard: 'NOTE PLAYED', reading: 'READING',
    reZero: 'RE-ZERO SENSOR',
    stKey: 'spacebar', stSerial: 'flute ready', stOff: 'not connected',
    onBar: 'ON THE BAR', yourBreath: 'YOUR BREATH', lenLbl: 'LENGTH', strengthLbl: 'STRENGTH', restLbl: 'RESTING', breathsLbl: 'BREATHS',
    notMeasured: 'not measured yet — the next game will ask',
    warmRest: 'Sit still for a moment',
    warmRestSub: 'Hands off the flute. We are listening to how quiet it is.',
    warmBlow: 'Now breathe out, twice',
    warmBlowSub: 'Just an ordinary breath into the flute. Not your biggest — the one that feels easy. Then one more.',
    warmGot: 'That is your breath',
    warmGotSub: 'Everything in the game is now measured against this, so it fits you.',
    warmNothing: 'We did not catch that',
    warmNothingSub: 'Make sure the flute is on the tube, then breathe out gently twice more.',
    letsPlay: 'PLAY', againBreath: 'BREATHE AGAIN', useLast: 'USE LAST TIME',
    connectNow: 'CONNECT', skipConnect: 'PLAY WITHOUT IT',
    rGreat: 'Beautiful breathing!', rGood: 'Really well done.', rNice: 'Nice work.', rTried: 'Good try!',
    rSubHigh: 'Your breath stayed lovely and steady.', rSubLow: 'Every breath counts. Try another?',
    rPuffs: 'PUFFS LANDED', rSteady: 'LONGEST STEADY', rPatterns: 'PATTERNS', rFlowers: 'FLOWERS',
    rBreaths: 'BREATHS', rLongest: 'LONGEST BREATH', rSparks: 'SPARKS',
    rRetry: 'AGAIN', rNext: 'NEXT PLACE', rPlaces: 'ALL PLACES', rHome: 'HOME',
    errBrowser: 'This needs Chrome or Edge.',
    errPort: 'No port picked. Close the Arduino Serial Monitor first — only one program can hold the cable.',
    errUnplug: 'The cable came out. Plug it back in and connect again.',
    errMic: 'The microphone was not allowed.',
    warnLoud: 'It is quite noisy in here — that is fine, just blow a little firmer.',
    warnFilter: 'Your browser is still filtering the mic. Turn off voice isolation in your sound settings.'
  },
  hi: {
    pickPlace: 'Ek jagah chunein', grownups: 'BADON KE LIYE', back: 'PICHHE', sparks: 'CHINGARI', timeBar: 'SAMAY', breathBar: 'SAANS',
    hint: 'SPACE dabaye rakhein, ya kahin bhi dabaye rakhein',
    puff: 'PHOONK', pulseHint: 'CHHOTI JHALAK = CHHOTI PHOONK · LAMBI JHALAK = LAMBI SAANS',
    names: { stream: 'Lillypad Hop', cave: 'Gufa', clearing: 'Jugnu ki Baatein', pond: 'Bagiya' },
    teach: { stream: 'Chhoti phoonkein, ek ke baad ek', cave: 'Ek lambi, sthir saans', clearing: 'Har jhalak ka jawab dein', pond: 'Lambi saans se yeh badhta hai' },
    durs: { stream: '30 SECOND', cave: '45 SECOND', clearing: '60 SECOND', pond: '5 CHARAN' },
    good: 'Yeh achhi thi.', softer: 'Thoda dheere.', firmer: 'Thodi aur hawa.',
    tooMuch: 'Bahut zyada hawa — pehle rukein.',
    shorter: 'Is baar chhoti.', longer: 'Thodi der aur rokein.',
    caveHint: 'Apni saans ko baayin patti se milaayein.',
    pondHint: 'Saans chhodein aur ROKE rakhein — rokne se hi badhta hai.',
    goodNow: 'Haan! Agli.', yourGo: 'AAPKI BAARI',
    streamHint: 'Ring hare hone tak phoonkein, phir wahin rokein.',
