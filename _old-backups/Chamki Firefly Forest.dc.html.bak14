const SAVE_KEY = 'chamkiForest.v3';
const PAD_GAPS = [14, 25, 11, 21, 30, 13, 24, 17];
const PAD_POS = [0];
function padPos(i) {
  while (PAD_POS.length <= i) {
    const n = PAD_POS.length - 1;
    PAD_POS.push(PAD_POS[n] + PAD_GAPS[n % PAD_GAPS.length]);
  }
  return PAD_POS[i];
}
function padGap(i) { return PAD_GAPS[i % PAD_GAPS.length]; }


/* ==========================================================
   BREATH INPUT — the flute's pressure sensor, over USB.

   The Arduino stays dumb. Fifty times a second it types one
   line of plain text down the cable — "0.734,523.3" — meaning
   how hard, and which note. Nothing below is clever: it reads
   text and splits it at the comma.

   Web Serial needs Chrome or Edge AND a real http:// origin.
   Opening this file by double-clicking will not work — serve
   the folder and use localhost.

   The spacebar stays as a fallback so the game can be shown,
   tested and tuned with no board on the table.
   ========================================================== */
const SERIAL_BAUD = 115200;
const CAL_KEY = 'chamkiForest.breath.v1';

// What the recorder actually sounds. German fingering, so going
// down the scale is simply "cover one more finger" each time.
// The Hz comes from the Arduino; this only turns it into a name.
/* These must match NOTE_HZ[] in the sketch exactly — the sketch decides
   which hertz it sends, and this table only turns that back into a name.
   They were an octave apart, which is why the panel showed a dash. */
const LADDER = [
  { n: 'C', holes: 0, hz: 523.25 },
  { n: 'B', holes: 1, hz: 493.88 },
  { n: 'A', holes: 2, hz: 440.00 },
  { n: 'G', holes: 3, hz: 392.00 },
  { n: 'F', holes: 4, hz: 349.23 },
  { n: 'E', holes: 5, hz: 329.63 },
  { n: 'D', holes: 6, hz: 261.63 }
];
function noteFromHz(hz) {
  if (!hz) return null;
  let best = null, bc = 1e9;
  LADDER.forEach(l => { const c = Math.abs(1200 * Math.log2(hz / l.hz)); if (c < bc) { bc = c; best = l; } });
  return bc < 60 ? best : null;   // more than half a semitone out — don't guess
}

/* ==========================================================
   TONE — the fireflies' voice, and the child's answer.

   A recorded sample is the wrong tool here: this note has to hold
   for however long a child keeps breathing, at a pitch the game
   chooses. So it is synthesised — but as a flute rather than a
   raw oscillator, which suits a game played on a recorder.

   Three sine partials (1st, 2nd, 3rd) in falling amounts give the
   hollow, woody colour of a pipe. A slow shallow vibrato keeps it
   from sounding dead, and a lowpass takes the glassy edge off.
   Only the master GAIN moves when notes start and stop — starting
   and stopping oscillators clicks audibly; a gain slide does not.
   ========================================================== */
const Tone = {
  ctx: null, gain: null, filter: null, parts: [], vib: null, muted: false, sounding: false,

  ensure() {
    if (this.ctx) return true;
    try {
      const AC = window.AudioContext || window.webkitAudioContext;
      if (!AC) return false;
      const ctx = new AC();
      this.ctx = ctx;

      this.gain = ctx.createGain();
      this.gain.gain.value = 0;

      // Rolls off the upper partials so the tone stays soft at any pitch.
      this.filter = ctx.createBiquadFilter();
      this.filter.type = 'lowpass';
      this.filter.frequency.value = 1800;
      this.filter.Q.value = 0.6;
      this.filter.connect(this.gain);
      this.gain.connect(ctx.destination);

      // A breathy pipe: strong fundamental, a little octave, a hint of 12th.
      [[1, 1.0], [2, 0.28], [3, 0.10]].forEach(([mult, amt]) => {
        const o = ctx.createOscillator();
        o.type = 'sine';
        o.frequency.value = 440 * mult;
        const g = ctx.createGain();
        g.gain.value = amt;
        o.connect(g); g.connect(this.filter);
        o.start();
        this.parts.push({ osc: o, mult: mult });
      });

      // Slow shallow vibrato — the difference between a note and a machine.
      const lfo = ctx.createOscillator();
      lfo.frequency.value = 5.2;
      const depth = ctx.createGain();
      depth.gain.value = 2.6;                    // cents-ish, deliberately tiny
      lfo.connect(depth);
      this.parts.forEach(p => depth.connect(p.osc.detune));
      lfo.start();
      this.vib = lfo;
      return true;
    } catch (e) { this.ctx = null; return false; }
  },

  play(hz, level) {
    if (this.muted || !this.ensure()) return;
    if (this.ctx.state === 'suspended') { try { this.ctx.resume(); } catch (e) {} }
    const t = this.ctx.currentTime;
    this.parts.forEach(p => p.osc.frequency.setTargetAtTime(hz * p.mult, t, 0.012));
    // brighter as the breath gets stronger, the way a real pipe behaves
    const lv = Math.max(0, Math.min(1, level == null ? 1 : level));
    this.filter.frequency.setTargetAtTime(1200 + 1800 * lv, t, 0.03);
    this.gain.gain.cancelScheduledValues(t);
    this.gain.gain.setTargetAtTime(0.05 + 0.10 * lv, t, 0.035);   // soft attack
    this.sounding = true;
  },

  stop() {
    if (!this.ctx || !this.sounding) return;
    const t = this.ctx.currentTime;
    this.gain.gain.cancelScheduledValues(t);
    this.gain.gain.setTargetAtTime(0, t, 0.06);                   // soft release
    this.sounding = false;
  },

  setMuted(m) { this.muted = m; if (m) this.stop(); }
};

/* ==========================================================
   SFX — short recorded sounds for the moments that deserve one.
   Pixabay Content License; see assets/audio/CREDITS.txt.
   Decoded once on first use and reused, so a hop never waits.
   ========================================================== */
const Sfx = {
  files: { pop: 'assets/audio/pop.mp3', ping: 'assets/audio/ping.mp3',
           chime: 'assets/audio/chime.mp3', sparkle: 'assets/audio/sparkle.mp3' },
  buf: {}, loading: {},

  play(name, vol) {
    if (Tone.muted || !Tone.ensure()) return;
    const ctx = Tone.ctx;
    if (ctx.state === 'suspended') { try { ctx.resume(); } catch (e) {} }
    const b = this.buf[name];
    if (!b) { this.load(name); return; }        // first ask warms it for next time
    try {
      const src = ctx.createBufferSource();
      src.buffer = b;
      const g = ctx.createGain();
      g.gain.value = vol == null ? 0.35 : vol;
      src.connect(g); g.connect(ctx.destination);
      src.start();
    } catch (e) {}
  },

  load(name) {
    if (this.buf[name] || this.loading[name] || !this.files[name] || !Tone.ensure()) return;
    this.loading[name] = true;
    fetch(this.files[name])
      .then(r => r.arrayBuffer())
      .then(a => Tone.ctx.decodeAudioData(a))
      .then(b => { this.buf[name] = b; })
      .catch(() => {})                          // no sound is fine; a crash is not
      .then(() => { this.loading[name] = false; });
  },

  warm() { Object.keys(this.files).forEach(n => this.load(n)); },

  /* A short sung note rather than a recorded click. Used where a hard
     sample cut across the music — answering the fireflies, clearing a
     gap, growing a step. Its own oscillator, so it never interrupts a
     breath that is still sounding. */
  blip(hz, vol) {
    if (Tone.muted || !Tone.ensure()) return;
    const ctx = Tone.ctx;
    if (ctx.state === 'suspended') { try { ctx.resume(); } catch (e) {} }
    try {
      const t = ctx.currentTime;
      const g = ctx.createGain();
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(Math.max(0.02, vol == null ? 0.35 : vol), t + 0.02);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.42);   // bell-ish decay
      const lp = ctx.createBiquadFilter();
      lp.type = 'lowpass'; lp.frequency.value = 3200;
      lp.connect(g); g.connect(ctx.destination);
      [[1, 1], [2, 0.32], [3, 0.12]].forEach(([m, a]) => {
        const o = ctx.createOscillator();
        o.type = 'sine';
        o.frequency.value = hz * m;
        const og = ctx.createGain();
        og.gain.value = a;
        o.connect(og); og.connect(lp);
        o.start(t); o.stop(t + 0.5);
      });
    } catch (e) {}
  }
};

// Where the Garden's five steps sit on the scale — a rising phrase, so
// the flower's growth is something you can hear as well as see.
const GROW_NOTES = [261.63, 329.63, 392.00, 493.88, 523.25];

// The Cave's own rungs — same idea, one octave down so it sits in the dark.
const CAVE_RUNGS = [329.63, 392.00, 440.00, 493.88, 587.33];

/* ==========================================================
   BGM — a quiet bed under each place.

   No file: a loop long enough not to annoy would be megabytes,
   and every loop eventually shows its seam. This is four sine
   voices holding a chord, drifting to a related one every few
   seconds. It never repeats exactly and never arrives at a
   join. Deliberately very quiet — it should be noticed only
   when it stops.
   ========================================================== */
/* ==========================================================
   BGM — a recorded flute bed under every place.

   Two goes at synthesising this failed: the first slid every
   pitch on every chord change, which is how a siren is built,
   and the second was still obviously a machine. Some things
   want a real instrument played by a person.

   "Forest Whisper Theme" by Alexandr Zhelanov, CC0. Trimmed,
   and its tail crossfaded onto its head so the loop has no
   seam — the raw file ended 4.7dB away from where it started,
   which would thump once a minute. See assets/audio/CREDITS.txt.
   ========================================================== */
const Bgm = {
  // One track per place, so each has its own weather.
  tracks: {
    stream:       'assets/audio/bgm-stream.mp3',        // lofi, easy, a little playful
    cave:         'assets/audio/bgm-cave.mp3',          // still and thoughtful
    conversation: 'assets/audio/bgm-conversation.mp3',  // dreamy and sparse, leaves room
    pond:         'assets/audio/bgm-garden.mp3'         // flute, warm, unhurried
  },
  buf: {}, loading: {}, want: null,
  node: null, gain: null, ctxRef: null,
  on: false, level: 0.26,

  load(name) {
    const url = this.tracks[name];
    if (!url || this.buf[name] || this.loading[name] || !Tone.ensure()) return;
    this.loading[name] = true;
    fetch(url)
      .then(r => r.arrayBuffer())
      .then(a => Tone.ctx.decodeAudioData(a))
      .then(b => { this.buf[name] = b; if (this.on && this.want === name) this.spin(name); })
      .catch(() => {})                                          // silence beats a crash
      .then(() => { this.loading[name] = false; });
  },

  spin(name) {
    const ctx = Tone.ctx;
    if (!ctx || !this.buf[name]) return;
    this.kill();
    this.playing = name;
    this.gain = ctx.createGain();
    this.gain.gain.value = 0;
    this.gain.connect(ctx.destination);
    this.node = ctx.createBufferSource();
    this.node.buffer = this.buf[name];
    this.node.loop = true;              // seam already removed in the file
    this.node.connect(this.gain);
    this.node.start();
    this.gain.gain.setTargetAtTime(this.level, ctx.currentTime, 2.2);   // drifts in
    this.ctxRef = ctx;
  },

  kill() {
    try { if (this.node) { this.node.stop(); this.node.disconnect(); } } catch (e) {}
    this.node = null;
  },

  start(name) {
    if (Tone.muted || !Tone.ensure()) return;
    const ctx = Tone.ctx;
    if (ctx.state === 'suspended') { try { ctx.resume(); } catch (e) {} }
    this.on = true;
    this.want = name;
    if (!this.buf[name]) { this.load(name); return; }   // spins itself once decoded
    // Already on this exact track: leave it running rather than restarting,
    // so replaying a place does not chop the music back to the top.
    if (this.node && this.playing === name && this.ctxRef === ctx) {
      this.gain.gain.setTargetAtTime(this.level, ctx.currentTime, 1.2);
      return;
    }
    this.spin(name);
  },

  stop() {
    this.on = false; this.want = null; this.playing = null;
    if (!this.gain || !Tone.ctx) { this.kill(); return; }
    const t = Tone.ctx.currentTime;
    this.gain.gain.cancelScheduledValues(t);
    this.gain.gain.setTargetAtTime(0, t, 0.8);
    const n = this.node;
    setTimeout(() => { if (this.node === n) this.kill(); }, 2500);   // after the fade
  },

  tick() {}                                    // the file carries its own motion
};

const BreathIn = {
  /* ------------------------------------------------------------------
     THE ONE IDEA THAT MAKES THIS PERSONAL.

     Every child's "normal" is different, and the sensor's own resting
     value drifts between sessions. So nothing in the games is written
     as a raw sensor number. Instead we measure ONE ordinary breath and
     pin it to NORMAL on the bar — deliberately the MIDDLE, not the top.

         rest ............ 0.0    sensor sitting still, nobody blowing
         normal breath ... 0.5    an easy, unforced breath
         firm breath ..... 1.0    about twice that effort

     Putting normal at the middle is the whole point. If a normal breath
     filled the bar (which is what it used to do) there would be nothing
     left to aim at, and every puff would read as maximum. Now there is
     room on BOTH sides: a gentle breath has somewhere to sit, and a
     firmer one has somewhere to go.
     ------------------------------------------------------------------ */
  NORMAL: 0.5,

  src: 'key',                 // 'key' | 'serial'
  raw: 0, connected: false,
  why: '', lines: 0, hz: 0, note: null,
  serialRaw: 0,
  onChange: null,

  // The measured person. amp/dur are what ONE normal breath looks like.
  cal: { rest: 0, amp: 0.35, dur: 2200, breaths: 0, ready: false, when: 0 },

  active() { return this.src === 'serial' && this.connected; },
  _emit() { if (this.onChange) this.onChange(); },

  // Sensor reading -> the 0..1 the games think in, with a normal
  // breath landing on NORMAL. Allowed past 1 so "much harder than
  // usual" is still expressible; the games clamp where they need to.
  norm() {
    const c = this.cal;
    const span = Math.max(0.02, c.amp - c.rest);
    return Math.max(0, Math.min(1.6, ((this.raw - c.rest) / span) * this.NORMAL));
  },

  // How long this person's comfortable breath is, against the 2.2s the
  // pulse patterns were originally written for. Used by the games that
  // measure TIME rather than strength.
  durScale() {
    if (!this.cal.ready) return 1;
    return Math.max(0.6, Math.min(1.9, this.cal.dur / 2200));
  },

  /* ---- The Arduino, over USB ------------------------------------- */
  _port: null, _reader: null, _writer: null, _keep: true, _buf: '',

  /* Chrome remembers a port once it has been picked, and hands it back
     without another dialog. So after the very first time, the flute just
     connects on its own — nobody has to choose anything again. */
  async autoConnect() {
    if (!('serial' in navigator)) return false;
    try {
      const ports = await navigator.serial.getPorts();
      if (!ports.length) return false;
      this._port = ports[0];
      await this._port.open({ baudRate: SERIAL_BAUD });
    } catch (e) { this._port = null; return false; }
    this.src = 'serial'; this.connected = true; this._keep = true;
    try {
      const enc = new TextEncoderStream();
      enc.readable.pipeTo(this._port.writable).catch(() => {});
      this._writer = enc.writable.getWriter();
    } catch (e) { this._writer = null; }
    this._readLoop();
    this._emit();
    return true;
  },

  async useSerial() {
    if (!('serial' in navigator)) return { ok: false, why: 'needBrowser' };
    try {
      this._port = await navigator.serial.requestPort();
      await this._port.open({ baudRate: SERIAL_BAUD });
    } catch (e) {
      // Almost always one of: nothing picked, or the Arduino Serial
      // Monitor still holds the cable. Only one program gets it at a time.
      return { ok: false, why: 'noPort' };
    }
    this.connected = true; this._keep = true;
    try {
      const enc = new TextEncoderStream();
      enc.readable.pipeTo(this._port.writable).catch(() => {});
      this._writer = enc.writable.getWriter();
    } catch (e) { this._writer = null; }
    this._readLoop();
    this._emit();
    return { ok: true };
  },

  async _readLoop() {
    const dec = new TextDecoderStream();
    this._port.readable.pipeTo(dec.writable).catch(() => {});
    this._reader = dec.readable.getReader();
    try {
      while (this._keep) {
        const { value, done } = await this._reader.read();
        if (done) break;
        this._buf += value;
        let i;
        while ((i = this._buf.indexOf('\n')) >= 0) {
          this._parse(this._buf.slice(0, i).trim());
          this._buf = this._buf.slice(i + 1);
        }
        if (this._buf.length > 400) this._buf = '';
      }
    } catch (e) { /* cable pulled mid-read */ }
    // A seven-year-old WILL pull the cable. Notice it, say something
    // kind, and let them reconnect — never freeze.
    this.connected = false; this.serialRaw = 0; this.raw = 0; this._buf = '';
    if (this.src === 'serial' && this._keep) this.why = 'unplugged';
    this._emit();
  },

  _parse(l) {
    if (!l || l[0] === '#' || l.startsWith('READY') || l.startsWith('ERR')) return;
    const p = l.split(','), v = parseFloat(p[0]);
    if (!isFinite(v)) return;
    this.serialRaw = Math.max(0, Math.min(1, v));   // sketch already sends 0..1
    if (p[1]) { const hz = parseFloat(p[1]); if (isFinite(hz) && hz > 0) { this.hz = hz; this.note = noteFromHz(hz); } }
    this.lines++;
  },

  // Tell the sketch to take a fresh "nobody is blowing" reading.
  async reZero() { if (this._writer) { try { await this._writer.write('z'); } catch (e) {} } },

  async closeSerial() {
    this._keep = false;
    try { if (this._reader) await this._reader.cancel(); } catch (e) {}
    try { if (this._writer) await this._writer.close(); } catch (e) {}
    try { if (this._port) await this._port.close(); } catch (e) {}
    this._port = null; this._reader = null; this._writer = null;
    this.connected = false; this.serialRaw = 0;
  },

  tick() { this.raw = this.active() ? this.serialRaw : 0; },

  async use(src) {
    this.why = '';
    if (src !== 'serial' && this.connected) await this.closeSerial();
    this.src = src;
    let r = { ok: true };
    if (src === 'serial') r = await this.useSerial();
    if (!r.ok) { this.why = r.why; this.src = 'key'; }
    this._emit();
    return r;
  },

  /* ---- Measuring one ordinary breath ------------------------------
     We do NOT try to judge a breath as it happens — a child ramps up,
     wobbles, runs out of air, and any live threshold would catch the
     wrong moment. Instead we record the whole window and read it back
     afterwards, when the shape of the breath is already known.
     ------------------------------------------------------------------ */
  capture: null,

  startCapture() { this.capture = { v: [], t: [] }; },
  pushCapture(dt) {
    if (!this.capture) return;
    this.capture.v.push(this.raw);
    this.capture.t.push(dt);
    if (this.capture.v.length > 3000) { this.capture.v.shift(); this.capture.t.shift(); }
  },

  // Average the room's idle reading. The HX710B rarely sits at zero and
  // where it sits changes with temperature, so this must be measured.
  restFromCapture() {
    const cap = this.capture;
    if (!cap || !cap.v.length) return 0;
    let s = 0; for (let i = 0; i < cap.v.length; i++) s += cap.v[i];
    return s / cap.v.length;
  },

  // Pull the individual breaths back out of the recorded window.
  analyseCapture(rest) {
    const cap = this.capture;
    if (!cap || cap.v.length < 10) return null;
    const peak = Math.max.apply(null, cap.v);
    if (peak - rest < 0.012) return null;              // nobody actually blew
    // Two thresholds, both relative to the breath's own height so they
    // work for a big blow and a small one. The high one FINDS a breath
    // (immune to noise); the low one then widens it out to where the
    // air really started and stopped. Using only the high mark would
    // clip the gentle ramp in and out and report every breath short.
    const hi = rest + (peak - rest) * 0.33;
    const lo = rest + (peak - rest) * 0.15;
    const runs = [];
    let i = 0;
    while (i < cap.v.length) {
      if (cap.v[i] > hi) {
        let a = i, b = i;
        while (b + 1 < cap.v.length && cap.v[b + 1] > hi) b++;
        while (a > 0 && cap.v[a - 1] > lo) a--;
        while (b + 1 < cap.v.length && cap.v[b + 1] > lo) b++;
        // A breath still running when the recording ends has only been
        // half seen — counting it would report every breath as short and
        // weak. Note it and leave it out.
        if (b >= cap.v.length - 1) { i = b + 1; continue; }
        let ms = 0, pk = 0;
        for (let k = a; k <= b; k++) { ms += cap.t[k]; pk = Math.max(pk, cap.v[k]); }
        if (ms > 260) runs.push({ ms: ms, pk: pk });    // ignore coughs and blips
        i = b + 1;
      } else i++;
    }
    if (!runs.length) return null;
    const amp = runs.reduce((a, r) => a + r.pk, 0) / runs.length;
    const dur = runs.reduce((a, r) => a + r.ms, 0) / runs.length;
    return { amp: amp, dur: dur, breaths: runs.length };
  },

  commitCal(rest, res) {
    this.cal = {
      rest: rest,
      amp: Math.max(rest + 0.02, res.amp),             // never a zero-width span
      dur: Math.max(400, Math.min(12000, res.dur)),
      breaths: res.breaths,
      ready: true,
      when: Date.now()
    };
    this.capture = null;
    this.saveCal();
    this._emit();
  },

  saveCal() { try { localStorage.setItem(CAL_KEY, JSON.stringify(this.cal)); } catch (e) {} },
  loadCal() {
    try {
      const raw = localStorage.getItem(CAL_KEY);
      if (!raw) return false;
      const c = JSON.parse(raw);
      if (!c || !c.ready || !isFinite(c.amp) || !isFinite(c.dur)) return false;
      this.cal = c;
      return true;
    } catch (e) { return false; }
  }
};

class Component extends DCLogic {
  /* 'boot' shows only the background. The flute usually reconnects in a few
     milliseconds, so deciding BEFORE painting anything means a returning
     player never sees the chooser flash past on the way to the game. */
  state = { screen: 'boot', lang: 'en', sound: true };

  progressRef = React.createRef();
  progressRef2 = React.createRef();
  progressRef3 = React.createRef();
  padLaneRef = React.createRef();
  flyRef = React.createRef();
  gaugeRef = React.createRef();
  gaugeZoneRef = React.createRef();
  gaugePeakRef = React.createRef();
  zoneHold = 0;
  hoppedThisBreath = false;
  jarCountRef = React.createRef();
  jarFillRef = React.createRef();
  jarWrapRef = React.createRef();
  lineRef = React.createRef();
  lineWrapRef = React.createRef();
  caveBgRef = React.createRef();
  caveObsRef = React.createRef();
  caveFlyRef = React.createRef();
  caveBarRef = React.createRef();
  caveStreakRef = React.createRef();
  caveAimRef = React.createRef();
  caveLevelRef = React.createRef();
  jarCount2Ref = React.createRef();
  jarFill2Ref = React.createRef();
  jarWrap2Ref = React.createRef();
  line2Ref = React.createRef();
  lineWrap2Ref = React.createRef();
  convGlowRef = React.createRef();
  convBreathRef = React.createRef();
  convSeqRef = React.createRef();
  convFlyRef = React.createRef();
  convDotsRef = React.createRef();
  convStepRef = React.createRef();
  convHoldRef = React.createRef();
  convHoldWrapRef = React.createRef();
  convTargetRef = React.createRef();
  jarCount3Ref = React.createRef();
  jarFill3Ref = React.createRef();
  line3Ref = React.createRef();
  lineWrap3Ref = React.createRef();
  pondOrbRef = React.createRef();
  plotRef = React.createRef();
  plotIdx = 0;
  gardenFillRef = React.createRef();
  stageMarkRef = React.createRef();
  holdRingRef = React.createRef();
  nextStepRef = React.createRef();
  stepTicksRef = React.createRef();
  plotTextRef = React.createRef();
  shownStage = 0;
  line4Ref = React.createRef();
  lineWrap4Ref = React.createRef();
  gardenStage = 0;

  cbBarRef = React.createRef();
  cbValRef = React.createRef();
  cbNoteRef = React.createRef();
  cbNormRef = React.createRef();
  warmBarRef = React.createRef();
  warmLiveRef = React.createRef();
  warmStage = 0;
  warmT = 0;
  warmRest = 0;
  warmSeen = 0;
  warmResult = null;
  warmFailed = false;
  pendingPlace = null;

  breath = { value: 0, held: false, peak: 0, dur: 0 };
  keyDown = false;
  pointerDown = false;

  sparks = 0;
  breaths = 0;
  longest = 0;
  elapsed = 0;
  line = '';
  lineTimer = 0;

  padIdx = 0;
  padScroll = 0;
  hopT = 999;
  hopDur = 800;
  hopFrom = 0;
  hopGap = 14;

  caveScroll = 0;
  caveY = 56;
  caveObs = [];
  caveStreak = 0;
  caveBest = 0;
  caveIn = false;

  convSeq = [];
  convIdx = 0;
  convPhase = 'show';
  convPhaseTime = 0;
  convStep = 0;

  componentDidMount() {
    this.ensureLoop();
    BreathIn.loadCal();
    Sfx.warm();
    Bgm.load('stream');
    /* Try the flute first. If it is already plugged in and trusted, skip
       straight to the places — asking again would just be a door to shut. */
    let decided = false;
    const settle = (on) => {
      if (decided) return;
      decided = true;
      this.setState({ screen: on ? 'cards' : 'connect' });
    };
    BreathIn.autoConnect().then(settle).catch(() => settle(false));
    // Never sit on a blank screen if the browser stalls over the port.
    setTimeout(() => settle(BreathIn.active()), 1500);
    BreathIn.onChange = () => {
      const s = this.state.screen;
      if (s === 'connect' || s === 'warmup') this.forceUpdate();
    };
  }

  componentWillUnmount() {
    Tone.stop(); Bgm.stop();
    this.loopOn = false;
    BreathIn.onChange = null;
    cancelAnimationFrame(this.raf);
    window.removeEventListener('keydown', this.onKeyDown);
    window.removeEventListener('keyup', this.onKeyUp);
    window.removeEventListener('pointerdown', this.onPointerDown);
    window.removeEventListener('pointerup', this.onPointerUp);
  }

  t() { return STR[this.state.lang] || STR.en; }

  effort() { const e = this.props.breathEffort || 'Standard'; return e === 'Gentle' ? 0.74 : e === 'Strong' ? 1.28 : 1; }
  pace() { const p = this.props.pacing || 'Steady'; return p === 'Unhurried' ? 1.4 : p === 'Brisk' ? 0.7 : 1; }

  say(msg) {
    const v = this.props.coaching || 'Warm';
    if (v === 'Quiet') return;
    this.line = msg;
    this.lineTimer = v === 'Chatty' ? 3200 : 1800;
  }

  logVisit(id) {
    try {
      const raw = localStorage.getItem(SAVE_KEY);
      const data = raw ? JSON.parse(raw) : { sessions: [] };
      data.sessions = data.sessions || [];
      data.sessions.push({ d: Date.now(), p: id, att: 0, on: this.sparks, longest: this.caveBest, blow: 0, finished: false });
      if (data.sessions.length > 200) data.sessions = data.sessions.slice(-200);
      localStorage.setItem(SAVE_KEY, JSON.stringify(data));
    } catch (e) {}
  }

  resetRun() {
    this.sparks = 0; this.elapsed = 0; this.line = ''; this.lineTimer = 0;
    this.breaths = 0; this.longest = 0;
  }

  startStream() {
    this.resetRun();
    Bgm.start('stream');
    this.padIdx = 0; this.padScroll = 0; this.hopT = 999;
    this.zoneHold = 0; this.hoppedThisBreath = false;
    this.say(this.t().streamHint);
    this.setState({ screen: 'stream' });
  }

  startCave() {
    this.resetRun();
    Bgm.start('cave');
    this.caveScroll = 0; this.caveY = 50; this.caveStreak = 0; this.caveBest = 0; this.caveIn = false;
    this.caveRung = 0; this.caveWobble = false;
    this.caveObs = [this.makeObs(58), this.makeObs(92), this.makeObs(126), this.makeObs(160)];
    this.say(this.t().caveHint);
    this.setState({ screen: 'cave' });
  }

  startConversation() {
    this.resetRun();
    Bgm.start('conversation');
    /* These were fixed milliseconds — 200 to 640 — which asked for puffs
       about SEVEN times shorter than a child's natural breath. Every answer
       was judged too long, every time, forever.

       They are now fractions of the child's OWN comfortable breath: 0.4
       means "a breath a bit under half your usual". Odd entries are the
       silent gaps between pulses. */
    this.convSeq = [
      { pulses: [0.40, 0.30, 0.40], color: '#D4A5F5', hz: 440.00 },
      { pulses: [0.80, 0.30, 0.45], color: '#FFD4A3', hz: 523.25 },
      { pulses: [0.40, 0.25, 0.40, 0.25, 0.40], color: '#A5D4F5', hz: 392.00 },
      { pulses: [0.90, 0.30, 0.50], color: '#D4F5A5', hz: 329.63 }
    ];
    this.convIdx = 0; this.convPhase = 'show'; this.convPhaseTime = 0; this.convStep = 0;
    this.setState({ screen: 'conversation' });
  }

  startPond() { this.resetRun(); Bgm.start('pond'); this.gardenStage = -1; this.shownStage = -2; this.plotIdx = 0; this.plotCleared = false; this.growHold = 0; this.grewThisBreath = false; this.setState({ screen: 'pond' }); }

  leave() {
    Tone.stop(); Bgm.stop();
    const id = this.state.screen;
    if (id !== 'cards' && id !== 'pond') this.logVisit(id === 'conversation' ? 'clearing' : id);
    this.setState({ screen: 'cards' });
  }

  /* Reaching the end of a run is not the same as walking out of it, so it
     gets its own door: the run is logged, then held on screen. */
  finish() {
    Tone.stop(); Bgm.stop();
    Sfx.play('sparkle', 0.45);
    const id = this.state.screen;
    this.finishedPlace = id === 'conversation' ? 'clearing' : id;
    this.logVisit(this.finishedPlace);
    this.setState({ screen: 'result' });
  }

  /* Stars are earned against the exercise each place actually teaches,
     never against a generic score. Two of the four are measured against
     the child's own breath, so a small pair of lungs can still take three. */
  resultFor(id) {
    const T = this.t();
    const ds = this.durScale();
    let got, of, label, stars;
    if (id === 'stream') {
      got = this.sparks; of = 12;
      label = T.rPuffs;
      stars = got >= 11 ? 3 : got >= 7 ? 2 : got >= 3 ? 1 : 0;
    } else if (id === 'cave') {
      got = Math.round(this.caveBest / 100) / 10; of = 0;
      label = T.rSteady;
      const b = this.caveBest / ds;              // against their own breath
      stars = b >= 12000 ? 3 : b >= 7000 ? 2 : b >= 3000 ? 1 : 0;
    } else if (id === 'clearing') {
      got = this.convIdx; of = 4;
      label = T.rPatterns;
      stars = got >= 4 ? 3 : got >= 3 ? 2 : got >= 1 ? 1 : 0;
    } else {
      got = this.plotIdx; of = 5;
      label = T.rFlowers;
      stars = got >= 5 ? 3 : got >= 3 ? 2 : got >= 1 ? 1 : 0;
    }
    return { got: got, of: of, label: label, stars: stars };
  }

  retryPlace() { this.startWarmup(this.finishedPlace); }

  nextPlace() {
    const order = ['stream', 'cave', 'clearing', 'pond'];
    const i = order.indexOf(this.finishedPlace);
    if (i < 0 || i >= order.length - 1) { this.setState({ screen: 'cards' }); return; }
    this.startWarmup(order[i + 1]);
  }

  tickBreath(dt) {
    const b = this.breath;
    BreathIn.tick();
    // A real breath already HAS a magnitude, so the calibrated value goes
    // straight in — normal breath lands at NORMAL, mid-bar. The spacebar
    // has no magnitude of its own, so it fakes one by ramping: a quick tap
    // peaks low, a long hold peaks high. Both end up spanning the same
    // gentle .. normal .. firm range the games are written against.
    const ext = BreathIn.active();
    const keyT = (this.keyDown || this.pointerDown) ? 1 : 0;
    const target = ext ? Math.max(keyT * BreathIn.NORMAL, Math.min(1, BreathIn.norm())) : keyT;
    const k = ext ? 0.22 : (target ? 0.035 : 0.16);
    b.value += (target - b.value) * (1 - Math.pow(1 - k, dt / 16.67));
    if (b.value < 0.01) b.value = 0;
    const was = b.held;
    // "is a breath happening" — a fifth of a normal one, so a child who
    // breathes softly still registers, and sensor noise still does not.
    b.held = b.value > BreathIn.NORMAL * 0.12;
    if (b.held && !was) { b.peak = b.value; b.dur = dt; }
    else if (b.held) { b.peak = Math.max(b.peak, b.value); b.dur += dt; }
    if (!b.held && was) { const ev = { peak: b.peak, dur: b.dur }; b.peak = 0; b.dur = 0; return ev; }
    return null;
  }

  showLine(wrap, el) {
    if (el && el.current) el.current.textContent = this.line;
    if (wrap && wrap.current) wrap.current.style.opacity = this.line ? '1' : '0';
  }

  showJar(cnt, fill, max) {
    if (cnt && cnt.current) cnt.current.textContent = String(this.sparks);
    if (fill && fill.current) fill.current.style.height = Math.min(100, (this.sparks / max) * 100) + '%';
  }

  updateStream(dt, ev) {
    this.elapsed += dt;
    const total = 30000 * this.pace();
    if (this.progressRef.current) this.progressRef.current.style.width = Math.min(1, this.elapsed / total) * 100 + '%';

    if (this.gaugeRef.current) this.gaugeRef.current.style.width = Math.min(1, this.breath.value) * 100 + '%';

    const gap = padGap(this.padIdx);
    // A near pad wants a gentle puff, a far one a firm puff — 0.62x to
    // 1.55x of THIS child's normal breath, never a fixed sensor number.
    const N = this.N();
    const need = (0.62 + ((gap - 11) / 19) * 0.93) * N * this.effort();
    const tol = 0.34 * N * (this.props.breathEffort === 'Gentle' ? 1.3 : 1);
    const hopping = this.hopT < this.hopDur;
    const v = Math.min(1, this.breath.value);
    const inZone = v >= need - tol && v <= need + tol;
    const over = v > need + tol;

    /* The old rule was "the PEAK of your puff must land in the ring", judged
       only once you stopped blowing. Passing through the ring on the way up
       counted for nothing, and an overshoot was already lost before anything
       said so — you could do it right and still be told "softer".

       Now the ring is somewhere you ARRIVE and stay: hold inside it for a
       moment and the firefly goes, while you are still blowing. Cause and
       effect land together, which is the only way a child can learn it. */
    if (!hopping && this.breath.held && inZone) {
      this.zoneHold = (this.zoneHold || 0) + dt;
      if (this.zoneHold >= 160) { this.doHop(gap); this.zoneHold = 0; }
    } else if (!inZone || !this.breath.held) {
      this.zoneHold = 0;
    }

    // Live colour: white = aim here, green = you are in it, pink = too much.
    if (this.gaugeZoneRef.current) {
      const z = this.gaugeZoneRef.current;
      z.style.left = Math.max(0, (need - tol)) * 100 + '%';
      z.style.width = (tol * 2) * 100 + '%';
      z.style.opacity = hopping ? '.18' : '1';
      z.style.background = hopping ? 'rgba(255,255,255,.3)'
        : inZone ? 'rgba(165,234,118,.85)'
        : over ? 'rgba(242,169,196,.5)' : 'rgba(255,255,255,.3)';
    }
    // A marker parked at the highest point this puff reached, so an
    // overshoot is visible while there is still time to ease off.
    if (this.gaugePeakRef.current) {
      const pk = this.gaugePeakRef.current;
      const shown = this.breath.held ? Math.min(1, this.breath.peak) : 0;
      pk.style.opacity = this.breath.held && !hopping ? '1' : '0';
      pk.style.left = (shown * 100) + '%';
      pk.style.background = shown > need + tol ? '#F2A9C4' : '#fff';
    }
    if (this.gaugeRef.current) this.gaugeRef.current.style.opacity = hopping ? '.35' : '1';

    // Only coach on the way out, and only if the puff earned nothing.
    if (ev && !hopping) {
      if (this.hoppedThisBreath) {
        this.hoppedThisBreath = false;
      } else if (ev.peak >= need - tol && ev.peak <= need + tol) {
        /* Second chance. On the sensor you can park at a level and hold it,
           but the spacebar always climbs to full — so a key player only ever
           passes THROUGH the ring. Landing your peak in it still counts. */
        this.doHop(gap);
        this.hoppedThisBreath = false;
      } else if (ev.peak > need + tol) {
        this.say(this.t().tooMuch);
      } else {
        this.say(this.t().firmer);
      }
      this.zoneHold = 0;
    }

    if (this.hopT < this.hopDur) {
      this.hopT += dt;
      const p = Math.min(1, this.hopT / this.hopDur);
      const e = (1 - Math.cos(Math.PI * p)) / 2;
      this.padScroll = this.hopFrom + e * this.hopGap;
    } else {
      this.padScroll += (padPos(this.padIdx) - this.padScroll) * Math.min(1, dt / 400);
    }

    const lane = this.padLaneRef.current;
    if (lane) {
      for (let j = 0; j < lane.children.length; j++) {
        const L = this.padIdx - 1 + j;
        const el = lane.children[j];
        if (L < 0) { el.style.opacity = '0'; continue; }
        el.style.left = (26 + padPos(L) - this.padScroll) + '%';
        el.style.opacity = L < this.padIdx ? '.35' : '1';
      }
    }
    if (this.flyRef.current) {
      const base = 64;
      let y = base, x = 26;
      if (this.hopT < this.hopDur) {
        const p = Math.min(1, this.hopT / this.hopDur);
        const lift = Math.sin(Math.PI * p);
        y = base - (Math.pow(lift, 0.85) * (11 + this.hopGap * 0.42));
        x = 26 + Math.sin(Math.PI * p) * (2 + this.hopGap * 0.1);
      } else {
        y = base - this.breath.value * 4;
      }
      this.flyRef.current.style.top = y + '%';
      this.flyRef.current.style.left = x + '%';
    }

    this.showJar(this.jarCountRef, this.jarFillRef, 12);
    if (this.lineTimer > 0) { this.lineTimer -= dt; if (this.lineTimer <= 0) this.line = ''; }
    this.showLine(this.lineWrapRef, this.lineRef);

    if (this.elapsed > total) this.finish();
  }

  doHop(gap) {
    this.hopFrom = padPos(this.padIdx);
    this.hopGap = gap;
    this.hopDur = 620 + gap * 30;
    this.hopT = 0;
    this.padIdx++;
    this.sparks++;
    this.hoppedThisBreath = true;
    Sfx.play('pop', 0.4);
    this.say(this.t().good);
  }

  makeObs(x) {
    return { x: x, gapC: 32 + Math.random() * 36, gapH: 30 + Math.random() * 10, scored: false, clear: true };
  }

  updateCave(dt, ev) {
    this.elapsed += dt;
    const total = 45000 * this.pace();
    if (this.progressRef2.current) this.progressRef2.current.style.width = Math.min(1, this.elapsed / total) * 100 + '%';

    const speed = 17;
    this.caveScroll += (speed * dt) / 1000;
    if (this.caveBgRef.current) this.caveBgRef.current.style.backgroundPosition = (-this.caveScroll * 5.2) + 'px center';

    const flyX = 26;
    const bandTop = 42, bandH = 58, half = 9 * (this.props.breathEffort === 'Gentle' ? 1.35 : this.props.breathEffort === 'Strong' ? 0.8 : 1), pad = 3;
    const yLo = (bandTop + half - bandTop) / (bandH / 100);
    const yHi = (100 - pad - half - bandTop) / (bandH / 100);
    const flyTarget = yHi - Math.min(1, this.breath.value) * (yHi - yLo);
    this.caveY += (flyTarget - this.caveY) * Math.min(1, dt / 210);
    if (this.caveFlyRef.current) this.caveFlyRef.current.style.top = (42 + this.caveY * 0.58) + '%';

    let hit = false;
    for (const o of this.caveObs) {
      o.x -= (speed * dt) / 1000;
      if (o.x < -14) { const far = Math.max.apply(null, this.caveObs.map(q => q.x)); Object.assign(o, this.makeObs(far + 34)); }
      if (Math.abs(o.x - flyX) < 4.6 && Math.abs(this.caveY - o.gapC) > o.gapH / 2 - 4) { hit = true; o.clear = false; }
      if (!o.scored && o.x < flyX - 6) {
        o.scored = true;
        if (o.clear) {
          this.sparks++;
          // climbs a little with each gap cleared in a row, then resets
          Sfx.blip(CAVE_RUNGS[Math.min(CAVE_RUNGS.length - 1, this.sparks % 5)], 0.24);
        }
      }
    }

    const obs = this.caveObsRef.current;
    if (obs) {
      for (let i = 0; i < obs.children.length && i < this.caveObs.length; i++) {
        const o = this.caveObs[i];
        const el = obs.children[i];
        el.style.left = o.x + '%';
        const th = Math.max(0, o.gapC - o.gapH / 2) + '%';
        const bh = Math.max(0, 100 - (o.gapC + o.gapH / 2)) + '%';
        el.children[0].style.height = th;
        el.children[1].style.height = th;
        el.children[2].style.height = bh;
        el.children[3].style.height = bh;
      }
    }

    if (!hit) {
      this.caveStreak += dt;
      this.caveBest = Math.max(this.caveBest, this.caveStreak);
      if (!this.caveIn && this.caveStreak > 900 * this.durScale()) {
        this.caveIn = true;
        Sfx.blip(392.00, 0.20);            // settled into a steady breath
        this.say(this.t().hold);
      }
      /* Every few seconds of unbroken steadiness, a quiet note a step
         higher. Holding a breath is the whole exercise here and it had
         no sound at all — only the moment you stopped did. */
      const rung = Math.floor(this.caveStreak / (2500 * this.durScale()));
      if (rung > (this.caveRung || 0)) {
        this.caveRung = rung;
        Sfx.blip(CAVE_RUNGS[Math.min(CAVE_RUNGS.length - 1, rung - 1)], 0.17);
      }
      this.caveWobble = false;
    } else {
      if (this.caveIn || this.caveStreak > 600 * this.durScale()) { this.caveIn = false; this.say(this.t().drifting); }
      // A soft low note, once per touch — not a buzzer, and not repeated
      // every frame while the child is still against the wall.
      if (!this.caveWobble) { this.caveWobble = true; Sfx.blip(174.61, 0.16); }
      this.caveStreak = 0;
      this.caveRung = 0;
    }
    if (this.caveFlyRef.current) {
      this.caveFlyRef.current.style.filter = hit
        ? 'drop-shadow(0 0 3vh rgba(255,120,120,.75))'
        : 'drop-shadow(0 0 3vh rgba(255,214,130,.55))';
    }

    /* The Cave had no breath cue at all — the firefly moved, but nothing
       said how hard to blow to put it somewhere. This is a vertical gauge:
       your breath is the filled part, and the pale band is the height the
       NEXT gap wants. Line them up and you fly through it. */
    const next = this.caveObs
      .filter(o => o.x > flyX - 4)
      .sort((a, b) => a.x - b.x)[0];
    if (next && this.caveAimRef.current && this.caveLevelRef.current) {
      // invert the same mapping used for the firefly: y -> breath
      const toBreath = (y) => Math.max(0, Math.min(1, (yHi - y) / (yHi - yLo)));
      const lo = toBreath(next.gapC + next.gapH / 2);
      const hi = toBreath(next.gapC - next.gapH / 2);
      const aim = this.caveAimRef.current;
      aim.style.bottom = (Math.min(lo, hi) * 100) + '%';
      aim.style.height = (Math.abs(hi - lo) * 100) + '%';
      const v = Math.min(1, this.breath.value);
      const inGap = v >= Math.min(lo, hi) && v <= Math.max(lo, hi);
      aim.style.background = inGap ? 'rgba(165,234,118,.5)' : 'rgba(255,255,255,.22)';
      aim.style.borderColor = inGap ? 'rgba(165,234,118,.95)' : 'rgba(255,255,255,.6)';
      this.caveLevelRef.current.style.height = (v * 100) + '%';
      this.caveLevelRef.current.style.background = hit
        ? 'linear-gradient(180deg,#F2A9C4,#E9349B)'
        : inGap ? 'linear-gradient(180deg,#A5EA76,#56B92A)'
        : 'linear-gradient(180deg,#7FDDF7,#12A5E0)';
    }

    if (this.caveBarRef.current) this.caveBarRef.current.style.width = Math.min(1, this.elapsed / total) * 100 + '%';
    if (this.caveStreakRef.current) {
      const w = Math.min(30, (this.caveStreak / (8000 * this.durScale())) * 30);
      const l = Math.max(0, Math.min(1, this.elapsed / total) * 100 - w);
      this.caveStreakRef.current.style.left = l + '%';
      this.caveStreakRef.current.style.width = w + '%';
    }

    this.showJar(this.jarCount2Ref, this.jarFill2Ref, 20);
    if (this.lineTimer > 0) { this.lineTimer -= dt; if (this.lineTimer <= 0) this.line = ''; }
    this.showLine(this.lineWrap2Ref, this.line2Ref);

    if (this.elapsed > total) this.finish();
  }

  // One comfortable breath, in ms. Everything in Conversation is a
  // fraction of this, so the exercise fits whoever is holding the flute.
  breathMs() {
    const c = BreathIn.cal;
    return c.ready ? Math.max(700, Math.min(6000, c.dur)) : 2200;
  }

  updateConversation(dt, ev) {
    this.elapsed += dt;
    const total = 60000 * this.pace();
    if (this.progressRef3.current) this.progressRef3.current.style.width = Math.min(1, this.elapsed / total) * 100 + '%';

    const pat = this.convSeq[this.convIdx];
    if (!pat) { Tone.stop(); this.finish(); return; }
    this.convPhaseTime += dt;

    if (this.convPhase === 'show') {
      let acc = 0, lit = false, done = true;
      for (let i = 0; i < pat.pulses.length; i++) {
        const d = pat.pulses[i] * this.breathMs();   // show it at the child's own size
        if (this.convPhaseTime < acc + d) { lit = (i % 2 === 0); done = false; break; }
        acc += d;
      }
      if (this.convGlowRef.current) {
        this.convGlowRef.current.style.background = pat.color;
        this.convGlowRef.current.style.boxShadow = '0 0 4vh 1vh ' + pat.color;
        this.convGlowRef.current.style.opacity = lit ? '1' : '0';
      }
      // light and sound together, so the beep IS the thing to copy
      if (lit) Tone.play(pat.hz, 1); else Tone.stop();
      if (done && this.convPhaseTime > acc + 500) {
        this.convPhase = 'answer'; this.convPhaseTime = 0; this.convStep = 0;
        this.say(this.t().yourTurn);
      } else if (this.convPhaseTime < 60) {
        this.say(this.t().watch);
      }
    } else {
      if (this.convGlowRef.current) this.convGlowRef.current.style.opacity = '0';
      const wantIdx = this.convStep * 2;
      // The written pattern assumes a 2.2s comfortable breath. A child
      // whose breath runs shorter gets proportionally shorter pulses to
      // answer, so the exercise stays the same shape at their own size.
      const want = pat.pulses[wantIdx] != null ? pat.pulses[wantIdx] * this.breathMs() : null;

      /* Live cue while the breath is happening: a bar that fills as you
         hold, with the target marked on it. Before, nothing moved until
         you stopped, so there was no way to aim. */
      /* Their breath plays the pattern's note straight back, louder the
         harder they blow. Call and response in the same voice. */
      if (this.breath.held) Tone.play(pat.hz, this.breath.value * 2); else Tone.stop();

      if (this.convHoldRef.current && want != null) {
        const held = this.breath.held ? this.breath.dur : 0;
        const frac = Math.min(1.35, held / want);
        const bar = this.convHoldRef.current;
        bar.style.width = Math.min(100, frac * 74) + '%';
        bar.style.background = frac > 1.2 ? '#F2A9C4' : frac > 0.72 ? '#A5EA76' : '#FFD4A3';
      }
      if (this.convTargetRef.current) this.convTargetRef.current.style.left = '74%';

      if (ev && want != null) {
        // Generous: a child cannot time a breath finely, and this is
        // about copying a rhythm, not hitting a stopwatch.
        const ok = Math.abs(ev.dur - want) < Math.max(300, want * 0.6);
        if (ok) {
          this.convStep++;
          this.sparks++;
          if (this.convStep * 2 >= pat.pulses.length) {
            Sfx.play('chime', 0.4);
            this.say(this.t().lovely);
            this.convIdx++; this.convPhase = 'show'; this.convPhaseTime = 0; this.convStep = 0;
          } else {
            // A ping cut across the fireflies' own voice. Answer them in it
            // instead: the same note, a fifth up, brief and soft.
            Sfx.blip(pat.hz * 1.5, 0.42);
            this.say(this.t().goodNow);
          }
        } else {
          // These are about LENGTH. Saying "softer" here — which is about
          // how hard you blow — was simply the wrong word for the mistake.
          this.say(ev.dur > want ? this.t().shorter : this.t().longer);
          this.convStep = 0;
        }
      }
      if (this.convPhaseTime > 12000) { this.convPhase = 'show'; this.convPhaseTime = 0; this.convStep = 0; }
    }

    if (this.convBreathRef.current) {
      this.convBreathRef.current.style.background = pat.color;
      this.convBreathRef.current.style.opacity = this.breath.value > this.N() * 0.16 ? String(0.35 + this.breath.value * 0.6) : '0';
    }
    const seq = this.convSeqRef.current;
    if (seq) {
      for (let i = 0; i < seq.children.length; i++) {
        seq.children[i].style.opacity = i < this.convIdx ? '1' : (i === this.convIdx ? '.7' : '.25');
      }
    }

    // How many pulses this pattern has, and which one you are answering.
    const steps = Math.ceil(pat.pulses.length / 2);
    const answering = this.convPhase === 'answer';
    if (this.convStepRef.current) {
      this.convStepRef.current.textContent = answering
        ? (Math.min(this.convStep + 1, steps) + ' / ' + steps) : '';
    }
    const dots = this.convDotsRef.current;
    if (dots) {
      for (let i = 0; i < dots.children.length; i++) {
        const el = dots.children[i];
        const used = i < steps;
        el.style.display = used ? 'block' : 'none';
        if (!used) continue;
        // long pulses are drawn wider, so the shape of the answer is visible
        el.style.width = (1.1 + (pat.pulses[i * 2] || 0.4) * 4.2) + 'vh';
        el.style.background = !answering ? 'rgba(255,255,255,.45)'
          : i < this.convStep ? '#A5EA76'
          : i === this.convStep ? '#FFD4A3' : 'rgba(255,255,255,.3)';
      }
    }
    if (this.convHoldWrapRef.current) {
      this.convHoldWrapRef.current.style.opacity = answering ? '1' : '0';
    }

    this.showJar(this.jarCount3Ref, this.jarFill3Ref, 14);
    if (this.lineTimer > 0) { this.lineTimer -= dt; if (this.lineTimer <= 0) this.line = ''; }
    this.showLine(this.lineWrap3Ref, this.line3Ref);

    if (this.elapsed > total) this.finish();
  }

  spriteFor(stage, plot) {
    const V = ['pink', 'yellow', 'orange', 'purple', 'pink'];
    if (stage < 2) return 'assets/flower-' + (stage + 1) + '.png';
    return 'assets/flower-' + V[plot % V.length] + '-' + (stage + 1) + '.png';
  }

  updatePond(dt, ev) {
    const SPOTS = [[24, 20], [38, 25], [50, 29], [62, 25], [76, 20]];
    const v = Math.min(1, this.breath.value);
    const E = this.effort();
    // All five stages sit inside ONE ordinary breath (0.35x .. 1.15x of
    // normal), because this game is meant to reward breathing LONGER,
    // not blowing harder. The holding is what does the work.
    const N = this.N();
    const STEPS = [0.35, 0.55, 0.75, 0.95, 1.15].map(m => Math.min(0.97, m * N * E));
    let seg = 0;
    for (let i = 0; i < STEPS.length; i++) if (v >= STEPS[i]) seg = i + 1;
    const full = this.plotIdx >= SPOTS.length;
    const target = full ? -1 : seg - 1;
    if (target > this.gardenStage) {
      this.growHold = (this.growHold || 0) + dt;
      if (this.growHold >= this.growHoldMs()) {
        this.gardenStage++; this.growHold = 0; this.grewThisBreath = true;
        /* This used to be silent until the breath ENDED, so all five steps
           went by with nothing and one sound arrived late. Now each step
           speaks as it happens, and climbs the scale as the flower does. */
        Sfx.blip(GROW_NOTES[Math.min(GROW_NOTES.length - 1, Math.max(0, this.gardenStage))], 0.5);
      }
    } else this.growHold = 0;
    const stage = this.gardenStage;

    if (!this.plotCleared && this.plotRef.current) {
      this.plotCleared = true;
      this.plotRef.current.querySelectorAll('img').forEach(im => { im.style.opacity = '0'; im.src = 'assets/flower-1.png'; });
    }
    if (this.pondOrbRef.current) {
      const sp = SPOTS[Math.min(SPOTS.length - 1, this.plotIdx)];
      this.pondOrbRef.current.style.left = sp[0] + '%';
      this.pondOrbRef.current.style.bottom = sp[1] + '%';
      this.pondOrbRef.current.style.transform = 'translate(-50%,30%) scale(' + (1 + v * 0.5).toFixed(3) + ')';
      this.pondOrbRef.current.style.opacity = this.plotIdx >= SPOTS.length ? '0' : '1';
    }
    /* The bar used to run 0..1 while every step sat below 0.6, so all the
       action happened in the left third and the ticks at 20/40/60/80%
       lined up with nothing. Scale the bar to the top step instead. */
    const SPAN = Math.max(0.2, STEPS[STEPS.length - 1] * 1.15);
    const shown = Math.min(1, v / SPAN);
    const ticks = this.stepTicksRef.current;
    if (ticks) {
      for (let i = 0; i < ticks.children.length && i < STEPS.length; i++) {
        ticks.children[i].style.left = (Math.min(1, STEPS[i] / SPAN) * 100) + '%';
      }
    }
    if (this.gardenFillRef.current) {
      this.gardenFillRef.current.style.width = (full ? 0 : shown * 100).toFixed(1) + '%';
      // green once you are above the next step, so "keep going" is visible
      this.gardenFillRef.current.style.background = (target > this.gardenStage)
        ? 'linear-gradient(180deg,#A5EA76,#56B92A)'
        : 'linear-gradient(180deg,#FFD75E,#F0A62A)';
    }

    /* The Garden rewards HOLDING, but nothing showed the holding — the
       flower simply grew, or silently did not. This is the hold filling
       up: reach a step, keep the breath there, and watch it complete. */
    if (this.holdRingRef.current) {
      const need = this.growHoldMs();
      const p = target > this.gardenStage ? Math.min(1, (this.growHold || 0) / need) : 0;
      this.holdRingRef.current.style.opacity = p > 0 ? '1' : '0';
      this.holdRingRef.current.style.width = (p * 100) + '%';
    }
    if (this.nextStepRef.current) {
      // where the next stage sits on the bar, so there is something to aim at
      const nxt = STEPS[Math.min(STEPS.length - 1, Math.max(0, this.gardenStage + 1))];
      this.nextStepRef.current.style.opacity = full ? '0' : '1';
      this.nextStepRef.current.style.left = (Math.min(1, nxt / SPAN) * 100) + '%';
    }
    if (this.stageMarkRef.current) {
      const on = !full && this.gardenStage >= 0;
      this.stageMarkRef.current.style.opacity = on ? '1' : '0';
      const done = STEPS[Math.min(STEPS.length - 1, this.gardenStage)];
      this.stageMarkRef.current.style.left = on ? (Math.min(1, done / SPAN) * 100) + '%' : '0%';
    }
    if (this.plotTextRef.current) {
      this.plotTextRef.current.textContent = Math.min(SPOTS.length, this.plotIdx) + '/' + SPOTS.length;
    }
    if (stage !== this.shownStage) {
      this.shownStage = stage;
      const plot = this.plotRef.current;
      const el = plot ? plot.querySelectorAll('img')[this.plotIdx] : null;
      if (el) {
        el.style.opacity = stage < 0 ? '0' : '1';
        if (stage >= 0) {
          el.src = this.spriteFor(stage, this.plotIdx);
          el.style.transform = 'translateX(-50%) scale(1.12)';
          setTimeout(() => { if (el) el.style.transform = 'translateX(-50%) scale(1)'; }, 300);
        }
      }
    }
    if (ev) {
      if (full) {
        // Last flower is done — end the run so the summary can appear.
        // This used to just say "lovely" and loop forever, so the Garden
        // was the one place you could never actually finish.
        this.finish(); return;
      } else if (this.grewThisBreath) {
        this.sparks++;
        if (this.gardenStage === 4) Sfx.play('chime', 0.4);
        this.say(this.gardenStage === 4 ? this.t().bloomed : this.t().grew);
        if (this.gardenStage === 4) {
          this.plotIdx++;
          this.gardenStage = -1;
          this.shownStage = -2;
        }
      } else {
        this.say(this.t().keepGoing);
      }
      this.grewThisBreath = false;
      this.growHold = 0;
    }
    if (this.lineTimer > 0) { this.lineTimer -= dt; if (this.lineTimer <= 0) this.line = ''; }
    this.showLine(this.lineWrap4Ref, this.line4Ref);
  }

  /* ---- the connect panel ------------------------------------------ */
  openConnect() { this.setState({ screen: 'connect' }); }

  async pickSource(src) {
    const r = await BreathIn.use(src);
    // Only move on if it worked; a failed connect must stay put and say why.
    if (r.ok) this.setState({ screen: 'cards' });
    else this.forceUpdate();
  }

  updateConnect(dt) {
    const v = Math.min(1, BreathIn.active() ? BreathIn.norm() : this.breath.value);
    if (this.cbBarRef.current) this.cbBarRef.current.style.width = (v * 100) + '%';
    if (this.cbValRef.current) this.cbValRef.current.textContent = (BreathIn.active() ? BreathIn.raw : this.breath.value).toFixed(3);
    if (this.cbNormRef.current) {
      // What the games actually receive. Normal breath should read ~0.50.
      this.cbNormRef.current.textContent = v.toFixed(2);
      this.cbNormRef.current.style.color = !BreathIn.active() ? '#8C97AB'
        : (v > 0.92 || v < 0.08) ? '#F2A9C4' : (v > 0.30 && v < 0.72) ? '#A5EA76' : '#F6C96B';
    }
    if (this.cbNoteRef.current) {
      const n = BreathIn.note;
      this.cbNoteRef.current.textContent = n ? (n.n + ' \u00b7 ' + n.holes + (n.holes === 1 ? ' finger' : ' fingers')) : '\u2014';
    }
  }

  /* ---- the warm-up: measuring THIS child's normal breath -----------
     Runs before every game, because the number it produces is what all
     four games are scaled against. Three steps: sit still so the sensor's
     own resting level can be read, then two ordinary breaths, then read
     the recording back. Two breaths rather than one because the first is
     usually a giggle or a half-try, and averaging survives that.
     ------------------------------------------------------------------ */
  WARM_REST_MS = 2000;
  WARM_BLOW_MS = 9000;

  startWarmup(placeId) {
    this.pendingPlace = placeId;
    // No sensor on the table: the spacebar has no personal baseline to
    // measure, so there is nothing to warm up.
    if (!BreathIn.active()) { this.launch(placeId); return; }
    this.warmStage = 0;
    this.warmT = this.WARM_REST_MS;
    this.warmRest = 0;
    this.warmResult = null;
    this.warmFailed = false;
    BreathIn.startCapture();
    this.setState({ screen: 'warmup' });
  }

  updateWarmup(dt) {
    if (this.warmStage === 2) return;
    this.warmT -= dt;
    BreathIn.pushCapture(dt);

    if (this.warmStage === 0) {
      if (this.warmBarRef.current) this.warmBarRef.current.style.width = (100 * (1 - this.warmT / this.WARM_REST_MS)) + '%';
      if (this.warmT <= 0) {
        this.warmRest = BreathIn.restFromCapture();
        this.warmStage = 1;
        this.warmT = this.WARM_BLOW_MS;
        BreathIn.startCapture();          // fresh window for the breaths
        this.forceUpdate();
      }
      return;
    }

    // Stage 1: recording two ordinary breaths.
    if (this.warmBarRef.current) this.warmBarRef.current.style.width = (100 * (1 - this.warmT / this.WARM_BLOW_MS)) + '%';
    const live = Math.max(0, BreathIn.raw - this.warmRest);
    if (this.warmLiveRef.current) {
      // Shown against the biggest breath so far, so the child sees
      // something move immediately — this bar is encouragement, not a score.
      this.warmSeen = Math.max(this.warmSeen || 0.03, live);
      this.warmLiveRef.current.style.width = Math.min(100, (live / this.warmSeen) * 100) + '%';
    }

    // Stop as soon as two clean breaths are in the bag.
    const early = this.warmT < this.WARM_BLOW_MS - 3000 ? BreathIn.analyseCapture(this.warmRest) : null;
    if ((early && early.breaths >= 2) || this.warmT <= 0) {
      const res = early && early.breaths >= 2 ? early : BreathIn.analyseCapture(this.warmRest);
      if (res) { BreathIn.commitCal(this.warmRest, res); this.warmResult = res; this.warmFailed = false; }
      else { this.warmFailed = true; }
      this.warmStage = 2;
      this.forceUpdate();
    }
  }

  retryWarmup() {
    this.warmStage = 1;
    this.warmT = this.WARM_BLOW_MS;
    this.warmSeen = 0;
    this.warmFailed = false;
    BreathIn.startCapture();
    this.forceUpdate();
  }

  // Skip straight in on the profile recorded last time.
  useSavedCal() { this.launch(this.pendingPlace); }

  launch(placeId) {
    if (placeId === 'stream') this.startStream();
    else if (placeId === 'cave') this.startCave();
    else if (placeId === 'clearing') this.startConversation();
    else this.startPond();
  }

  /* ---- turning the measured breath into game numbers ---------------
     N is where a normal breath sits on the bar. Every threshold in the
     four games is written as a multiple of it, so "a bit firmer than
     usual" means the same thing for a small child and a grown-up.
     ------------------------------------------------------------------ */
  N() { return BreathIn.NORMAL; }

  // Time-based games stretch to however long this person's breath runs.
  durScale() { return BreathIn.durScale(); }

  // The Garden: five stages should fit comfortably inside ONE breath,
  // so the hold per stage comes from the breath we measured.
  growHoldMs() {
    const c = BreathIn.cal;
    const base = c.ready ? (c.dur / 5) * 0.62 : 380;
    return Math.max(240, Math.min(700, base)) * this.pace();
  }

  frame = (now) => {
    try {
      if (!(this.last > 0)) this.last = now;
      let dt = Math.min(48, now - this.last);
      if (!(dt >= 0)) dt = 16;
      this.last = now;
      const ev = this.tickBreath(dt);
      // Every finished breath counts, whatever the game does with it.
      if (ev && this.state.screen !== 'warmup' && this.state.screen !== 'connect') {
        this.breaths++;
        if (ev.dur > this.longest) this.longest = ev.dur;
      }
      Bgm.tick(dt);
      const s = this.state.screen;
      if (s === 'connect') this.updateConnect(dt);
      else if (s === 'warmup') this.updateWarmup(dt);
      else if (s === 'stream') this.updateStream(dt, ev);
      else if (s === 'cave') this.updateCave(dt, ev);
      else if (s === 'conversation') this.updateConversation(dt, ev);
      else if (s === 'pond') this.updatePond(dt, ev);
    } catch (err) {
      if (!this.loggedFrameErr) { this.loggedFrameErr = true; console.error('frame error', err); }
    }
    this.raf = requestAnimationFrame(this.frame);
  }

  ensureLoop() {
    if (this.loopOn) return;
    this.loopOn = true;
    if (!this.onKeyDown) {
      this.onKeyDown = (e) => { if (e.code === 'Space') { e.preventDefault(); this.keyDown = true; } };
      this.onKeyUp = (e) => { if (e.code === 'Space') this.keyDown = false; };
      this.onPointerDown = (e) => { if (!e.target.closest('button, a')) this.pointerDown = true; };
      this.onPointerUp = () => { this.pointerDown = false; };
      window.addEventListener('keydown', this.onKeyDown);
      window.addEventListener('keyup', this.onKeyUp);
      window.addEventListener('pointerdown', this.onPointerDown);
      window.addEventListener('pointerup', this.onPointerUp);
    }
    this.last = performance.now();
    this.raf = requestAnimationFrame(this.frame);
  }

  renderVals() {
    this.ensureLoop();
    const t = this.t();
    const s = this.state.screen;
    return {
      t: t,
      langLabel: this.state.lang === 'en' ? 'EN / हि' : 'हि / EN',
      toggleLang: () => this.setState({ lang: this.state.lang === 'en' ? 'hi' : 'en' }),
      isCards: s === 'cards',
      soundOn: this.state.sound,
      soundOff: !this.state.sound,
      toggleSound: () => {
        const on = !this.state.sound;
        Tone.setMuted(!on);
        if (!on) Bgm.stop();
        else if (Bgm.tracks[this.state.screen]) Bgm.start(this.state.screen);
        this.setState({ sound: on });
      },
      isConnect: s === 'connect',
      isWarmup: s === 'warmup',
      isResult: s === 'result',
      openConnect: () => this.openConnect(),
      closeConnect: () => this.setState({ screen: 'cards' }),
      pickKey: () => this.pickSource('key'),
      pickSerial: () => this.pickSource('serial'),
      reZero: () => BreathIn.reZero(),
      srcIsSerial: BreathIn.src === 'serial',
      hasSerialSensor: BreathIn.active(),
      statusText: BreathIn.active() ? t.stSerial : (BreathIn.src === 'key' ? t.stKey : t.stOff),
      dotColor: BreathIn.active() ? '#A5EA76' : (BreathIn.src === 'key' ? '#F6C96B' : '#F2A9C4'),
      serialBorder: BreathIn.active() ? '#A5EA76' : 'rgba(255,255,255,.2)',
      keyBorder: BreathIn.src === 'key' && !BreathIn.active() ? '#F6C96B' : 'rgba(255,255,255,.2)',
      breathNote: BreathIn.why === 'needBrowser' ? t.errBrowser
                : BreathIn.why === 'noPort' ? t.errPort
                : BreathIn.why === 'unplugged' ? t.errUnplug
                : '',

      // --- the warm-up ---
      warmResting: this.warmStage === 0,
      warmBlowing: this.warmStage === 1,
      warmDone: this.warmStage === 2,
      warmOk: this.warmStage === 2 && !this.warmFailed,
      warmBad: this.warmStage === 2 && this.warmFailed,
      warmTitle: this.warmStage === 0 ? t.warmRest : this.warmStage === 1 ? t.warmBlow : (this.warmFailed ? t.warmNothing : t.warmGot),
      warmSub: this.warmStage === 0 ? t.warmRestSub : this.warmStage === 1 ? t.warmBlowSub : (this.warmFailed ? t.warmNothingSub : t.warmGotSub),
      warmBreaths: this.warmResult ? String(this.warmResult.breaths) : '0',
      warmLen: this.warmResult ? (this.warmResult.dur / 1000).toFixed(1) + 's' : '\u2014',
      warmStrength: this.warmResult ? (this.warmResult.amp - this.warmRest).toFixed(3) : '\u2014',
      goPlay: () => this.launch(this.pendingPlace),
      retryWarm: () => this.retryWarmup(),
      cancelWarm: () => this.setState({ screen: 'cards' }),
      hasSavedCal: BreathIn.cal.ready,
      useSaved: () => this.useSavedCal(),
      warmBarRef: this.warmBarRef, warmLiveRef: this.warmLiveRef,

      // --- the results screen ---
      res: (() => {
        const id = this.finishedPlace || 'stream';
        const r = this.resultFor(id);
        const P = PLACES.find(x => x.id === id) || PLACES[0];
        const order = ['stream', 'cave', 'clearing', 'pond'];
        const last = order.indexOf(id) >= order.length - 1;
        return {
          name: t.names[id],
          accent: P.accent, chip: P.chip, art: P.art,
          stars: r.stars,
          star1: r.stars >= 1, star2: r.stars >= 2, star3: r.stars >= 3,
          noStar1: r.stars < 1, noStar2: r.stars < 2, noStar3: r.stars < 3,
          title: r.stars >= 3 ? t.rGreat : r.stars >= 2 ? t.rGood : r.stars >= 1 ? t.rNice : t.rTried,
          sub: r.stars >= 2 ? t.rSubHigh : t.rSubLow,
          scoreLabel: r.label,
          score: id === 'cave' ? r.got + 's' : (r.of ? r.got + '/' + r.of : String(r.got)),
          breaths: String(this.breaths),
          longest: (this.longest / 1000).toFixed(1) + 's',
          sparks: String(this.sparks),
          isLast: last, notLast: !last
        };
      })(),
      retryPlace: () => this.retryPlace(),
      nextPlace: () => this.nextPlace(),
      resultToCards: () => this.setState({ screen: 'cards' }),

      // --- what the profile currently says (shown in the panel) ---
      calReady: BreathIn.cal.ready,
      calNotReady: !BreathIn.cal.ready,
      calLen: BreathIn.cal.ready ? (BreathIn.cal.dur / 1000).toFixed(1) + 's' : '\u2014',
      calStrength: BreathIn.cal.ready ? (BreathIn.cal.amp - BreathIn.cal.rest).toFixed(3) : '\u2014',
      calRest: BreathIn.cal.ready ? BreathIn.cal.rest.toFixed(3) : '\u2014',

      cbBarRef: this.cbBarRef, cbValRef: this.cbValRef,
      cbNoteRef: this.cbNoteRef, cbNormRef: this.cbNormRef,
      isStream: s === 'stream',
      isCave: s === 'cave',
      isConversation: s === 'conversation',
      isPond: s === 'pond',
      places: PLACES.map(p => ({
        index: p.index, accent: p.accent, wash: p.wash, chip: p.chip, art: p.art, pos: p.pos,
        name: t.names[p.id], teach: t.teach[p.id], dur: t.durs[p.id],
        play: () => this.startWarmup(p.id)
      })),
      pads: [0, 1, 2, 3, 4, 5, 6, 7, 8],
      convPatterns: (this.convSeq.length ? this.convSeq : [{ color: '#D4A5F5' }, { color: '#FFD4A3' }, { color: '#A5D4F5' }, { color: '#D4F5A5' }]).map(p => ({ color: p.color })),
      progressRef: this.progressRef, progressRef2: this.progressRef2, progressRef3: this.progressRef3,
      padLaneRef: this.padLaneRef, flyRef: this.flyRef, gaugeRef: this.gaugeRef,
      gaugeZoneRef: this.gaugeZoneRef, gaugePeakRef: this.gaugePeakRef,
      jarCountRef: this.jarCountRef, jarFillRef: this.jarFillRef, jarWrapRef: this.jarWrapRef,
      lineRef: this.lineRef, lineWrapRef: this.lineWrapRef,
      caveBgRef: this.caveBgRef, caveObsRef: this.caveObsRef, caveFlyRef: this.caveFlyRef,
      caveObstacles: [0, 1, 2, 3],
      caveBarRef: this.caveBarRef, caveStreakRef: this.caveStreakRef,
      caveAimRef: this.caveAimRef, caveLevelRef: this.caveLevelRef,
      jarCount2Ref: this.jarCount2Ref, jarFill2Ref: this.jarFill2Ref, jarWrap2Ref: this.jarWrap2Ref,
      line2Ref: this.line2Ref, lineWrap2Ref: this.lineWrap2Ref,
      convGlowRef: this.convGlowRef, convBreathRef: this.convBreathRef, convSeqRef: this.convSeqRef, convFlyRef: this.convFlyRef,
      convDotsRef: this.convDotsRef, convStepRef: this.convStepRef,
      convHoldRef: this.convHoldRef, convHoldWrapRef: this.convHoldWrapRef, convTargetRef: this.convTargetRef,
      convDots: [0, 1, 2, 3, 4],
      jarCount3Ref: this.jarCount3Ref, jarFill3Ref: this.jarFill3Ref,
      line3Ref: this.line3Ref, lineWrap3Ref: this.lineWrap3Ref,
      pondOrbRef: this.pondOrbRef,
      plotRef: this.plotRef,
      gardenFillRef: this.gardenFillRef, stageMarkRef: this.stageMarkRef, plotTextRef: this.plotTextRef,
      holdRingRef: this.holdRingRef, nextStepRef: this.nextStepRef, stepTicksRef: this.stepTicksRef,
      line4Ref: this.line4Ref, lineWrap4Ref: this.lineWrap4Ref,
      leaveGame: () => this.leave()
    };
  }
}
</script>
</body>
</html>
