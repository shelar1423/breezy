    letsPlay: 'KHELEIN', againBreath: 'PHIR SE SAANS', useLast: 'PICHHLI BAAR WALI',
    connectNow: 'JODEIN', skipConnect: 'ISKE BINA KHELEIN',
    rGreat: 'Sundar saans!', rGood: 'Bahut achha kiya.', rNice: 'Achha kaam.', rTried: 'Achhi koshish!',
