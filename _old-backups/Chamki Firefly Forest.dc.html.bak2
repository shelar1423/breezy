        <div style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:1.35vh;letter-spacing:.12em;color:#fff;text-shadow:0 .25vh 0 rgba(0,0,0,.32)">{{ t.sparks }}</div>
        <div ref="{{ jarCount3Ref }}" style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:3.6vh;line-height:1;color:#fff;text-shadow:0 .3vh 0 rgba(0,0,0,.32)">0</div>
      </div>
      <div style="position:relative;width:6.4vh;height:10vh;filter:drop-shadow(0 .4vh .8vh rgba(0,0,0,.24))">
        <div style="position:absolute;left:1.6vh;right:1.6vh;top:0;height:1.4vh;border-radius:99px;border:.35vh solid #fff;background:linear-gradient(180deg,#FFD75E,#F0A62A)"></div>
        <div style="position:absolute;left:0;right:0;top:1.3vh;bottom:0;border:.4vh solid #fff;border-radius:1vh 1vh 2.4vh 2.4vh;overflow:hidden;background:#2E1B60">
          <div ref="{{ jarFill3Ref }}" style="position:absolute;left:0;right:0;bottom:0;height:0%;background:linear-gradient(180deg,#FFD75E,#F0A62A);transition:height .4s cubic-bezier(.2,1,.3,1)"></div>
        </div>
      </div>
    </div>

    <div ref="{{ lineWrap3Ref }}" style="position:absolute;left:50%;bottom:calc(26% - 20px);z-index:3;transform:translateX(-50%);max-width:64%;padding:1.2vh 2.4vh;background:#fff;border-radius:1.8vh;box-shadow:0 .5vh 1vh rgba(9,32,48,.28);opacity:0;transition:opacity .28s ease">
      <div ref="{{ line3Ref }}" style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:700;font-size:1.9vh;color:#3A2E66"></div>
    </div>
  </sc-if>

  <sc-if value="{{ isPond }}" hint-placeholder-val="{{ false }}">
    <div style="position:absolute;inset:0;background-size:cover;background-position:center;background-image:url(assets/scene-garden.png)"></div>
    <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(14,9,22,.34) 0%,rgba(14,9,22,.04) 28%,rgba(14,9,22,0) 62%,rgba(14,9,22,.3) 100%)"></div>

    <button onClick="{{ leaveGame }}" style="position:absolute;left:2.6vh;top:2.6vh;z-index:11;display:flex;align-items:center;gap:.9vh;height:5.4vh;padding:0 2vh 0 1.4vh;border-radius:1.4vh;border:.4vh solid #fff;background:linear-gradient(180deg,#FFD75E 0%,#F0A62A 100%);box-shadow:inset 0 -.5vh 0 rgba(0,0,0,.16),0 .3vh .6vh rgba(0,0,0,.24);color:#fff;font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:1.6vh;letter-spacing:.1em;cursor:pointer;transition:transform .16s cubic-bezier(.22,.7,.3,1),box-shadow .16s ease,filter .16s ease" style-hover="filter:brightness(1.05)" style-active="transform:translateY(2px)"><svg width="2.4vh" height="2.4vh" viewBox="0 0 24 24"><path fill="currentColor" d="M11.3 5.3L4.6 12l6.7 6.7 2-2L9.4 13H20v-2H9.4l3.9-3.7z"></path></svg>{{ t.back }}</button>

    <div ref="{{ plotRef }}" style="position:absolute;inset:0;pointer-events:none">
      <div ref="{{ pondOrbRef }}" style="position:absolute;left:24%;bottom:20%;width:13vh;height:13vh;border-radius:50%;transform:translate(-50%,30%);background:radial-gradient(circle,rgba(255,233,190,.5) 0%,rgba(246,201,107,.12) 55%,rgba(0,0,0,0) 74%);transition:left .5s ease,bottom .5s ease;pointer-events:none"></div>
      <img src="assets/flower-1.png" alt="Flower" style="position:absolute;left:24%;bottom:20%;transform:translateX(-50%);width:11vh;height:18.7vh;object-fit:contain;object-position:bottom;opacity:0;transition:opacity .3s ease,transform .45s cubic-bezier(.2,1,.3,1);transform-origin:50% 100%;filter:drop-shadow(0 .8vh 1.4vh rgba(11,7,17,.26))" />
      <img src="assets/flower-1.png" alt="Flower" style="position:absolute;left:38%;bottom:25%;transform:translateX(-50%);width:9.5vh;height:16.1vh;object-fit:contain;object-position:bottom;opacity:0;transition:opacity .3s ease,transform .45s cubic-bezier(.2,1,.3,1);transform-origin:50% 100%;filter:drop-shadow(0 .8vh 1.4vh rgba(11,7,17,.26))" />
      <img src="assets/flower-1.png" alt="Flower" style="position:absolute;left:50%;bottom:29%;transform:translateX(-50%);width:8.5vh;height:14.4vh;object-fit:contain;object-position:bottom;opacity:0;transition:opacity .3s ease,transform .45s cubic-bezier(.2,1,.3,1);transform-origin:50% 100%;filter:drop-shadow(0 .8vh 1.4vh rgba(11,7,17,.26))" />
      <img src="assets/flower-1.png" alt="Flower" style="position:absolute;left:62%;bottom:25%;transform:translateX(-50%);width:9.5vh;height:16.1vh;object-fit:contain;object-position:bottom;opacity:0;transition:opacity .3s ease,transform .45s cubic-bezier(.2,1,.3,1);transform-origin:50% 100%;filter:drop-shadow(0 .8vh 1.4vh rgba(11,7,17,.26))" />
      <img src="assets/flower-1.png" alt="Flower" style="position:absolute;left:76%;bottom:20%;transform:translateX(-50%);width:11vh;height:18.7vh;object-fit:contain;object-position:bottom;opacity:0;transition:opacity .3s ease,transform .45s cubic-bezier(.2,1,.3,1);transform-origin:50% 100%;filter:drop-shadow(0 .8vh 1.4vh rgba(11,7,17,.26))" />
    </div>

    <div style="position:absolute;left:2.6vh;top:8.5vh;display:flex;align-items:center;gap:1.4vh;padding:1.2vh 1.6vh;background:linear-gradient(180deg,#9E77E8,#7B54D6);border:.4vh solid #fff;border-radius:1.8vh;box-shadow:0 .4vh .8vh rgba(0,0,0,.24)">
      <div style="position:relative;width:26vh;height:2.8vh;border:.35vh solid #fff;border-radius:99px;overflow:hidden;background:#2E1B60">
        <div ref="{{ gardenFillRef }}" style="position:absolute;left:0;top:0;bottom:0;width:0%;background:linear-gradient(180deg,#FFD75E,#F0A62A);border-radius:99px"></div>
        <div ref="{{ stageMarkRef }}" style="position:absolute;left:0;top:0;bottom:0;width:2px;background:#F7EEDB;opacity:0;box-shadow:0 0 1vh rgba(247,238,219,.8);transition:left .3s ease,opacity .3s ease"></div>
        <div style="position:absolute;left:20%;top:0;bottom:0;width:1px;background:rgba(255,255,255,.35)"></div>
        <div style="position:absolute;left:40%;top:0;bottom:0;width:1px;background:rgba(255,255,255,.35)"></div>
        <div style="position:absolute;left:60%;top:0;bottom:0;width:1px;background:rgba(255,255,255,.35)"></div>
        <div style="position:absolute;left:80%;top:0;bottom:0;width:1px;background:rgba(255,255,255,.35)"></div>
      </div>
      <div ref="{{ plotTextRef }}" style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:2.1vh;line-height:1;color:#fff;text-shadow:0 .25vh 0 rgba(0,0,0,.3);min-width:5vh;text-align:right">0/5</div>
    </div>

    <div style="position:absolute;left:0;right:0;bottom:calc(12% - 20px);display:flex;flex-direction:column;align-items:center;gap:1.2vh">
      <div ref="{{ lineWrap4Ref }}" style="padding:1vh 2vh;background:#fff;border-radius:1.8vh;box-shadow:0 .5vh 1vh rgba(9,32,48,.28);opacity:0;transition:opacity .28s ease">
        <div ref="{{ line4Ref }}" style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:700;font-size:1.9vh;color:#3A2E66"></div>
      </div>
    </div>
  </sc-if>

</div>
</x-dc>
<script type="text/x-dc" data-dc-script data-props="{&quot;breathEffort&quot;:{&quot;editor&quot;:&quot;enum&quot;,&quot;options&quot;:[&quot;Gentle&quot;,&quot;Standard&quot;,&quot;Strong&quot;],&quot;default&quot;:&quot;Standard&quot;,&quot;tsType&quot;:&quot;string&quot;,&quot;section&quot;:&quot;Play feel&quot;},&quot;pacing&quot;:{&quot;editor&quot;:&quot;enum&quot;,&quot;options&quot;:[&quot;Unhurried&quot;,&quot;Steady&quot;,&quot;Brisk&quot;],&quot;default&quot;:&quot;Steady&quot;,&quot;tsType&quot;:&quot;string&quot;,&quot;section&quot;:&quot;Play feel&quot;},&quot;coaching&quot;:{&quot;editor&quot;:&quot;enum&quot;,&quot;options&quot;:[&quot;Quiet&quot;,&quot;Warm&quot;,&quot;Chatty&quot;],&quot;default&quot;:&quot;Warm&quot;,&quot;tsType&quot;:&quot;string&quot;,&quot;section&quot;:&quot;Play feel&quot;}}">
const PLACES = [
  { id: 'stream', index: '01', accent: '#9FD0F2', wash: '#E3F2FD', chip: 'linear-gradient(180deg,#7FDDF7 0%,#12A5E0 100%)', dur: 30, art: 'url(assets/card-stream.png)', pos: '50% 40%' },
  { id: 'cave',   index: '02', accent: '#F2A9C4', wash: '#FBE6EE', chip: 'linear-gradient(180deg,#FF8ED0 0%,#E9349B 100%)', dur: 45, art: 'url(assets/scene-tunnel.png)', pos: '50% 50%' },
  { id: 'clearing', index: '03', accent: '#F6C96B', wash: '#FDF0D8', chip: 'linear-gradient(180deg,#FFD75E 0%,#F58A0C 100%)', dur: 60, art: 'url(assets/card-stage.png)', pos: '50% 44%' },
  { id: 'pond',   index: '04', accent: '#A9B4F2', wash: '#E8EAFB', chip: 'linear-gradient(180deg,#A5EA76 0%,#3FA80F 100%)', dur: 0,  art: 'url(assets/scene-garden.png)', pos: '50% 62%' }
];

const STR = {
  en: {
    pickPlace: 'Choose a place', grownups: 'FOR GROWN-UPS', back: 'BACK', sparks: 'SPARKS', timeBar: 'TIME', breathBar: 'BREATH',
    hint: 'Hold SPACE to breathe, or press and hold anywhere',
    puff: 'PUFF', pulseHint: 'SHORT PULSE = QUICK PUFF · LONG PULSE = LONGER BREATH',
    names: { stream: 'Lillypad Hop', cave: 'The Cave', clearing: 'Firefly Conversation', pond: 'The Garden' },
    teach: { stream: 'Little puffs, one after another', cave: 'One long, steady breath', clearing: 'Answer each pulse you see', pond: 'Longer breaths make it grow' },
    durs: { stream: '30 SECONDS', cave: '45 SECONDS', clearing: '60 SECONDS', pond: '5 STAGES' },
    good: 'That was a good one.', softer: 'A little softer.', firmer: 'A little more air.',
    hold: 'Hold it steady.', drifting: 'Come back to the light.', lovely: 'Lovely.',
    watch: 'Watch the fireflies', yourTurn: 'Now your turn.',
    pondLine: 'Hold your breath out and watch it grow.',
    grow: 'GROW', grew: 'It grew a little.', bloomed: 'Fully bloomed.',
    breathe: 'HOW WE BREATHE', conn: 'How are we breathing?',
    srcKey: 'Spacebar', srcKeyBlurb: 'No hardware. Hold the space bar. Good for testing.',
    srcMic: 'Flute + microphone', srcMicBlurb: 'No wires at all. The laptop hears everything.',
    srcSerial: 'Flute + sensor', srcSerialBlurb: 'The sensor measures the air, the microphone hears the note.',
    tryBlow: 'Give it a blow — if the bar moves, we are ready.',
    noteHeard: 'NOTE HEARD', reading: 'READING',
    calibrate: 'CALIBRATE', reZero: 'RE-ZERO SENSOR',
    calQuiet: 'Sit quietly — do not blow yet.',
    calBlow: 'Now one gentle blow. Not your biggest — an easy one.',
    stKey: 'spacebar', stMic: 'microphone', stSerial: 'flute ready', stOff: 'not connected',
    errBrowser: 'This needs Chrome or Edge.',
    errPort: 'No port picked. Close the Arduino Serial Monitor first — only one program can hold the cable.',
    errUnplug: 'The cable came out. Plug it back in and connect again.',
    errMic: 'The microphone was not allowed.',
    warnLoud: 'It is quite noisy in here — that is fine, just blow a little firmer.',
    warnFilter: 'Your browser is still filtering the mic. Turn off voice isolation in your sound settings.'
  },
  hi: {
    pickPlace: 'Ek jagah chunein', grownups: 'BADON KE LIYE', back: 'PICHHE', sparks: 'CHINGARI', timeBar: 'SAMAY', breathBar: 'SAANS',
    hint: 'SPACE dabaye rakhein, ya kahin bhi dabaye rakhein',
    puff: 'PHOONK', pulseHint: 'CHHOTI JHALAK = CHHOTI PHOONK · LAMBI JHALAK = LAMBI SAANS',
    names: { stream: 'Lillypad Hop', cave: 'Gufa', clearing: 'Jugnu ki Baatein', pond: 'Bagiya' },
    teach: { stream: 'Chhoti phoonkein, ek ke baad ek', cave: 'Ek lambi, sthir saans', clearing: 'Har jhalak ka jawab dein', pond: 'Lambi saans se yeh badhta hai' },
    durs: { stream: '30 SECOND', cave: '45 SECOND', clearing: '60 SECOND', pond: '5 CHARAN' },
    good: 'Yeh achhi thi.', softer: 'Thoda dheere.', firmer: 'Thodi aur hawa.',
    hold: 'Isse sthir rakhein.', drifting: 'Roshni mein wapas aaiye.', lovely: 'Sundar.',
    watch: 'Jugnuon ko dekhein', yourTurn: 'Ab aapki baari.',
    pondLine: 'Saans rokein aur ise badhta dekhein.',
    grow: 'BADHNA', grew: 'Yeh thoda bada hua.', bloomed: 'Poora khil gaya.',
    breathe: 'SAANS KAISE', conn: 'Hum saans kaise le rahe hain?',
    srcKey: 'Spacebar', srcKeyBlurb: 'Koi hardware nahi. Space dabaye rakhein. Jaanchne ke liye.',
    srcMic: 'Bansuri + microphone', srcMicBlurb: 'Koi taar nahi. Laptop sab sun leta hai.',
    srcSerial: 'Bansuri + sensor', srcSerialBlurb: 'Sensor hawa naapta hai, microphone sur sunta hai.',
    tryBlow: 'Ek phoonk maarein — agar patti hile, to hum taiyar hain.',
    noteHeard: 'SUNA GAYA SUR', reading: 'PADHAI',
    calibrate: 'CALIBRATE KAREIN', reZero: 'SENSOR PHIR SE ZERO',
    calQuiet: 'Shaant baithein — abhi phoonk na maarein.',
    calBlow: 'Ab ek halki phoonk. Sabse badi nahi — ek aasaan si.',
    stKey: 'spacebar', stMic: 'microphone', stSerial: 'bansuri taiyar', stOff: 'juda nahi hai',
    errBrowser: 'Iske liye Chrome ya Edge chahiye.',
    errPort: 'Koi port nahi chuna. Pehle Arduino Serial Monitor band karein — ek samay par ek hi program taar le sakta hai.',
    errUnplug: 'Taar nikal gaya. Use wapas lagakar phir se connect karein.',
    errMic: 'Microphone ki anumati nahi mili.',
    warnLoud: 'Yahan kaafi shor hai — koi baat nahi, bas thodi zor se phoonkein.',
    warnFilter: 'Aapka browser abhi bhi mic filter kar raha hai. Sound settings mein voice isolation band karein.'
  }
};

const SAVE_KEY = 'chamkiForest.v3';
const PAD_GAPS = [14, 25, 11, 21, 30, 13, 24, 17];
const PAD_POS = [0];
function padPos(i) {
  while (PAD_POS.length <= i) {
    const n = PAD_POS.length - 1;
    PAD_POS.push(PAD_POS[n] + PAD_GAPS[n % PAD_GAPS.length]);
  }
  return PAD_POS[i];
}
function padGap(i) { return PAD_GAPS[i % PAD_GAPS.length]; }


/* ==========================================================
   BREATH INPUT — spacebar, laptop microphone, or the Arduino.
   Ported from the Firefly Meadow build.

   The Arduino stays dumb. Fifty times a second it types one
   line of plain text down the USB cable — "0.734,523.3" —
   meaning how hard, and which note. Nothing below is clever:
   it reads text and splits it at the comma. That is the whole
   link, which is why the number's SOURCE can change (real
   sensor, simulator sketch, microphone) without the game
   noticing.

   Web Serial needs Chrome or Edge AND a real http:// origin.
   Opening this file by double-clicking will not work — serve
   the folder and use localhost.
   ========================================================== */
const SERIAL_BAUD = 115200;

// What the recorder actually sounds. German fingering, so going
// down the scale is simply "cover one more finger" each time.
// Only used for the readout in the panel — no gameplay depends on it.
const LADDER = [
  { n: 'C', holes: 0, hz: 1046.50 },
  { n: 'B', holes: 1, hz: 987.77 },
  { n: 'A', holes: 2, hz: 880.00 },
  { n: 'G', holes: 3, hz: 783.99 },
  { n: 'F', holes: 4, hz: 698.46 },
  { n: 'E', holes: 5, hz: 659.25 },
  { n: 'D', holes: 6, hz: 587.33 }
];
function noteFromHz(hz) {
  if (!hz) return null;
  let best = null, bc = 1e9;
  LADDER.forEach(l => { const c = Math.abs(1200 * Math.log2(hz / l.hz)); if (c < bc) { bc = c; best = l; } });
  return bc < 60 ? best : null;   // more than half a semitone out — don't guess
}

// Autocorrelation pitch detection. Same detector as the flute lab.
function detectPitch(buf, rate) {
  const N = buf.length;
  let rms = 0; for (let i = 0; i < N; i++) rms += buf[i] * buf[i];
  rms = Math.sqrt(rms / N);
  if (rms < 0.008) return { hz: 0, rms };
  const thr = 0.2 * rms; let s = 0, e = N - 1;
  while (s < N / 2 && Math.abs(buf[s]) < thr) s++;
  while (e > N / 2 && Math.abs(buf[e]) < thr) e--;
  const b = buf.slice(s, e), M = b.length;
  if (M < 256) return { hz: 0, rms };
  const c = new Float32Array(M);
  for (let lag = 0; lag < M; lag++) { let sum = 0; for (let i = 0; i < M - lag; i++) sum += b[i] * b[i + lag]; c[lag] = sum; }
  let d = 0; while (d < M - 1 && c[d] > c[d + 1]) d++;
  let mv = -1, mi = -1;
  for (let i = d; i < M; i++) if (c[i] > mv) { mv = c[i]; mi = i; }
  if (mi <= 0 || c[0] <= 0) return { hz: 0, rms };
  const y1 = c[mi - 1] || 0, y2 = c[mi], y3 = c[mi + 1] || 0;
  const a = (y1 + y3 - 2 * y2) / 2, bb = (y3 - y1) / 2;
  const period = mi + (a ? -bb / (2 * a) : 0);
  const hz = rate / period, clarity = mv / c[0];
  if (hz < 180 || hz > 2600 || clarity < 0.5) return { hz: 0, rms };
  return { hz, rms };
}

const BreathIn = {
  src: 'key',                 // 'key' | 'mic' | 'serial'
  raw: 0, comfort: 0.55,
  connected: false, micOn: false,
  why: '', lines: 0, lastRms: 0, hz: 0, note: null,
  serialRaw: 0, micRaw: 0,
  onChange: null,

  // Is a real breath sensor driving the game right now?
  active() {
    return (this.src === 'serial' && this.connected) || (this.src === 'mic' && this.micOn);
  },
  // Breath as a fraction of this child's own comfortable blow.
  rel() { return this.comfort > 0.02 ? Math.min(1.6, this.raw / this.comfort) : 0; },
  _emit() { if (this.onChange) this.onChange(); },

  /* ---- The Arduino, over USB ------------------------------------- */
  _port: null, _reader: null, _writer: null, _keep: true, _buf: '',

  async useSerial() {
    if (!('serial' in navigator)) return { ok: false, why: 'needBrowser' };
    try {
      this._port = await navigator.serial.requestPort();
      await this._port.open({ baudRate: SERIAL_BAUD });
    } catch (e) {
      // Almost always one of: nothing picked, or the Arduino Serial
      // Monitor still holds the cable. Only one program gets it at a time.
      return { ok: false, why: 'noPort' };
    }
    this.connected = true; this._keep = true; this.comfort = 0.95;
    try {
      const enc = new TextEncoderStream();
      enc.readable.pipeTo(this._port.writable).catch(() => {});
      this._writer = enc.writable.getWriter();
    } catch (e) { this._writer = null; }
    this._readLoop();
    this._emit();
    return { ok: true };
  },

  async _readLoop() {
    const dec = new TextDecoderStream();
    this._port.readable.pipeTo(dec.writable).catch(() => {});
    this._reader = dec.readable.getReader();
    try {
      while (this._keep) {
        const { value, done } = await this._reader.read();
        if (done) break;
        this._buf += value;
        let i;
        while ((i = this._buf.indexOf('\n')) >= 0) {
          this._parse(this._buf.slice(0, i).trim());
          this._buf = this._buf.slice(i + 1);
        }
        if (this._buf.length > 400) this._buf = '';
      }
    } catch (e) { /* cable pulled mid-read */ }
    // A seven-year-old WILL pull the cable. Notice it, say something
    // kind, and let them reconnect — never freeze.
    this.connected = false; this.serialRaw = 0; this._buf = '';
    if (this.src === 'serial' && this._keep) this.why = 'unplugged';
    this._emit();
  },

  _parse(l) {
    if (!l || l[0] === '#' || l.startsWith('READY') || l.startsWith('ERR')) return;
    const p = l.split(','), v = parseFloat(p[0]);
    if (!isFinite(v)) return;
    this.serialRaw = Math.max(0, Math.min(1, v));   // sketch already sends 0..1
    if (p[1]) { const hz = parseFloat(p[1]); if (isFinite(hz) && hz > 0) { this.hz = hz; this.note = noteFromHz(hz); } }
    this.lines++;
  },

  // Tell the sketch to take a fresh "nobody is blowing" reading.
  async reZero() { if (this._writer) { try { await this._writer.write('z'); } catch (e) {} } },

  async closeSerial() {
    this._keep = false;
    try { if (this._reader) await this._reader.cancel(); } catch (e) {}
    try { if (this._writer) await this._writer.close(); } catch (e) {}
    try { if (this._port) await this._port.close(); } catch (e) {}
    this._port = null; this._reader = null; this._writer = null;
    this.connected = false; this.serialRaw = 0;
  },

  /* ---- The laptop microphone -------------------------------------- */
  _an: null, _bins: null, _ac: null, _st: null, _rate: 44100,
  ambient: null, rawOk: true, micReport: '',
  MARGIN: 2.4,        // how far above the room a sound must be to count
  GAIN: 11,

  async useMic() {
    if (this.micOn) return { ok: true };
    try {
      const st = await navigator.mediaDevices.getUserMedia({ audio: {
        echoCancellation: false, noiseSuppression: false, autoGainControl: false,
        voiceIsolation: false,
        // Chrome's older vendor flags. Harmless elsewhere, and on some
        // builds these are the ones that actually take effect.
        googEchoCancellation: false, googNoiseSuppression: false,
        googAutoGainControl: false, googHighpassFilter: false
      }});
      // Ask the track what it ACTUALLY did. Browsers may ignore all of
      // the above, and when they do a long steady blow gets treated as
      // background noise and deleted. Better to know than to wonder.
      try {
        const s = st.getAudioTracks()[0].getSettings();
        this.rawOk = (s.noiseSuppression !== true && s.autoGainControl !== true);
        this.micReport = 'noiseSuppression=' + s.noiseSuppression + '  autoGain=' + s.autoGainControl;
        console.log('[mic]', this.micReport, this.rawOk ? 'OK' : '<-- browser overrode us');
      } catch (e) { this.rawOk = true; }
      const ac = new (window.AudioContext || window.webkitAudioContext)();
      const an = ac.createAnalyser(); an.fftSize = 2048;
      ac.createMediaStreamSource(st).connect(an);
      this._ac = ac; this._st = st; this._an = an;
      this._bins = new Float32Array(an.fftSize);
      this._rate = ac.sampleRate;
      this.micOn = true; this._emit();
      return { ok: true };
    } catch (e) { return { ok: false, why: 'noMic' }; }
  },

  stopMic() {
    try { if (this._st) this._st.getAudioTracks().forEach(t => t.stop()); } catch (e) {}
    try { if (this._ac) this._ac.close(); } catch (e) {}
    this._an = null; this._st = null; this._ac = null;
    this.micOn = false; this.micRaw = 0; this.ambient = null;
  },

  // ---- the noise gate ----------------------------------------------
  // The room level is MEASURED once, while the child sits quietly, and
  // then held still. If the floor were allowed to chase the signal, a
  // steady room hum and a steady blow would look identical after a second.
  measureRoom(rms) { this.ambient = this.ambient === null ? rms : Math.max(this.ambient, rms); },
  gate(rms) {
    if (this.ambient === null) { this.ambient = rms; return 0; }
    // Slow one-way drift: creeps UP only while nothing is happening, so a
    // fan switched on mid-session gets absorbed but a long breath never does.
    if (rms < this.ambient * this.MARGIN) this.ambient += (rms - this.ambient) * 0.0015;
    return Math.max(0, Math.min(1, (rms - this.ambient * this.MARGIN) * this.GAIN));
  },
  roomTooLoud() { return this.ambient !== null && this.ambient > 0.035; },

  _pitchSkip: 0,
  _readMic() {
    this._an.getFloatTimeDomainData(this._bins);
    let s = 0; for (let i = 0; i < this._bins.length; i++) s += this._bins[i] * this._bins[i];
    const rms = Math.sqrt(s / this._bins.length);
    this.lastRms = rms;
    this.micRaw = this.gate(rms);
    // Autocorrelation is the expensive part, and a note never changes in
    // 16ms anyway. Every fifth frame is plenty and keeps the game smooth.
    if (--this._pitchSkip <= 0) {
      this._pitchSkip = 5;
      const r = detectPitch(this._bins, this._rate);
      if (r.hz > 0) { this.hz = this.hz ? this.hz * 0.6 + r.hz * 0.4 : r.hz; this.note = noteFromHz(this.hz); }
      else if (!this.connected) { this.note = null; }
    }
  },

  tick() {
    if (this._an) this._readMic();
    // The sensor wins when it is there; the mic is only the fallback.
    // (Serial mode runs the mic too, but only to HEAR the note — it must
    // never overwrite the pressure the sensor measured.)
    this.raw = (this.src === 'serial' && this.connected) ? this.serialRaw
             : (this.src === 'mic' && this.micOn) ? this.micRaw
             : 0;
  },

  /* ---- Picking a source ------------------------------------------- */
  async use(src) {
    this.why = '';
    if (src !== 'serial' && this.connected) await this.closeSerial();
    if (src === 'key' && this.micOn) this.stopMic();   // release the mic light too
    this.src = src;
    let r = { ok: true };
    if (src === 'serial') {
      r = await this.useSerial();
      if (r.ok) await this.useMic();       // the mic is what hears the note
    } else if (src === 'mic') {
      r = await this.useMic();
    }
    if (!r.ok) { this.why = r.why; this.src = 'key'; }
    this._emit();
    return r;
  }
};

class Component extends DCLogic {
  state = { screen: 'cards', lang: 'en' };

  progressRef = React.createRef();
  progressRef2 = React.createRef();
  progressRef3 = React.createRef();
  padLaneRef = React.createRef();
  flyRef = React.createRef();
  gaugeRef = React.createRef();
  gaugeZoneRef = React.createRef();
  jarCountRef = React.createRef();
  jarFillRef = React.createRef();
  jarWrapRef = React.createRef();
  lineRef = React.createRef();
  lineWrapRef = React.createRef();
  caveBgRef = React.createRef();
  caveObsRef = React.createRef();
  caveFlyRef = React.createRef();
  caveBarRef = React.createRef();
  caveStreakRef = React.createRef();
  jarCount2Ref = React.createRef();
  jarFill2Ref = React.createRef();
  jarWrap2Ref = React.createRef();
  line2Ref = React.createRef();
  lineWrap2Ref = React.createRef();
  convGlowRef = React.createRef();
  convBreathRef = React.createRef();
  convSeqRef = React.createRef();
  convFlyRef = React.createRef();
  jarCount3Ref = React.createRef();
  jarFill3Ref = React.createRef();
  line3Ref = React.createRef();
  lineWrap3Ref = React.createRef();
  pondOrbRef = React.createRef();
  plotRef = React.createRef();
  plotIdx = 0;
  gardenFillRef = React.createRef();
  stageMarkRef = React.createRef();
  plotTextRef = React.createRef();
  shownStage = 0;
  line4Ref = React.createRef();
  lineWrap4Ref = React.createRef();
  gardenStage = 0;

  cbBarRef = React.createRef();
  cbValRef = React.createRef();
  cbNoteRef = React.createRef();
  cbCalRef = React.createRef();
  calStage = -1;
  calT = 0;
  calPeak = 0;

  breath = { value: 0, held: false, peak: 0, dur: 0 };
  keyDown = false;
  pointerDown = false;

  sparks = 0;
  elapsed = 0;
  line = '';
  lineTimer = 0;

  padIdx = 0;
  padScroll = 0;
  hopT = 999;
  hopDur = 800;
  hopFrom = 0;
  hopGap = 14;

  caveScroll = 0;
  caveY = 56;
  caveObs = [];
  caveStreak = 0;
  caveBest = 0;
  caveIn = false;

  convSeq = [];
  convIdx = 0;
  convPhase = 'show';
  convPhaseTime = 0;
  convStep = 0;

  componentDidMount() {
    this.ensureLoop();
    BreathIn.onChange = () => { if (this.state.screen === 'connect') this.forceUpdate(); };
  }

  componentWillUnmount() {
    this.loopOn = false;
    BreathIn.onChange = null;
    cancelAnimationFrame(this.raf);
    window.removeEventListener('keydown', this.onKeyDown);
    window.removeEventListener('keyup', this.onKeyUp);
    window.removeEventListener('pointerdown', this.onPointerDown);
    window.removeEventListener('pointerup', this.onPointerUp);
  }

  t() { return STR[this.state.lang] || STR.en; }

  effort() { const e = this.props.breathEffort || 'Standard'; return e === 'Gentle' ? 0.74 : e === 'Strong' ? 1.28 : 1; }
  pace() { const p = this.props.pacing || 'Steady'; return p === 'Unhurried' ? 1.4 : p === 'Brisk' ? 0.7 : 1; }

  say(msg) {
    const v = this.props.coaching || 'Warm';
    if (v === 'Quiet') return;
    this.line = msg;
    this.lineTimer = v === 'Chatty' ? 3200 : 1800;
  }

  logVisit(id) {
    try {
      const raw = localStorage.getItem(SAVE_KEY);
      const data = raw ? JSON.parse(raw) : { sessions: [] };
      data.sessions = data.sessions || [];
      data.sessions.push({ d: Date.now(), p: id, att: 0, on: this.sparks, longest: this.caveBest, blow: 0, finished: false });
      if (data.sessions.length > 200) data.sessions = data.sessions.slice(-200);
      localStorage.setItem(SAVE_KEY, JSON.stringify(data));
    } catch (e) {}
  }

  resetRun() {
    this.sparks = 0; this.elapsed = 0; this.line = ''; this.lineTimer = 0;
  }

  startStream() {
    this.resetRun();
    this.padIdx = 0; this.padScroll = 0; this.hopT = 999;
    this.setState({ screen: 'stream' });
  }

  startCave() {
    this.resetRun();
    this.caveScroll = 0; this.caveY = 50; this.caveStreak = 0; this.caveBest = 0; this.caveIn = false;
    this.caveObs = [this.makeObs(58), this.makeObs(92), this.makeObs(126), this.makeObs(160)];
    this.setState({ screen: 'cave' });
  }

  startConversation() {
    this.resetRun();
    this.convSeq = [
      { pulses: [320, 260, 320], color: '#D4A5F5' },
      { pulses: [560, 220, 340], color: '#FFD4A3' },
      { pulses: [300, 200, 300, 200, 300], color: '#A5D4F5' },
      { pulses: [640, 240, 380], color: '#D4F5A5' }
    ];
    this.convIdx = 0; this.convPhase = 'show'; this.convPhaseTime = 0; this.convStep = 0;
    this.setState({ screen: 'conversation' });
  }

  startPond() { this.resetRun(); this.gardenStage = -1; this.shownStage = -2; this.plotIdx = 0; this.plotCleared = false; this.growHold = 0; this.grewThisBreath = false; this.setState({ screen: 'pond' }); }

  leave() {
    const id = this.state.screen;
    if (id !== 'cards' && id !== 'pond') this.logVisit(id === 'conversation' ? 'clearing' : id);
    this.setState({ screen: 'cards' });
  }

  tickBreath(dt) {
    const b = this.breath;
    BreathIn.tick();
    // A real breath already HAS a magnitude, so it goes straight in.
    // The spacebar has to fake one, which is what the slow rise is for.
    // Either way the spacebar stays live, so a grown-up can always test.
    const ext = BreathIn.active();
    const keyT = (this.keyDown || this.pointerDown) ? 1 : 0;
    const target = ext ? Math.max(keyT, Math.min(1, BreathIn.rel())) : keyT;
    const k = ext ? 0.22 : (target ? 0.035 : 0.16);
    b.value += (target - b.value) * (1 - Math.pow(1 - k, dt / 16.67));
    if (b.value < 0.01) b.value = 0;
    const was = b.held;
    b.held = b.value > 0.06;
    if (b.held && !was) { b.peak = b.value; b.dur = dt; }
    else if (b.held) { b.peak = Math.max(b.peak, b.value); b.dur += dt; }
    if (!b.held && was) { const ev = { peak: b.peak, dur: b.dur }; b.peak = 0; b.dur = 0; return ev; }
    return null;
  }

  showLine(wrap, el) {
    if (el && el.current) el.current.textContent = this.line;
    if (wrap && wrap.current) wrap.current.style.opacity = this.line ? '1' : '0';
  }

  showJar(cnt, fill, max) {
    if (cnt && cnt.current) cnt.current.textContent = String(this.sparks);
    if (fill && fill.current) fill.current.style.height = Math.min(100, (this.sparks / max) * 100) + '%';
  }

  updateStream(dt, ev) {
    this.elapsed += dt;
    const total = 30000 * this.pace();
    if (this.progressRef.current) this.progressRef.current.style.width = Math.min(1, this.elapsed / total) * 100 + '%';

    if (this.gaugeRef.current) this.gaugeRef.current.style.width = Math.min(1, this.breath.value) * 100 + '%';

    const gap = padGap(this.padIdx);
    const need = (0.2 + ((gap - 11) / 19) * 0.46) * this.effort();
    const tol = 0.17 * (this.props.breathEffort === 'Gentle' ? 1.3 : 1);
    const hopping = this.hopT < this.hopDur;
    if (this.gaugeZoneRef.current) {
      this.gaugeZoneRef.current.style.left = Math.max(0, (need - tol)) * 100 + '%';
      this.gaugeZoneRef.current.style.width = (tol * 2) * 100 + '%';
      this.gaugeZoneRef.current.style.opacity = hopping ? '.18' : '1';
    }
    if (this.gaugeRef.current) this.gaugeRef.current.style.opacity = hopping ? '.35' : '1';
    if (ev && !hopping) {
      if (ev.peak < need - tol) this.say(this.t().firmer);
      else if (ev.peak > need + tol) this.say(this.t().softer);
      else {
        this.hopFrom = padPos(this.padIdx);
        this.hopGap = gap;
        this.hopDur = 620 + gap * 30;
        this.hopT = 0;
        this.padIdx++;
        this.sparks++;
        this.say(this.t().good);
      }
    }

    if (this.hopT < this.hopDur) {
      this.hopT += dt;
      const p = Math.min(1, this.hopT / this.hopDur);
      const e = (1 - Math.cos(Math.PI * p)) / 2;
      this.padScroll = this.hopFrom + e * this.hopGap;
    } else {
      this.padScroll += (padPos(this.padIdx) - this.padScroll) * Math.min(1, dt / 400);
    }

    const lane = this.padLaneRef.current;
    if (lane) {
      for (let j = 0; j < lane.children.length; j++) {
        const L = this.padIdx - 1 + j;
        const el = lane.children[j];
        if (L < 0) { el.style.opacity = '0'; continue; }
        el.style.left = (26 + padPos(L) - this.padScroll) + '%';
        el.style.opacity = L < this.padIdx ? '.35' : '1';
      }
    }
    if (this.flyRef.current) {
      const base = 64;
      let y = base, x = 26;
      if (this.hopT < this.hopDur) {
        const p = Math.min(1, this.hopT / this.hopDur);
        const lift = Math.sin(Math.PI * p);
        y = base - (Math.pow(lift, 0.85) * (11 + this.hopGap * 0.42));
        x = 26 + Math.sin(Math.PI * p) * (2 + this.hopGap * 0.1);
      } else {
        y = base - this.breath.value * 4;
      }
      this.flyRef.current.style.top = y + '%';
      this.flyRef.current.style.left = x + '%';
    }

    this.showJar(this.jarCountRef, this.jarFillRef, 12);
    if (this.lineTimer > 0) { this.lineTimer -= dt; if (this.lineTimer <= 0) this.line = ''; }
    this.showLine(this.lineWrapRef, this.lineRef);

    if (this.elapsed > total) this.leave();
  }

  makeObs(x) {
    return { x: x, gapC: 32 + Math.random() * 36, gapH: 30 + Math.random() * 10, scored: false, clear: true };
  }

  updateCave(dt, ev) {
    this.elapsed += dt;
    const total = 45000 * this.pace();
    if (this.progressRef2.current) this.progressRef2.current.style.width = Math.min(1, this.elapsed / total) * 100 + '%';

    const speed = 17;
    this.caveScroll += (speed * dt) / 1000;
    if (this.caveBgRef.current) this.caveBgRef.current.style.backgroundPosition = (-this.caveScroll * 5.2) + 'px center';

    const flyX = 26;
    const bandTop = 42, bandH = 58, half = 9 * (this.props.breathEffort === 'Gentle' ? 1.35 : this.props.breathEffort === 'Strong' ? 0.8 : 1), pad = 3;
    const yLo = (bandTop + half - bandTop) / (bandH / 100);
    const yHi = (100 - pad - half - bandTop) / (bandH / 100);
    const flyTarget = yHi - Math.min(1, this.breath.value) * (yHi - yLo);
    this.caveY += (flyTarget - this.caveY) * Math.min(1, dt / 210);
    if (this.caveFlyRef.current) this.caveFlyRef.current.style.top = (42 + this.caveY * 0.58) + '%';

    let hit = false;
    for (const o of this.caveObs) {
      o.x -= (speed * dt) / 1000;
      if (o.x < -14) { const far = Math.max.apply(null, this.caveObs.map(q => q.x)); Object.assign(o, this.makeObs(far + 34)); }
      if (Math.abs(o.x - flyX) < 4.6 && Math.abs(this.caveY - o.gapC) > o.gapH / 2 - 4) { hit = true; o.clear = false; }
      if (!o.scored && o.x < flyX - 6) { o.scored = true; if (o.clear) this.sparks++; }
    }

    const obs = this.caveObsRef.current;
    if (obs) {
      for (let i = 0; i < obs.children.length && i < this.caveObs.length; i++) {
        const o = this.caveObs[i];
        const el = obs.children[i];
        el.style.left = o.x + '%';
        const th = Math.max(0, o.gapC - o.gapH / 2) + '%';
        const bh = Math.max(0, 100 - (o.gapC + o.gapH / 2)) + '%';
        el.children[0].style.height = th;
        el.children[1].style.height = th;
        el.children[2].style.height = bh;
        el.children[3].style.height = bh;
      }
    }

    if (!hit) {
      this.caveStreak += dt;
      this.caveBest = Math.max(this.caveBest, this.caveStreak);
      if (!this.caveIn && this.caveStreak > 900) { this.caveIn = true; this.say(this.t().hold); }
    } else {
      if (this.caveIn || this.caveStreak > 600) { this.caveIn = false; this.say(this.t().drifting); }
      this.caveStreak = 0;
    }
    if (this.caveFlyRef.current) {
      this.caveFlyRef.current.style.filter = hit
        ? 'drop-shadow(0 0 3vh rgba(255,120,120,.75))'
        : 'drop-shadow(0 0 3vh rgba(255,214,130,.55))';
    }

    if (this.caveBarRef.current) this.caveBarRef.current.style.width = Math.min(1, this.elapsed / total) * 100 + '%';
    if (this.caveStreakRef.current) {
      const w = Math.min(30, (this.caveStreak / 8000) * 30);
      const l = Math.max(0, Math.min(1, this.elapsed / total) * 100 - w);
      this.caveStreakRef.current.style.left = l + '%';
      this.caveStreakRef.current.style.width = w + '%';
    }

    this.showJar(this.jarCount2Ref, this.jarFill2Ref, 20);
    if (this.lineTimer > 0) { this.lineTimer -= dt; if (this.lineTimer <= 0) this.line = ''; }
    this.showLine(this.lineWrap2Ref, this.line2Ref);

    if (this.elapsed > total) this.leave();
  }

  updateConversation(dt, ev) {
    this.elapsed += dt;
    const total = 60000 * this.pace();
    if (this.progressRef3.current) this.progressRef3.current.style.width = Math.min(1, this.elapsed / total) * 100 + '%';

    const pat = this.convSeq[this.convIdx];
    if (!pat) { this.leave(); return; }
    this.convPhaseTime += dt;

    if (this.convPhase === 'show') {
      let acc = 0, lit = false, done = true;
      for (let i = 0; i < pat.pulses.length; i++) {
        const d = pat.pulses[i];
        if (this.convPhaseTime < acc + d) { lit = (i % 2 === 0); done = false; break; }
        acc += d;
      }
      if (this.convGlowRef.current) {
        this.convGlowRef.current.style.background = pat.color;
        this.convGlowRef.current.style.boxShadow = '0 0 4vh 1vh ' + pat.color;
        this.convGlowRef.current.style.opacity = lit ? '1' : '0';
      }
      if (done && this.convPhaseTime > acc + 500) {
        this.convPhase = 'answer'; this.convPhaseTime = 0; this.convStep = 0;
        this.say(this.t().yourTurn);
      } else if (this.convPhaseTime < 60) {
        this.say(this.t().watch);
      }
    } else {
      if (this.convGlowRef.current) this.convGlowRef.current.style.opacity = '0';
      const wantIdx = this.convStep * 2;
      const want = pat.pulses[wantIdx];
      if (ev && want != null) {
        const ok = Math.abs(ev.dur - want) < Math.max(220, want * 0.55);
        if (ok) {
          this.convStep++;
          this.sparks++;
          if (this.convStep * 2 >= pat.pulses.length) {
            this.say(this.t().lovely);
            this.convIdx++; this.convPhase = 'show'; this.convPhaseTime = 0; this.convStep = 0;
          }
        } else {
          this.say(ev.dur > want ? this.t().softer : this.t().firmer);
          this.convStep = 0;
        }
      }
      if (this.convPhaseTime > 12000) { this.convPhase = 'show'; this.convPhaseTime = 0; this.convStep = 0; }
    }

    if (this.convBreathRef.current) {
      this.convBreathRef.current.style.background = pat.color;
      this.convBreathRef.current.style.opacity = this.breath.value > 0.08 ? String(0.35 + this.breath.value * 0.6) : '0';
    }
    const seq = this.convSeqRef.current;
    if (seq) {
      for (let i = 0; i < seq.children.length; i++) {
        seq.children[i].style.opacity = i < this.convIdx ? '1' : (i === this.convIdx ? '.7' : '.25');
      }
    }

    this.showJar(this.jarCount3Ref, this.jarFill3Ref, 14);
    if (this.lineTimer > 0) { this.lineTimer -= dt; if (this.lineTimer <= 0) this.line = ''; }
    this.showLine(this.lineWrap3Ref, this.line3Ref);

    if (this.elapsed > total) this.leave();
  }

  spriteFor(stage, plot) {
    const V = ['pink', 'yellow', 'orange', 'purple', 'pink'];
    if (stage < 2) return 'assets/flower-' + (stage + 1) + '.png';
    return 'assets/flower-' + V[plot % V.length] + '-' + (stage + 1) + '.png';
  }

  updatePond(dt, ev) {
    const SPOTS = [[24, 20], [38, 25], [50, 29], [62, 25], [76, 20]];
    const v = Math.min(1, this.breath.value);
    const E = this.effort();
    const STEPS = [0.12, 0.30, 0.48, 0.66, 0.84].map(s => Math.min(0.97, s * E));
    let seg = 0;
    for (let i = 0; i < STEPS.length; i++) if (v >= STEPS[i]) seg = i + 1;
    const full = this.plotIdx >= SPOTS.length;
    const target = full ? -1 : seg - 1;
    if (target > this.gardenStage) {
      this.growHold = (this.growHold || 0) + dt;
      if (this.growHold >= 380 * this.pace()) { this.gardenStage++; this.growHold = 0; this.grewThisBreath = true; }
    } else this.growHold = 0;
    const stage = this.gardenStage;

    if (!this.plotCleared && this.plotRef.current) {
      this.plotCleared = true;
      this.plotRef.current.querySelectorAll('img').forEach(im => { im.style.opacity = '0'; im.src = 'assets/flower-1.png'; });
    }
    if (this.pondOrbRef.current) {
      const sp = SPOTS[Math.min(SPOTS.length - 1, this.plotIdx)];
      this.pondOrbRef.current.style.left = sp[0] + '%';
      this.pondOrbRef.current.style.bottom = sp[1] + '%';
      this.pondOrbRef.current.style.transform = 'translate(-50%,30%) scale(' + (1 + v * 0.5).toFixed(3) + ')';
      this.pondOrbRef.current.style.opacity = this.plotIdx >= SPOTS.length ? '0' : '1';
    }
    if (this.gardenFillRef.current) {
      this.gardenFillRef.current.style.width = (full ? 0 : v * 100).toFixed(1) + '%';
    }
    if (this.stageMarkRef.current) {
      const on = !full && this.gardenStage >= 0;
      this.stageMarkRef.current.style.opacity = on ? '1' : '0';
      this.stageMarkRef.current.style.left = on ? ((this.gardenStage + 1) * 20) + '%' : '0%';
    }
    if (this.plotTextRef.current) {
      this.plotTextRef.current.textContent = Math.min(SPOTS.length, this.plotIdx) + '/' + SPOTS.length;
    }
    if (stage !== this.shownStage) {
      this.shownStage = stage;
      const plot = this.plotRef.current;
      const el = plot ? plot.querySelectorAll('img')[this.plotIdx] : null;
      if (el) {
        el.style.opacity = stage < 0 ? '0' : '1';
        if (stage >= 0) {
          el.src = this.spriteFor(stage, this.plotIdx);
          el.style.transform = 'translateX(-50%) scale(1.12)';
          setTimeout(() => { if (el) el.style.transform = 'translateX(-50%) scale(1)'; }, 300);
        }
      }
    }
    if (ev) {
      if (full) {
        this.say(this.t().lovely);
      } else if (this.grewThisBreath) {
        this.sparks++;
        this.say(this.gardenStage === 4 ? this.t().bloomed : this.t().grew);
        if (this.gardenStage === 4) {
          this.plotIdx++;
          this.gardenStage = -1;
          this.shownStage = -2;
        }
      } else if (this.plotIdx >= SPOTS.length) {
        this.say(this.t().lovely);
      } else {
        this.say(this.t().firmer);
      }
      this.grewThisBreath = false;
      this.growHold = 0;
    }
    if (this.lineTimer > 0) { this.lineTimer -= dt; if (this.lineTimer <= 0) this.line = ''; }
    this.showLine(this.lineWrap4Ref, this.line4Ref);
  }

  /* ---- the connect / calibrate panel ------------------------------ */
  openConnect() { this.calStage = -1; this.setState({ screen: 'connect' }); }

  async pickSource(src) {
    await BreathIn.use(src);
    this.calStage = -1;
    this.forceUpdate();
  }

  // Two steps: measure the room while the child sits still, then take one
  // comfortable blow as the yardstick everything else is scaled against.
  beginCal() {
    if (!BreathIn.active()) return;
    BreathIn.ambient = null;
    this.calStage = 0; this.calT = 2500; this.calPeak = 0;
    this.forceUpdate();
  }

  updateConnect(dt) {
    const v = Math.min(1, BreathIn.active() ? BreathIn.rel() : this.breath.value);
    if (this.cbBarRef.current) this.cbBarRef.current.style.width = (v * 100) + '%';
    if (this.cbValRef.current) this.cbValRef.current.textContent = (BreathIn.active() ? BreathIn.raw : this.breath.value).toFixed(3);
    if (this.cbNoteRef.current) {
      const n = BreathIn.note;
      this.cbNoteRef.current.textContent = n ? (n.n + ' · ' + n.holes + (n.holes === 1 ? ' finger' : ' fingers')) : '—';
    }
    if (this.calStage < 0) return;

    this.calT -= dt;
    if (this.calStage === 0) {
      BreathIn.measureRoom(BreathIn.lastRms || 0);
      if (this.cbCalRef.current) this.cbCalRef.current.style.width = (100 * (1 - this.calT / 2500)) + '%';
      if (this.calT <= 0) { this.calStage = 1; this.calT = 5000; this.calPeak = 0; this.forceUpdate(); }
    } else {
      this.calPeak = Math.max(this.calPeak, BreathIn.raw);
      if (this.cbCalRef.current) this.cbCalRef.current.style.width = (100 * (1 - this.calT / 5000)) + '%';
      if (this.calT <= 0) {
        // Aim a little under what they actually managed, so a comfortable
        // breath reaches the top without anyone having to strain.
        BreathIn.comfort = Math.max(0.12, this.calPeak * 0.85);
        this.calStage = -1;
        this.forceUpdate();
      }
    }
  }

  frame = (now) => {
    try {
      if (!(this.last > 0)) this.last = now;
      let dt = Math.min(48, now - this.last);
      if (!(dt >= 0)) dt = 16;
      this.last = now;
      const ev = this.tickBreath(dt);
      const s = this.state.screen;
      if (s === 'connect') this.updateConnect(dt);
      else if (s === 'stream') this.updateStream(dt, ev);
      else if (s === 'cave') this.updateCave(dt, ev);
      else if (s === 'conversation') this.updateConversation(dt, ev);
      else if (s === 'pond') this.updatePond(dt, ev);
    } catch (err) {
      if (!this.loggedFrameErr) { this.loggedFrameErr = true; console.error('frame error', err); }
    }
    this.raf = requestAnimationFrame(this.frame);
  }

  ensureLoop() {
    if (this.loopOn) return;
    this.loopOn = true;
    if (!this.onKeyDown) {
      this.onKeyDown = (e) => { if (e.code === 'Space') { e.preventDefault(); this.keyDown = true; } };
      this.onKeyUp = (e) => { if (e.code === 'Space') this.keyDown = false; };
      this.onPointerDown = (e) => { if (!e.target.closest('button, a')) this.pointerDown = true; };
      this.onPointerUp = () => { this.pointerDown = false; };
      window.addEventListener('keydown', this.onKeyDown);
      window.addEventListener('keyup', this.onKeyUp);
      window.addEventListener('pointerdown', this.onPointerDown);
      window.addEventListener('pointerup', this.onPointerUp);
    }
    this.last = performance.now();
    this.raf = requestAnimationFrame(this.frame);
  }

  renderVals() {
    this.ensureLoop();
    const t = this.t();
    const s = this.state.screen;
    return {
      t: t,
      langLabel: this.state.lang === 'en' ? 'EN / हि' : 'हि / EN',
      toggleLang: () => this.setState({ lang: this.state.lang === 'en' ? 'hi' : 'en' }),
      isCards: s === 'cards',
      isConnect: s === 'connect',
      openConnect: () => this.openConnect(),
      closeConnect: () => this.setState({ screen: 'cards' }),
      pickKey: () => this.pickSource('key'),
      pickMic: () => this.pickSource('mic'),
      pickSerial: () => this.pickSource('serial'),
      calibrate: () => this.beginCal(),
      reZero: () => BreathIn.reZero(),
      srcIsKey: BreathIn.src === 'key',
      srcIsMic: BreathIn.src === 'mic',
      srcIsSerial: BreathIn.src === 'serial',
      hasSerialSensor: BreathIn.src === 'serial' && BreathIn.connected,
      statusText: BreathIn.src === 'serial' && BreathIn.connected ? t.stSerial
                : BreathIn.src === 'mic' && BreathIn.micOn ? t.stMic
                : BreathIn.src === 'key' ? t.stKey : t.stOff,
      statusOk: BreathIn.active() || BreathIn.src === 'key',
      dotColor: BreathIn.active() ? '#A5EA76' : (BreathIn.src === 'key' ? '#F6C96B' : '#F2A9C4'),
      serialBorder: BreathIn.src === 'serial' && BreathIn.connected ? '#A5EA76' : 'rgba(255,255,255,.2)',
      micBorder: BreathIn.src === 'mic' && BreathIn.micOn ? '#A5EA76' : 'rgba(255,255,255,.2)',
      keyBorder: BreathIn.src === 'key' ? '#F6C96B' : 'rgba(255,255,255,.2)',
      breathNote: BreathIn.why === 'needBrowser' ? t.errBrowser
                : BreathIn.why === 'noPort' ? t.errPort
                : BreathIn.why === 'unplugged' ? t.errUnplug
                : BreathIn.why === 'noMic' ? t.errMic
                : (BreathIn.micOn && !BreathIn.rawOk) ? t.warnFilter
                : BreathIn.roomTooLoud() ? t.warnLoud
                : '',
      calibrating: this.calStage >= 0,
      notCalibrating: this.calStage < 0,
      calText: this.calStage === 0 ? t.calQuiet : t.calBlow,
      canCalibrate: BreathIn.active(),
      cbBarRef: this.cbBarRef, cbValRef: this.cbValRef,
      cbNoteRef: this.cbNoteRef, cbCalRef: this.cbCalRef,
      isStream: s === 'stream',
      isCave: s === 'cave',
      isConversation: s === 'conversation',
      isPond: s === 'pond',
      places: PLACES.map(p => ({
        index: p.index, accent: p.accent, wash: p.wash, chip: p.chip, art: p.art, pos: p.pos,
        name: t.names[p.id], teach: t.teach[p.id], dur: t.durs[p.id],
        play: () => {
          if (p.id === 'stream') this.startStream();
          else if (p.id === 'cave') this.startCave();
          else if (p.id === 'clearing') this.startConversation();
          else this.startPond();
        }
      })),
      pads: [0, 1, 2, 3, 4, 5, 6, 7, 8],
      convPatterns: (this.convSeq.length ? this.convSeq : [{ color: '#D4A5F5' }, { color: '#FFD4A3' }, { color: '#A5D4F5' }, { color: '#D4F5A5' }]).map(p => ({ color: p.color })),
      progressRef: this.progressRef, progressRef2: this.progressRef2, progressRef3: this.progressRef3,
      padLaneRef: this.padLaneRef, flyRef: this.flyRef, gaugeRef: this.gaugeRef,
      gaugeZoneRef: this.gaugeZoneRef,
      jarCountRef: this.jarCountRef, jarFillRef: this.jarFillRef, jarWrapRef: this.jarWrapRef,
      lineRef: this.lineRef, lineWrapRef: this.lineWrapRef,
      caveBgRef: this.caveBgRef, caveObsRef: this.caveObsRef, caveFlyRef: this.caveFlyRef,
      caveObstacles: [0, 1, 2, 3],
      caveBarRef: this.caveBarRef, caveStreakRef: this.caveStreakRef,
      jarCount2Ref: this.jarCount2Ref, jarFill2Ref: this.jarFill2Ref, jarWrap2Ref: this.jarWrap2Ref,
      line2Ref: this.line2Ref, lineWrap2Ref: this.lineWrap2Ref,
      convGlowRef: this.convGlowRef, convBreathRef: this.convBreathRef, convSeqRef: this.convSeqRef, convFlyRef: this.convFlyRef,
      jarCount3Ref: this.jarCount3Ref, jarFill3Ref: this.jarFill3Ref,
      line3Ref: this.line3Ref, lineWrap3Ref: this.lineWrap3Ref,
      pondOrbRef: this.pondOrbRef,
      plotRef: this.plotRef,
      gardenFillRef: this.gardenFillRef, stageMarkRef: this.stageMarkRef, plotTextRef: this.plotTextRef,
      line4Ref: this.line4Ref, lineWrap4Ref: this.lineWrap4Ref,
      leaveGame: () => this.leave()
    };
  }
}
</script>
</body>
</html>
