<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Marcellus&family=Nunito:wght@400;600;700;800;900&family=Tiro+Devanagari+Hindi&display=swap" rel="stylesheet" />
<style>
html, body { margin: 0; height: 100%; background: #140E1E; overflow: hidden; }
a { color: #F6C96B; } a:hover { color: #ffe1a6; }
@keyframes flyBob { 0%,100% { transform: translate(-50%,-50%); } 50% { transform: translate(-50%,calc(-50% - 8px)); } }
@keyframes calmPulse { 0%,100% { transform: translate(-50%,-50%) scale(1); opacity: .5; } 50% { transform: translate(-50%,-50%) scale(1.5); opacity: .9; } }
</style>
</helmet>

<div style="position:relative;width:100%;height:100vh;overflow:hidden;font-family:Nunito,system-ui,sans-serif;color:#F7EEDB;background:#140E1E">

  <sc-if value="{{ isCards }}" hint-placeholder-val="{{ true }}">
    <div style="position:absolute;inset:0;background:linear-gradient(180deg,#4FB8EE 0%,#7FD2F5 46%,#A9E3F9 100%)"></div>
    <div style="position:absolute;inset:-2vh;background-size:190% auto;background-position:center 88%;background-image:url(assets/scene-home-meadow.png);filter:blur(4px) saturate(1.06)"></div>
    <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(24,86,124,.3) 0%,rgba(24,86,124,.14) 44%,rgba(24,86,124,.26) 100%)"></div>

    <div style="position:absolute;left:5.5%;right:5.5%;top:6%;display:flex;align-items:center;justify-content:center">
      <div style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:6vh;line-height:1;color:#fff;text-shadow:0 .4vh 0 rgba(20,73,107,.32)">{{ t.pickPlace }}</div>
      <a href="Breezy Home.dc.html" style="position:absolute;left:0;top:50%;transform:translateY(-50%);display:flex;align-items:center;gap:.9vh;height:5.4vh;padding:0 2.2vh 0 1.6vh;border-radius:1.4vh;border:.4vh solid #fff;background:linear-gradient(180deg,#FFD75E 0%,#F0A62A 100%);box-shadow:inset 0 -.5vh 0 rgba(0,0,0,.16),0 .3vh .6vh rgba(0,0,0,.24);color:#fff;font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:1.6vh;letter-spacing:.1em;text-decoration:none;cursor:pointer;transition:transform .16s cubic-bezier(.22,.7,.3,1),box-shadow .16s ease,filter .16s ease" style-hover="filter:brightness(1.05)" style-active="transform:translateY(-50%) translateY(2px)"><svg width="2.4vh" height="2.4vh" viewBox="0 0 24 24"><path fill="currentColor" d="M11.3 5.3L4.6 12l6.7 6.7 2-2L9.4 13H20v-2H9.4l3.9-3.7z"></path></svg>{{ t.back }}</a>
      <button onClick="{{ toggleLang }}" style="position:absolute;right:0;top:50%;transform:translateY(-50%);height:5.4vh;padding:0 2.2vh;border-radius:1.4vh;border:.4vh solid #fff;background:linear-gradient(180deg,#C9AEF9 0%,#9E77E8 100%);box-shadow:inset 0 -.5vh 0 rgba(0,0,0,.14),0 .3vh .5vh rgba(0,0,0,.16);color:#fff;font-family:Nunito;font-weight:900;font-size:1.5vh;letter-spacing:.12em;cursor:pointer;transition:transform .16s cubic-bezier(.22,.7,.3,1),box-shadow .16s ease,filter .16s ease" style-hover="filter:brightness(1.05)" style-active="transform:translateY(-50%) translateY(2px)">{{ langLabel }}</button>
    </div>

    <div style="position:absolute;left:5.5%;right:5.5%;top:20%;bottom:14%;display:flex;gap:2.6vh;align-items:stretch;justify-content:center">
      <sc-for list="{{ places }}" as="p" hint-placeholder-count="4">
        <button onClick="{{ p.play }}" style="position:relative;flex:1;display:flex;flex-direction:column;justify-content:flex-end;padding:0;overflow:hidden;cursor:pointer;border:none;border-radius:3vh;background:{{ p.wash }};box-shadow:0 1.4vh 2.4vh rgba(20,73,107,.18);text-align:center;transition:transform .22s cubic-bezier(.22,.7,.3,1),box-shadow .22s ease,filter .22s ease" style-hover="transform:translateY(-.6vh);box-shadow:0 2vh 3vh rgba(20,73,107,.22)" style-active="transform:translateY(0)">
          <div style="position:absolute;inset:0;background-size:cover;background-repeat:no-repeat;background-position:{{ p.pos }};background-image:{{ p.art }}"></div>
          <div style="position:absolute;left:0;right:0;bottom:0;height:56%;background:linear-gradient(180deg,rgba(9,32,48,0) 0%,rgba(9,32,48,.55) 52%,rgba(9,32,48,.88) 100%)"></div>
          <div style="position:absolute;left:0;top:2.6vh;display:flex;align-items:center;justify-content:center;min-width:6vh;height:4vh;padding:0 1.4vh;border-radius:0 99px 99px 0;border:.35vh solid #fff;border-left:none;background:{{ p.chip }};box-shadow:inset 0 -.4vh 0 rgba(0,0,0,.16),0 .3vh .6vh rgba(0,0,0,.22);color:#fff;font-family:Nunito;font-weight:900;font-size:2vh;letter-spacing:.04em;text-shadow:0 .2vh 0 rgba(0,0,0,.28)">{{ p.index }}</div>
          <div style="position:relative;display:flex;flex-direction:column;align-items:center;gap:.9vh;padding:0 2vh 3vh">
            <div style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:2.9vh;line-height:1.1;letter-spacing:.01em;color:#fff;text-shadow:0 .25vh .5vh rgba(0,0,0,.4)">{{ p.name }}</div>
            <div style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:600;font-size:1.75vh;line-height:1.4;color:rgba(255,255,255,.9);text-wrap:pretty">{{ p.teach }}</div>
            <div style="font-family:Nunito;font-weight:800;font-size:1.15vh;letter-spacing:.22em;color:rgba(255,255,255,.62)">{{ p.dur }}</div>
          </div>
        </button>
      </sc-for>
    </div>

    <div style="position:absolute;left:5.5%;bottom:6%;display:flex;align-items:center;gap:1.6vh">
      <button onClick="{{ openConnect }}" style="display:flex;align-items:center;gap:.9vh;height:4.6vh;padding:0 1.8vh;border-radius:1.2vh;border:.3vh solid rgba(255,255,255,.9);background:rgba(9,42,64,.42);color:#fff;font-family:Nunito;font-weight:900;font-size:1.25vh;letter-spacing:.14em;cursor:pointer;transition:transform .16s cubic-bezier(.22,.7,.3,1),filter .16s ease" style-hover="filter:brightness(1.15)" style-active="transform:translateY(2px)">
        <svg width="2vh" height="2vh" viewBox="0 0 24 24"><path fill="currentColor" d="M12 3a3 3 0 013 3v5a3 3 0 01-6 0V6a3 3 0 013-3z"></path><path stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" d="M5.5 11a6.5 6.5 0 0013 0M12 17.5V21"></path></svg>
        {{ t.breathe }}
        <span style="width:1.1vh;height:1.1vh;border-radius:50%;background:{{ dotColor }};box-shadow:0 0 .8vh {{ dotColor }}"></span>
      </button>
      <div style="font-size:1.25vh;letter-spacing:.06em;color:rgba(15,66,98,.72)">{{ t.hint }}</div>
    </div>
  </sc-if>

  <sc-if value="{{ isConnect }}" hint-placeholder-val="{{ false }}">
    <div style="position:absolute;inset:0;background:linear-gradient(180deg,#1B2438 0%,#141E2E 100%)"></div>
    <div style="position:absolute;inset:-2vh;background-size:cover;background-position:center;background-image:url(assets/scene-home-meadow.png);filter:blur(18px) saturate(.7);opacity:.22"></div>

    <div style="position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:84vh;max-width:88%;display:flex;flex-direction:column;gap:2.4vh">

      <div style="display:flex;align-items:center;justify-content:center;position:relative">
        <div style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:4.2vh;line-height:1.1;color:#fff;padding:0 16vh;text-align:center;text-wrap:balance">{{ t.conn }}</div>
        <button onClick="{{ closeConnect }}" style="position:absolute;left:0;top:50%;transform:translateY(-50%);display:flex;align-items:center;gap:.9vh;height:4.8vh;padding:0 2vh 0 1.4vh;border-radius:1.2vh;border:.35vh solid #fff;background:linear-gradient(180deg,#FFD75E 0%,#F0A62A 100%);color:#fff;font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:1.5vh;letter-spacing:.1em;cursor:pointer;transition:transform .16s cubic-bezier(.22,.7,.3,1),filter .16s ease" style-hover="filter:brightness(1.06)" style-active="transform:translateY(-50%) translateY(2px)"><svg width="2.2vh" height="2.2vh" viewBox="0 0 24 24"><path fill="currentColor" d="M11.3 5.3L4.6 12l6.7 6.7 2-2L9.4 13H20v-2H9.4l3.9-3.7z"></path></svg>{{ t.back }}</button>
      </div>

      <div style="display:flex;gap:1.8vh">
        <button onClick="{{ pickSerial }}" style="flex:1;display:flex;flex-direction:column;align-items:center;gap:.8vh;padding:2.4vh 1.6vh;border-radius:2vh;border:.35vh solid {{ serialBorder }};background:rgba(255,255,255,.07);color:#F7EEDB;cursor:pointer;text-align:center;transition:transform .18s cubic-bezier(.22,.7,.3,1),filter .18s ease" style-hover="transform:translateY(-.5vh);filter:brightness(1.2)" style-active="transform:translateY(0)">
          <div style="font-size:3.4vh;line-height:1">🎵</div>
          <div style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:2.1vh;color:#fff">{{ t.srcSerial }}</div>
          <div style="font-family:Nunito;font-weight:600;font-size:1.45vh;line-height:1.45;color:rgba(247,238,219,.72);text-wrap:pretty">{{ t.srcSerialBlurb }}</div>
        </button>
        <button onClick="{{ pickMic }}" style="flex:1;display:flex;flex-direction:column;align-items:center;gap:.8vh;padding:2.4vh 1.6vh;border-radius:2vh;border:.35vh solid {{ micBorder }};background:rgba(255,255,255,.07);color:#F7EEDB;cursor:pointer;text-align:center;transition:transform .18s cubic-bezier(.22,.7,.3,1),filter .18s ease" style-hover="transform:translateY(-.5vh);filter:brightness(1.2)" style-active="transform:translateY(0)">
          <div style="font-size:3.4vh;line-height:1">🎤</div>
          <div style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:2.1vh;color:#fff">{{ t.srcMic }}</div>
          <div style="font-family:Nunito;font-weight:600;font-size:1.45vh;line-height:1.45;color:rgba(247,238,219,.72);text-wrap:pretty">{{ t.srcMicBlurb }}</div>
        </button>
        <button onClick="{{ pickKey }}" style="flex:1;display:flex;flex-direction:column;align-items:center;gap:.8vh;padding:2.4vh 1.6vh;border-radius:2vh;border:.35vh solid {{ keyBorder }};background:rgba(255,255,255,.07);color:#F7EEDB;cursor:pointer;text-align:center;transition:transform .18s cubic-bezier(.22,.7,.3,1),filter .18s ease" style-hover="transform:translateY(-.5vh);filter:brightness(1.2)" style-active="transform:translateY(0)">
          <div style="font-size:3.4vh;line-height:1">⌨️</div>
          <div style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:2.1vh;color:#fff">{{ t.srcKey }}</div>
          <div style="font-family:Nunito;font-weight:600;font-size:1.45vh;line-height:1.45;color:rgba(247,238,219,.72);text-wrap:pretty">{{ t.srcKeyBlurb }}</div>
        </button>
      </div>

      <div style="display:flex;flex-direction:column;gap:1.4vh;padding:2.2vh 2.4vh;border-radius:2vh;background:rgba(0,0,0,.28)">
        <div style="display:flex;align-items:center;gap:1.2vh">
          <span style="width:1.2vh;height:1.2vh;border-radius:50%;background:{{ dotColor }};box-shadow:0 0 1vh {{ dotColor }}"></span>
          <div style="font-family:Nunito;font-weight:900;font-size:1.5vh;letter-spacing:.1em;color:{{ dotColor }}">{{ statusText }}</div>
          <div style="flex:1"></div>
          <div style="font-family:Nunito;font-weight:800;font-size:1.15vh;letter-spacing:.18em;color:rgba(247,238,219,.45)">{{ t.noteHeard }}</div>
          <div ref="{{ cbNoteRef }}" style="font-family:Nunito;font-weight:900;font-size:1.6vh;color:#F6C96B;min-width:9vh;text-align:right">—</div>
        </div>

        <div style="display:flex;align-items:center;gap:1.4vh">
          <div style="font-family:Nunito;font-weight:800;font-size:1.15vh;letter-spacing:.18em;color:rgba(247,238,219,.45)">{{ t.reading }}</div>
          <div ref="{{ cbValRef }}" style="font-family:Nunito;font-weight:900;font-size:1.7vh;color:#fff;min-width:6vh">0.000</div>
          <div style="position:relative;flex:1;height:2vh;border-radius:99px;border:.3vh solid rgba(255,255,255,.32);background:rgba(0,0,0,.35);overflow:hidden">
            <div ref="{{ cbBarRef }}" style="position:absolute;left:0;top:0;bottom:0;width:0%;background:linear-gradient(90deg,#7FDDF7,#A5EA76);border-radius:99px"></div>
          </div>
        </div>

        <sc-if value="{{ notCalibrating }}" hint-placeholder-val="{{ true }}">
          <div style="display:flex;align-items:center;gap:1.2vh">
            <div style="flex:1;font-family:Nunito;font-weight:600;font-size:1.4vh;color:rgba(247,238,219,.7)">{{ t.tryBlow }}</div>
            <sc-if value="{{ canCalibrate }}" hint-placeholder-val="{{ true }}">
              <button onClick="{{ calibrate }}" style="height:4.2vh;padding:0 2vh;border-radius:1.1vh;border:.3vh solid rgba(255,255,255,.55);background:rgba(255,255,255,.1);color:#fff;font-family:Nunito;font-weight:900;font-size:1.25vh;letter-spacing:.14em;cursor:pointer;transition:filter .16s ease,transform .16s ease" style-hover="filter:brightness(1.3)" style-active="transform:translateY(2px)">{{ t.calibrate }}</button>
            </sc-if>
            <sc-if value="{{ hasSerialSensor }}" hint-placeholder-val="{{ false }}">
              <button onClick="{{ reZero }}" style="height:4.2vh;padding:0 2vh;border-radius:1.1vh;border:.3vh solid rgba(255,255,255,.55);background:rgba(255,255,255,.1);color:#fff;font-family:Nunito;font-weight:900;font-size:1.25vh;letter-spacing:.14em;cursor:pointer;transition:filter .16s ease,transform .16s ease" style-hover="filter:brightness(1.3)" style-active="transform:translateY(2px)">{{ t.reZero }}</button>
            </sc-if>
          </div>
        </sc-if>

        <sc-if value="{{ calibrating }}" hint-placeholder-val="{{ false }}">
          <div style="display:flex;flex-direction:column;gap:1vh">
            <div style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:1.9vh;color:#fff">{{ calText }}</div>
            <div style="position:relative;width:100%;height:1.4vh;border-radius:99px;background:rgba(0,0,0,.4);overflow:hidden">
              <div ref="{{ cbCalRef }}" style="position:absolute;left:0;top:0;bottom:0;width:0%;background:linear-gradient(90deg,#D4A5F5,#F6C96B);border-radius:99px"></div>
            </div>
          </div>
        </sc-if>

        <sc-if value="{{ breathNote }}" hint-placeholder-val="{{ false }}">
          <div style="font-family:Nunito;font-weight:700;font-size:1.35vh;line-height:1.5;color:#F2A9C4;text-wrap:pretty">{{ breathNote }}</div>
        </sc-if>
      </div>
    </div>
  </sc-if>

  <sc-if value="{{ isStream }}" hint-placeholder-val="{{ false }}">
    <div style="position:absolute;inset:0;background-size:cover;background-position:center;background-image:url(assets/scene-lillypad.png)"></div>
    <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(14,9,22,.3) 0%,rgba(14,9,22,0) 22%,rgba(14,9,22,0) 74%,rgba(14,9,22,.42) 100%)"></div>

    <div style="position:absolute;left:50%;top:3vh;transform:translateX(-50%);z-index:7;display:flex;align-items:center;gap:1vh">
      <div style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:1.3vh;letter-spacing:.12em;color:#fff;text-shadow:0 .25vh .3vh rgba(0,0,0,.45)">{{ t.timeBar }}</div>
      <div style="position:relative;width:26vh;height:1.8vh;border-radius:99px;border:.3vh solid rgba(255,255,255,.9);background:rgba(18,12,28,.5);overflow:hidden">
        <div ref="{{ progressRef }}" style="position:absolute;left:0;top:0;bottom:0;width:0%;background:linear-gradient(180deg,#FFD75E,#F0A62A);border-radius:99px"></div>
      </div>
    </div>
    <button onClick="{{ leaveGame }}" style="position:absolute;left:2.6vh;top:2.6vh;z-index:8;display:flex;align-items:center;gap:.9vh;height:5.4vh;padding:0 2vh 0 1.4vh;border-radius:1.4vh;border:.4vh solid #fff;background:linear-gradient(180deg,#FFD75E 0%,#F0A62A 100%);box-shadow:inset 0 -.5vh 0 rgba(0,0,0,.16),0 .3vh .6vh rgba(0,0,0,.24);color:#fff;font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:1.6vh;letter-spacing:.1em;cursor:pointer;transition:transform .16s cubic-bezier(.22,.7,.3,1),box-shadow .16s ease,filter .16s ease" style-hover="filter:brightness(1.05)" style-active="transform:translateY(2px)"><svg width="2.4vh" height="2.4vh" viewBox="0 0 24 24"><path fill="currentColor" d="M11.3 5.3L4.6 12l6.7 6.7 2-2L9.4 13H20v-2H9.4l3.9-3.7z"></path></svg>{{ t.back }}</button>

    <div ref="{{ padLaneRef }}" style="position:absolute;left:0;right:0;top:72%;height:0">
      <sc-for list="{{ pads }}" as="pad" hint-placeholder-count="7">
        <div style="position:absolute;left:0;top:0;transform:translate(-50%,-50%)">
          <div style="width:11vh;height:3.4vh;border-radius:50%;background:radial-gradient(ellipse at 40% 34%,#4E8F52,#2C5F38 70%,#1E4429);box-shadow:0 1.2vh 2.4vh rgba(6,14,10,.5)"></div>
          <div style="position:absolute;left:50%;top:52%;transform:translate(-50%,-50%);width:8vh;height:2vh;border-radius:50%;border:1px solid rgba(255,255,255,.14)"></div>
        </div>
      </sc-for>
    </div>

    <img ref="{{ flyRef }}" src="assets/char-golden.png" alt="Chamki the firefly" style="position:absolute;left:26%;top:52%;width:18vh;height:18vh;object-fit:contain;transform:translate(-50%,-50%);animation:flyBob 3s ease-in-out infinite;filter:drop-shadow(0 0 2.4vh rgba(255,214,130,.45))" />

    <div style="position:absolute;left:50%;top:7.2vh;transform:translateX(-50%);z-index:7;display:flex;align-items:center;gap:1vh">
      <div style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:1.3vh;letter-spacing:.12em;color:#fff;text-shadow:0 .25vh .3vh rgba(0,0,0,.45)">{{ t.breathBar }}</div>
      <div style="position:relative;width:26vh;height:1.8vh;border-radius:99px;border:.3vh solid rgba(255,255,255,.9);background:rgba(18,12,28,.5);overflow:hidden">
        <div ref="{{ gaugeZoneRef }}" style="position:absolute;top:0;bottom:0;left:25%;width:30%;background:rgba(255,255,255,.3);border-left:.25vh solid rgba(255,255,255,.85);border-right:.25vh solid rgba(255,255,255,.85);transition:left .3s ease,width .3s ease,opacity .2s ease"></div>
        <div ref="{{ gaugeRef }}" style="position:absolute;left:0;top:0;bottom:0;width:0%;background:linear-gradient(180deg,#7FDDF7,#12A5E0);border-radius:99px;transition:opacity .2s ease"></div>
      </div>
    </div>

    <div ref="{{ jarWrapRef }}" style="position:absolute;right:3.2%;bottom:7%;display:flex;align-items:flex-end;gap:1.4vh">
      <div style="display:flex;flex-direction:column;align-items:flex-end;gap:.5vh">
        <div style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:1.35vh;letter-spacing:.12em;color:#fff;text-shadow:0 .25vh 0 rgba(0,0,0,.32)">{{ t.sparks }}</div>
        <div ref="{{ jarCountRef }}" style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:3.6vh;line-height:1;color:#fff;text-shadow:0 .3vh 0 rgba(0,0,0,.32)">0</div>
      </div>
      <div style="position:relative;width:6.4vh;height:10vh;filter:drop-shadow(0 .4vh .8vh rgba(0,0,0,.24))">
        <div style="position:absolute;left:1.6vh;right:1.6vh;top:0;height:1.4vh;border-radius:99px;border:.35vh solid #fff;background:linear-gradient(180deg,#FFD75E,#F0A62A)"></div>
        <div style="position:absolute;left:0;right:0;top:1.3vh;bottom:0;border:.4vh solid #fff;border-radius:1vh 1vh 2.4vh 2.4vh;overflow:hidden;background:#2E1B60">
          <div ref="{{ jarFillRef }}" style="position:absolute;left:0;right:0;bottom:0;height:0%;background:linear-gradient(180deg,#FFD75E,#F0A62A);transition:height .4s cubic-bezier(.2,1,.3,1)"></div>
        </div>
      </div>
    </div>

    <div ref="{{ lineWrapRef }}" style="position:absolute;left:50%;bottom:calc(9% - 20px);transform:translateX(-50%);max-width:64%;padding:1.2vh 2.4vh;background:#fff;border-radius:1.8vh;box-shadow:0 .5vh 1vh rgba(9,32,48,.28);opacity:0;transition:opacity .28s ease">
      <div ref="{{ lineRef }}" style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:700;font-size:1.9vh;color:#3A2E66"></div>
    </div>
  </sc-if>

  <sc-if value="{{ isCave }}" hint-placeholder-val="{{ false }}">
    <div ref="{{ caveBgRef }}" style="position:absolute;inset:0;background-image:url(assets/scene-tunnel.png);background-size:auto 100%;background-repeat:repeat-x;background-position:0 center"></div>

        <button onClick="{{ leaveGame }}" style="position:absolute;left:2.6vh;top:2.6vh;z-index:9;display:flex;align-items:center;gap:.9vh;height:5.4vh;padding:0 2vh 0 1.4vh;border-radius:1.4vh;border:.4vh solid #fff;background:linear-gradient(180deg,#FFD75E 0%,#F0A62A 100%);box-shadow:inset 0 -.5vh 0 rgba(0,0,0,.16),0 .3vh .6vh rgba(0,0,0,.24);color:#fff;font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:1.6vh;letter-spacing:.1em;cursor:pointer;transition:transform .16s cubic-bezier(.22,.7,.3,1),box-shadow .16s ease,filter .16s ease" style-hover="filter:brightness(1.05)" style-active="transform:translateY(2px)"><svg width="2.4vh" height="2.4vh" viewBox="0 0 24 24"><path fill="currentColor" d="M11.3 5.3L4.6 12l6.7 6.7 2-2L9.4 13H20v-2H9.4l3.9-3.7z"></path></svg>{{ t.back }}</button>

    <div ref="{{ caveObsRef }}" style="position:absolute;left:0;right:0;top:42%;bottom:0;overflow:hidden">
      <sc-for list="{{ caveObstacles }}" as="o" hint-placeholder-count="4">
        <div style="position:absolute;top:0;bottom:0;left:0;width:8%;transform:translateX(-50%)">
          <div style="position:absolute;left:0;right:0;top:0;height:20%;clip-path:polygon(0 0,100% 0,74% 88%,50% 100%,26% 88%);background:linear-gradient(180deg,#6E5FA8 0%,#8B7BC4 62%,#CFF6EE 92%,#EFFFFA 100%);filter:drop-shadow(0 .3vh 2vh rgba(120,230,215,.6))"></div>
          <div style="position:absolute;left:0;right:0;top:0;height:20%;clip-path:polygon(0 0,100% 0,74% 88%,50% 100%,26% 88%);background:linear-gradient(180deg,rgba(255,255,255,0) 55%,rgba(230,255,250,.95) 100%);mix-blend-mode:screen"></div>
          <div style="position:absolute;left:0;right:0;bottom:0;height:20%;clip-path:polygon(50% 0,74% 12%,100% 100%,0 100%,26% 12%);background:linear-gradient(0deg,#6E5FA8 0%,#8B7BC4 62%,#CFF6EE 92%,#EFFFFA 100%);filter:drop-shadow(0 -.3vh 2vh rgba(120,230,215,.6))"></div>
          <div style="position:absolute;left:0;right:0;bottom:0;height:20%;clip-path:polygon(50% 0,74% 12%,100% 100%,0 100%,26% 12%);background:linear-gradient(0deg,rgba(255,255,255,0) 55%,rgba(230,255,250,.95) 100%);mix-blend-mode:screen"></div>
        </div>
      </sc-for>
    </div>

    <img ref="{{ caveFlyRef }}" src="assets/char-golden.png" alt="Chamki the firefly" style="position:absolute;left:26%;top:56%;width:18vh;height:18vh;object-fit:contain;transform:translate(-50%,-50%);filter:drop-shadow(0 0 3vh rgba(255,214,130,.55))" />

    <div style="position:absolute;left:50%;top:3vh;transform:translateX(-50%);z-index:7;display:flex;align-items:center;gap:1vh">
      <div style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:1.3vh;letter-spacing:.12em;color:#fff;text-shadow:0 .25vh .3vh rgba(0,0,0,.45)">{{ t.timeBar }}</div>
      <div style="position:relative;width:26vh;height:1.8vh;border-radius:99px;border:.3vh solid rgba(255,255,255,.9);background:rgba(18,12,28,.5);overflow:hidden">
        <div ref="{{ caveBarRef }}" style="position:absolute;left:0;top:0;bottom:0;width:0%;background:linear-gradient(180deg,#FFD75E,#F0A62A);border-radius:99px"></div>
        <div ref="{{ caveStreakRef }}" style="position:absolute;top:0;bottom:0;left:0;width:0%;background:rgba(255,255,255,.55)"></div>
      </div>
    </div>

    <div ref="{{ jarWrap2Ref }}" style="position:absolute;right:3.2%;bottom:7%;display:flex;align-items:flex-end;gap:1.4vh">
      <div style="display:flex;flex-direction:column;align-items:flex-end;gap:.5vh">
        <div style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:1.35vh;letter-spacing:.12em;color:#fff;text-shadow:0 .25vh 0 rgba(0,0,0,.32)">{{ t.sparks }}</div>
        <div ref="{{ jarCount2Ref }}" style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:3.6vh;line-height:1;color:#fff;text-shadow:0 .3vh 0 rgba(0,0,0,.32)">0</div>
      </div>
      <div style="position:relative;width:6.4vh;height:10vh;filter:drop-shadow(0 .4vh .8vh rgba(0,0,0,.24))">
        <div style="position:absolute;left:1.6vh;right:1.6vh;top:0;height:1.4vh;border-radius:99px;border:.35vh solid #fff;background:linear-gradient(180deg,#FFD75E,#F0A62A)"></div>
        <div style="position:absolute;left:0;right:0;top:1.3vh;bottom:0;border:.4vh solid #fff;border-radius:1vh 1vh 2.4vh 2.4vh;overflow:hidden;background:#2E1B60">
          <div ref="{{ jarFill2Ref }}" style="position:absolute;left:0;right:0;bottom:0;height:0%;background:linear-gradient(180deg,#FFD75E,#F0A62A);transition:height .4s cubic-bezier(.2,1,.3,1)"></div>
        </div>
      </div>
    </div>

    <div ref="{{ lineWrap2Ref }}" style="position:absolute;left:50%;bottom:calc(11% - 20px);transform:translateX(-50%);max-width:64%;padding:1.2vh 2.4vh;background:#fff;border-radius:1.8vh;box-shadow:0 .5vh 1vh rgba(9,32,48,.28);opacity:0;transition:opacity .28s ease">
      <div ref="{{ line2Ref }}" style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:700;font-size:1.9vh;color:#3A2E66"></div>
    </div>
  </sc-if>

  <sc-if value="{{ isConversation }}" hint-placeholder-val="{{ false }}">
