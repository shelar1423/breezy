    <button onClick="{{ leaveGame }}" style="position:absolute;left:2.6vh;top:2.6vh;z-index:10;display:flex;align-items:center;gap:.9vh;height:5.4vh;padding:0 2vh 0 1.4vh;border-radius:1.4vh;border:.4vh solid #fff;background:linear-gradient(180deg,#FFD75E 0%,#F0A62A 100%);box-shadow:inset 0 -.5vh 0 rgba(0,0,0,.16),0 .3vh .6vh rgba(0,0,0,.24);color:#fff;font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:1.6vh;letter-spacing:.1em;cursor:pointer;transition:transform .16s cubic-bezier(.22,.7,.3,1),box-shadow .16s ease,filter .16s ease" style-hover="filter:brightness(1.05)" style-active="transform:translateY(2px)"><svg width="2.4vh" height="2.4vh" viewBox="0 0 24 24"><path fill="currentColor" d="M11.3 5.3L4.6 12l6.7 6.7 2-2L9.4 13H20v-2H9.4l3.9-3.7z"></path></svg>{{ t.back }}</button>

    <div style="position:absolute;left:50%;top:24%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:2.2vh;z-index:2">
      <div ref="{{ convGlowRef }}" style="width:12vh;height:12vh;border-radius:50%;background:#D4A5F5;opacity:0;box-shadow:0 0 4vh 1vh rgba(212,165,245,.55);transition:opacity .12s"></div>
      <div ref="{{ convSeqRef }}" style="display:flex;gap:1.4vh;justify-content:center">
        <sc-for list="{{ convPatterns }}" as="p" hint-placeholder-count="4">
          <div style="width:2.2vh;height:2.2vh;border-radius:50%;border:.3vh solid #fff;background:{{ p.color }};box-shadow:0 .2vh .4vh rgba(0,0,0,.24);opacity:.4;transition:opacity .3s"></div>
        </sc-for>
      </div>
    </div>

    <img ref="{{ convFlyRef }}" src="assets/char-golden.png" alt="Chamki the firefly" style="position:absolute;left:50%;top:66%;margin-top:-40px;z-index:3;width:18vh;height:18vh;object-fit:contain;transform:translate(-50%,-50%);animation:flyBob 3s ease-in-out infinite;filter:drop-shadow(0 0 2.4vh rgba(255,214,130,.45))" />

    <div style="position:absolute;left:50%;bottom:6%;transform:translateX(-50%);z-index:3">
      <div style="position:relative;width:8.6vh;height:8.6vh;border-radius:50%;border:.3vh solid rgba(255,255,255,.62);background:rgba(18,12,28,.42);display:flex;align-items:center;justify-content:center">
        <div ref="{{ convBreathRef }}" style="width:6.4vh;height:6.4vh;border-radius:50%;background:#D4A5F5;opacity:0;box-shadow:0 0 2.4vh rgba(212,165,245,.55);transition:opacity .12s"></div>
