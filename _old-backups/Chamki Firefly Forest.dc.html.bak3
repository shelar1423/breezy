  <sc-if value="{{ isCave }}" hint-placeholder-val="{{ false }}">
    <div ref="{{ caveBgRef }}" style="position:absolute;inset:0;background-image:url(assets/scene-tunnel.png);background-size:auto 100%;background-repeat:repeat-x;background-position:0 center"></div>

        <button onClick="{{ leaveGame }}" style="position:absolute;left:2.6vh;top:2.6vh;z-index:9;display:flex;align-items:center;gap:.9vh;height:5.4vh;padding:0 2vh 0 1.4vh;border-radius:1.4vh;border:.4vh solid #fff;background:linear-gradient(180deg,#FFD75E 0%,#F0A62A 100%);box-shadow:inset 0 -.5vh 0 rgba(0,0,0,.16),0 .3vh .6vh rgba(0,0,0,.24);color:#fff;font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:1.6vh;letter-spacing:.1em;cursor:pointer;transition:transform .16s cubic-bezier(.22,.7,.3,1),box-shadow .16s ease,filter .16s ease" style-hover="filter:brightness(1.05)" style-active="transform:translateY(2px)"><svg width="2.4vh" height="2.4vh" viewBox="0 0 24 24"><path fill="currentColor" d="M11.3 5.3L4.6 12l6.7 6.7 2-2L9.4 13H20v-2H9.4l3.9-3.7z"></path></svg>{{ t.back }}</button>

    <div ref="{{ caveObsRef }}" style="position:absolute;left:0;right:0;top:42%;bottom:0;overflow:hidden">
