<script type="text/x-dc" data-dc-script data-props="{&quot;breathEffort&quot;:{&quot;editor&quot;:&quot;enum&quot;,&quot;options&quot;:[&quot;Gentle&quot;,&quot;Standard&quot;,&quot;Strong&quot;],&quot;default&quot;:&quot;Standard&quot;,&quot;tsType&quot;:&quot;string&quot;,&quot;section&quot;:&quot;Play feel&quot;},&quot;pacing&quot;:{&quot;editor&quot;:&quot;enum&quot;,&quot;options&quot;:[&quot;Unhurried&quot;,&quot;Steady&quot;,&quot;Brisk&quot;],&quot;default&quot;:&quot;Steady&quot;,&quot;tsType&quot;:&quot;string&quot;,&quot;section&quot;:&quot;Play feel&quot;},&quot;coaching&quot;:{&quot;editor&quot;:&quot;enum&quot;,&quot;options&quot;:[&quot;Quiet&quot;,&quot;Warm&quot;,&quot;Chatty&quot;],&quot;default&quot;:&quot;Warm&quot;,&quot;tsType&quot;:&quot;string&quot;,&quot;section&quot;:&quot;Play feel&quot;}}">
const PLACES = [
