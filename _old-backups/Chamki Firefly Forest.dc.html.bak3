      <div ref="{{ plotTextRef }}" style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:2.1vh;line-height:1;color:#fff;text-shadow:0 .25vh 0 rgba(0,0,0,.3);min-width:5vh;text-align:right">0/5</div>
