    </div>

    <div ref="{{ lineWrapRef }}" style="position:absolute;left:50%;bottom:calc(9% - 20px);transform:translateX(-50%);max-width:64%;padding:1.2vh 2.4vh;background:#fff;border-radius:1.8vh;box-shadow:0 .5vh 1vh rgba(9,32,48,.28);opacity:0;transition:opacity .28s ease">
      <div ref="{{ lineRef }}" style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:700;font-size:1.9vh;color:#3A2E66"></div>
    </div>
