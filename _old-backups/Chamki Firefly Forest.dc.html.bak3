    </div>

    <img ref="{{ caveFlyRef }}" src="assets/char-golden.png" alt="Chamki the firefly" style="position:absolute;left:26%;top:56%;width:18vh;height:18vh;object-fit:contain;transform:translate(-50%,-50%);filter:drop-shadow(0 0 3vh rgba(255,214,130,.55))" />

    <div style="position:absolute;left:50%;top:3vh;transform:translateX(-50%);z-index:7;display:flex;align-items:center;gap:1vh">
      <div style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:1.3vh;letter-spacing:.12em;color:#fff;text-shadow:0 .25vh .3vh rgba(0,0,0,.45)">{{ t.timeBar }}</div>
      <div style="position:relative;width:26vh;height:1.8vh;border-radius:99px;border:.3vh solid rgba(255,255,255,.9);background:rgba(18,12,28,.5);overflow:hidden">
        <div ref="{{ caveBarRef }}" style="position:absolute;left:0;top:0;bottom:0;width:0%;background:linear-gradient(180deg,#FFD75E,#F0A62A);border-radius:99px"></div>
        <div ref="{{ caveStreakRef }}" style="position:absolute;top:0;bottom:0;left:0;width:0%;background:rgba(255,255,255,.55)"></div>
      </div>
    </div>

    <div ref="{{ jarWrap2Ref }}" style="position:absolute;right:3.2%;bottom:7%;display:flex;align-items:flex-end;gap:1.4vh">
      <div style="display:flex;flex-direction:column;align-items:flex-end;gap:.5vh">
        <div style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:1.35vh;letter-spacing:.12em;color:#fff;text-shadow:0 .25vh 0 rgba(0,0,0,.32)">{{ t.sparks }}</div>
        <div ref="{{ jarCount2Ref }}" style="font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;font-size:3.6vh;line-height:1;color:#fff;text-shadow:0 .3vh 0 rgba(0,0,0,.32)">0</div>
