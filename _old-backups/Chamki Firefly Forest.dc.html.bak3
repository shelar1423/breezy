      <div style="position:relative;width:26vh;height:2.8vh;border:.35vh solid #fff;border-radius:99px;overflow:hidden;background:#2E1B60">
        <div ref="{{ gardenFillRef }}" style="position:absolute;left:0;top:0;bottom:0;width:0%;background:linear-gradient(180deg,#FFD75E,#F0A62A);border-radius:99px"></div>
        <div ref="{{ stageMarkRef }}" style="position:absolute;left:0;top:0;bottom:0;width:2px;background:#F7EEDB;opacity:0;box-shadow:0 0 1vh rgba(247,238,219,.8);transition:left .3s ease,opacity .3s ease"></div>
        <div style="position:absolute;left:20%;top:0;bottom:0;width:1px;background:rgba(255,255,255,.35)"></div>
        <div style="position:absolute;left:40%;top:0;bottom:0;width:1px;background:rgba(255,255,255,.35)"></div>
        <div style="position:absolute;left:60%;top:0;bottom:0;width:1px;background:rgba(255,255,255,.35)"></div>
        <div style="position:absolute;left:80%;top:0;bottom:0;width:1px;background:rgba(255,255,255,.35)"></div>
