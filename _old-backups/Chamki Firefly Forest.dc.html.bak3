    <div ref="{{ lineWrap3Ref }}" style="position:absolute;left:50%;bottom:calc(26% - 20px);z-index:3;transform:translateX(-50%);max-width:64%;padding:1.2vh 2.4vh;background:#fff;border-radius:1.8vh;box-shadow:0 .5vh 1vh rgba(9,32,48,.28);opacity:0;transition:opacity .28s ease">
