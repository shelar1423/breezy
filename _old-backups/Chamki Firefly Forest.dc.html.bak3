  <sc-if value="{{ isConversation }}" hint-placeholder-val="{{ false }}">
    <div style="position:absolute;inset:0;background:#2A0F1E"></div>
    <div style="position:absolute;inset:0;background-size:cover;background-position:center;background-image:url(assets/scene-stage.png)"></div>
    <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(14,9,22,.28) 0%,rgba(14,9,22,0) 30%,rgba(14,9,22,.42) 100%);pointer-events:none"></div>

    <div style="position:absolute;left:50%;top:3vh;transform:translateX(-50%);z-index:7;display:flex;align-items:center;gap:1vh">
